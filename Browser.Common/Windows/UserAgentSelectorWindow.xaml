<Window x:Class="Browser.Common.Windows.UserAgentSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Browser.Common.Windows"
        mc:Ignorable="d"
        Title="Select user agent or use Custom" SizeToContent="Width" Height="700"  SnapsToDevicePixels="True" 
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Enter custom agent here: " Margin="3" VerticalAlignment="Center" />
            <Button Content="Use Custom" DockPanel.Dock="Right" Margin="3" Command="{Binding OnCommandFromView}" CommandParameter="Custom" />
            <TextBox Text="{Binding CustomeAgentText}" VerticalAlignment="Center" MinWidth="300" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding UserAgentList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <RadioButton IsChecked="{Binding IsSelected}" GroupName="rbRunOptions" VerticalAlignment="Center" />
                            <StackPanel Margin="5" Grid.Column="1">
                                <TextBlock Text="{Binding Version}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Agent}" Margin="10,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Content="Set Selected Agent In List" Grid.Row="2" Margin="3" Command="{Binding OnCommandFromView}"  CommandParameter="FromList"  />
    </Grid>
</Window>
