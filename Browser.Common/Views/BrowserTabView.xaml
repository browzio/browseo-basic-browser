<UserControl x:Class="Browser.Common.Views.BrowserTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Browser.Common.Views"
             xmlns:mControls="clr-namespace:Browser.Common.Cotrols"
             xmlns:mConv="clr-namespace:Browser.Common.Convertrs"
             xmlns:dragNdrop="clr-namespace:DragDropListview.Controls;assembly=DragDropListview"
             xmlns:commonConvs="clr-namespace:Organiser.Common.Converters;assembly=Organiser.Common"
             xmlns:commonClass="clr-namespace:Organiser.Common.Classes;assembly=Organiser.Common"
             xmlns:commonControls="clr-namespace:Organiser.Common.Controlls;assembly=Organiser.Common"
             xmlns:interop="clr-namespace:Microsoft.DwayneNeed.Interop;assembly=Microsoft.DwayneNeed"
             mc:Ignorable="d"
             d:DesignWidth="640"
             d:DesignHeight="480">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush Color="#5c5c5c" x:Key="text_fg"/>
            <SolidColorBrush Color="#f5f5f5" x:Key="bg_gray"/>
            <SolidColorBrush Color="#eeeeee" x:Key="gray_bg"/>
            <Style x:Key="TreeViewItemFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <PathGeometry x:Key="TreeArrow" Figures="M0,0 L0,6 L6,0 z"/>
            <Style x:Key="ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border Background="Transparent" Height="16" Padding="5,5,5,5" Width="16">
                                <Path x:Name="ExpandPath" Data="{StaticResource TreeArrow}" Fill="Transparent" Stroke="#FF989898">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="135" CenterY="3" CenterX="3"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Stroke" TargetName="ExpandPath" Value="#FF1BBBFA"/>
                                    <Setter Property="Fill" TargetName="ExpandPath" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="RenderTransform" TargetName="ExpandPath">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterY="3" CenterX="3"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Fill" TargetName="ExpandPath" Value="#FF595959"/>
                                    <Setter Property="Stroke" TargetName="ExpandPath" Value="#FF262626"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <commonConvs:OpisiteVisibilityConverter x:Key="convOppositVisibility" />
            <commonConvs:BooleanToVisible x:Key="convBoolYesNotVisibility" />
            <mConv:ReminersCountToVisibleConverter x:Key="counttoVisConv" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <Border  VerticalAlignment="Top"
                     DockPanel.Dock="Top" Height="28"
                     BorderBrush="#FFd3d3d3" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button Command="{Binding BackCommand}"  ToolTip="Back" Style="{DynamicResource browser_btn}">
                        <Grid HorizontalAlignment="Left" Height="18" VerticalAlignment="Bottom" Width="18" >
                            <Path Data="M12.71873,3.0490813 L12.719011,13.408316 4.698245,8.2381057 z" Fill="#FFC7C7C7" Margin="4.583,3,4.25,3.521" Stretch="Fill"/>
                        </Grid>
                    </Button>
                    <Button Command="{Binding ForwardCommand}"
                        ToolTip="Forward"
                        Style="{DynamicResource browser_btn}">
                        <Grid  Height="18" Width="18">
                            <Path Data="M12.71873,3.0490813 L12.719011,13.408316 4.698245,8.2381057 z" Fill="#FFC7C7C7" Margin="4.583,3,4.25,3.521" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleY="1" ScaleX="-1"/>
                                        <SkewTransform AngleY="0" AngleX="0"/>
                                        <RotateTransform Angle="0"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Button>
                    <Button
                        Command="{Binding ReloadCommand}" 
                        ToolTip="Refresh" Margin="0,0,7,0"
                        Style="{DynamicResource browser_btn}">
                        <Image 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="None" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/refresh.png" />
                    </Button>

                    <Button Name="openMacros"  
                            DockPanel.Dock="Right"
                            ToolTip="Open Macros"
                            Margin="0,0,10,0"
                            Command="{Binding OpenMacrosCommand}"
                            Style="{DynamicResource browser_btn}"
                            Visibility="{Binding SetMacrosAvailableVisible}">
                        <Image HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="Uniform" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/browseo-logo-icon-blue-32.png" />
                    </Button>

                    <Button Name="openFlyout"  
                            DockPanel.Dock="Right"
                            Click="openFlyout_Click"
                            ToolTip="Open Saved Sites"
                            Margin="4,0,4,0"
                            Command="{Binding FillListCommand}"
                            Style="{DynamicResource browser_btn}">
                        <Image HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="None" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/add.png" />
                    </Button>
                    
                    

                    <Button Name="Settings" 
                        DockPanel.Dock="Right"
                        ToolTip="Browser Settings" 
                        ContextMenuService.IsEnabled="False"
                        Click="BtnWithContextMenue_Click"
                        Style="{DynamicResource browser_btn}" Margin="5,0,0,3" VerticalAlignment="Bottom">
                        <Image Width="17" Height="17"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="Uniform" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/settings2.png" />
                        <Button.ContextMenu>
                            <ContextMenu Name="cmBrowserSettings" Opened="cmBrowserSettings_Opened" Closed="cmBrowserSettings_Closed">
                                <ContextMenu.Resources>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatbtnStyle}">
                                        <Setter Property="Width" Value="100" />
                                        <Setter Property="Margin" Value="0,3,3,3" />
                                        <Setter Property="BorderBrush" Value="Black" />
                                        <Setter Property="BorderThickness" Value="0.7" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="False">
                                                <Setter Property="Background" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContextMenu.Resources>
                                <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Height="500">
                                    <StackPanel Background="White">
                                        <!--<Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>-->
                                        <MenuItem Margin="2" Header="Save Session" Command="{Binding SaveSession}" />
                                        <MenuItem Margin="2" Header="Delete Last Session" Command="{Binding DeleteSession}" Grid.Row="1" />

                                        <Separator Grid.Row="2"  Margin="-30,0,0,0" />

                                        <MenuItem Margin="2"  Grid.Row="3" Header="Save Open Tabs" ToolTip="Will save all open tabs to a bookmarks folder" Command="{Binding SaveSessionToBMs}" />

                                        <Separator Grid.Row="4"  Margin="-30,0,0,0" />

                                        <!--<MenuItem Header="Security Settings">

                                        </MenuItem>-->
                                        <MenuItem Margin="2" Grid.Row="6" >
                                            <MenuItem.Header>
                                                <CheckBox Content="Flash+Plugins" IsChecked="{Binding FlashEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Margin="2" Grid.Row="7" >
                                            <MenuItem.Header>
                                                <CheckBox Content="WebGL" ToolTip="Disabling may cause website to run slower on some computers with a good graphics card but faster on others that dont, but will block from fingerprinting your webGL identity" 
                                                          IsChecked="{Binding WebGLEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Margin="2" Grid.Row="8" >
                                            <MenuItem.Header>
                                                <CheckBox Content="Javascript" IsChecked="{Binding JavascriptEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Margin="2" Grid.Row="9"  Visibility="{Binding SetWebrtcVisible}">
                                            <MenuItem.Header>
                                                <CheckBox Content="Java" IsChecked="{Binding JavaEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Margin="2" Grid.Row="10"  Visibility="{Binding SetWebrtcVisible}">
                                            <MenuItem.Header>
                                                <CheckBox Content="WebRTC" IsChecked="{Binding WebRTCEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Margin="2" Grid.Row="5" >
                                            <MenuItem.Header>
                                                <CheckBox Content="Allow Tracking (DNT)" IsChecked="{Binding DoNotTrackEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            </MenuItem.Header>
                                        </MenuItem>



                                        <Separator Grid.Row="11"  Margin="-30,0,0,0" />

                                        <MenuItem Margin="2" Grid.Row="12">
                                            <MenuItem.Header>
                                                <CheckBox  Content="Sync Time" IsChecked="{Binding SetSysDateEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Margin="2" Grid.Row="13">
                                            <MenuItem.Header>
                                        <Grid>
                                            <StackPanel Visibility="{Binding VisibleDtPbar}">
                                                <TextBlock Text="Getting Time Zone" />
                                                <ProgressBar IsIndeterminate="True" />
                                            </StackPanel>

                                            <ComboBox SelectedIndex="{Binding SITimeZone}" 
                                                      ItemsSource="{Binding AvailableTimeZones}"
                                                      Visibility="{Binding Path=VisibleDtPbar, Converter={StaticResource convOppositVisibility}}"
                                                      MaxWidth="200" />
                                        </Grid>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <Separator Grid.Row="14"  Margin="-30,0,0,0" />
                                        <DockPanel Margin="2" Grid.Row="15">
                                            <TextBlock Text="Accept Language" Width="150" />
                                            <TextBox Text="{Binding AcceptLanguage}"  MinWidth="50" MaxWidth="200" />
                                        </DockPanel>
                                        <MenuItem Margin="2" Grid.Row="10"  Visibility="{Binding SetWebrtcVisible}">
                                            <MenuItem.Header>
                                                <CheckBox Content="Hide Fonts" IsChecked="{Binding HideFonts, UpdateSourceTrigger=PropertyChanged}" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <DockPanel Margin="2" Grid.Row="15">
                                            <TextBlock Text="Defailt Font Size" Width="150" />
                                            <TextBox Text="{Binding DefaultFontSize}"  MinWidth="50" MaxWidth="200" />
                                        </DockPanel>
                                        <DockPanel Margin="2" Grid.Row="16" >
                                            <TextBlock Text="Minimum Font Size" Width="150" />
                                            <TextBox Text="{Binding MnimumFontSize}"  MinWidth="50" MaxWidth="200" />
                                        </DockPanel>
                                        <MenuItem Margin="2" Grid.Row="17"  Visibility="{Binding SetBrowserSettingsAvailable}">
                                            <MenuItem.Header>
                                        <StackPanel>
                                            <TextBlock Text="Standard Font" />
                                            <ComboBox SelectedIndex="{Binding SIFontStandard}" ItemsSource="{Binding AvailableFonts}" MaxWidth="200" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Margin="2" Grid.Row="18"  Visibility="{Binding SetBrowserSettingsAvailable}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                            <TextBlock Text="Serif Font" />
                                            <ComboBox SelectedIndex="{Binding SIFontSerif}" ItemsSource="{Binding AvailableFonts}" MaxWidth="200" />
                                        </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Margin="2" Grid.Row="19"  Visibility="{Binding SetBrowserSettingsAvailable}">
                                            <MenuItem.Header>
                                        <StackPanel>
                                            <TextBlock Text="Sans-serif Font" />
                                            <ComboBox SelectedIndex="{Binding SIFontSansSerif}" ItemsSource="{Binding AvailableFonts}" MaxWidth="200" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Margin="2" Grid.Row="20"  Visibility="{Binding SetBrowserSettingsAvailable}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                            <TextBlock Text="Fixed-width Font" />
                                            <ComboBox SelectedIndex="{Binding SIFontFixedWidth}" ItemsSource="{Binding AvailableFonts}" MaxWidth="200" />
                                        </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Margin="2" Grid.Row="21"  Visibility="{Binding SetBrowserSettingsAvailable}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Encoding" />
                                                    <ComboBox SelectedIndex="{Binding SIFontEncodings}" ItemsSource="{Binding AvailableEncodeings}" MaxWidth="200" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <Button Margin="3" Grid.Row="22"  Content="Reset Default Fonts" Command="{Binding SettingsCTClick}" CommandParameter="ResetDefaultFonts" Click="cmsBtn_Click" Width="230" />
                                        <Separator Grid.Row="23"  Margin="-30,0,0,0" />

                                        <Button Margin="3" Grid.Row="24"  Content="Set User Agent" Command="{Binding SettingsCTClick}" CommandParameter="UserAgent" Click="cmsBtn_Click" Width="230" />

                                        <Separator Grid.Row="25"  Margin="-30,0,0,0" />

                                        <DockPanel Margin="4" Grid.Row="26" >
                                            <!--<Button Content="Apply To Tab" Command="{Binding SettingsCTClick}" CommandParameter="TAB" Click="cmsBtn_Click" 
                                                    DockPanel.Dock="Left"
                                                    Visibility="{Binding SetBrowserSettingsAvailable}"/>-->
                                            <Button Content="Apply To Session" Command="{Binding SettingsCTClick}" CommandParameter="SESSION" Click="cmsBtn_Click" Width="230"
                                                    DockPanel.Dock="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>


                    <Button Name="SocialCrawl" 
                            DockPanel.Dock="Right"
                            ToolTip="Social Stats Of Urls On Page"
                            Click="SocialCrawl_Click"
                            Style="{DynamicResource browser_btn}">
                        <Image HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="None" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/ic_assessment_black_24dp_1x.png" />
                    </Button>

                    <Button Name="CP" 
                    DockPanel.Dock="Right"
                    ToolTip="Open Copy Paste Window"
                    Command="{Binding OpenCPCommand}" 
                    Style="{DynamicResource browser_btn}">
                        <TextBlock Text="C/P" Margin="0,2,0,0" Foreground="#FFB2B2B2" FontWeight="Bold" FontFamily="Global User Interface" FontSize="13" />
                    </Button>

                    <Button Name="Inject" 
                    DockPanel.Dock="Right"
                    ToolTip="Fill Form With Profile Data"
                    Command="{Binding InjectCommand}" 
                    Style="{DynamicResource browser_btn}">
                        <Image HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="None" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/user.png" Opacity="0.4" />
                    </Button>

                    <Button Name="SaveSite" 
                    DockPanel.Dock="Right"
                    ToolTip="Save Site From Navigation Box Text"
                    Click="SaveSite_Click"
                    Style="{DynamicResource browser_btn}">
                        <Image 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="None" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/save.png" />
                    </Button>

                    <Button Name="btnShare" 
                            Click="BtnWithContextMenue_Click"
                            DockPanel.Dock="Right"
                            ToolTip="Share Site"
                            Style="{DynamicResource browser_btn}">
                        <TextBlock Text="Share"  FontSize="10" Foreground="#c7c7c7" Margin="0,0,0,0"/>
                        <Button.ContextMenu>
                            <ContextMenu>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="facebook"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/facebook-icon.png" 
                                                                   ToolTip="facebook"
                                                                   Width="18" Height="18" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="google"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/googleplus-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="google+" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="digg"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/digg-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="digg" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="pintrest"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/Pinterest-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="pintrest" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="reddit"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/reddit-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="reddit" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="stumbleupon"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/StumbleUpon-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="stumbleupon" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="tumblr"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/tumblr-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="tumblr" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="twitter"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/twitter-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="twitter" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="wordpress"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/wordpress-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="wordpress" />
                                    </Button>
                                </StackPanel>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <mControls:MyComboBox IsEditable="True"
                                          Margin="2"
                                          x:Name="cmbSites"
                                          IsTextSearchEnabled="False"
                                          OnAfterTextBoxKeyDown="cmbSites_PreviewKeyDown"
                                          OnAfterSelectionChanged="cmbSites_OnAfterSelectionChanged"
                                          PreviewMouseDown="cmbSites_PreviewMouseDown"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.CanContentScroll="False"
                                          TextElement.FontSize="13"
                                          Text="{Binding AddressEditable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Width" Value="{Binding Path=ActualWidth,ElementName=cmbSites}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <!--<ComboBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding GoCommand}" />
                    </ComboBox.InputBindings>-->
                    </mControls:MyComboBox>
                    <!--<TextBox Height="23"
                         Text="{Binding AddressEditable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                         GotMouseCapture="OnTextBoxGotMouseCapture">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding GoCommand}" />
                    </TextBox.InputBindings>
                </TextBox>-->
                </DockPanel>
            </Border>

            <StatusBar DockPanel.Dock="Bottom">
                <!--<Controls:MetroProgressBar
                            HorizontalAlignment="Right"
                             IsIndeterminate="{Binding IsLoading}"
                             Width="100"
                             Height="16"
                             Margin="3" />-->
                <ProgressBar HorizontalAlignment="Right"
                             IsIndeterminate="{Binding IsLoading}"
                             Width="100"
                             Height="16"
                             Margin="3" />
                <TextBlock Text="{Binding StatusMessage}" />
                <Separator />
                <TextBlock Text="{Binding HuverLink}" />
                <Separator />
                <TextBlock Text="{Binding OutputMessage}" />
            </StatusBar>

            <Grid Background="#FFF0F0F0" Name="browserGrd">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Rectangle Name="rctangle" Grid.RowSpan="2">
                    <Rectangle.Fill>
                        <VisualBrush TileMode="Tile"
                                     Viewport="0,0,150,150"
                                     ViewportUnits="Absolute"
                                     Opacity="0.05">
                            <VisualBrush.Visual>
                                <Border BorderBrush="#FFF0F0F0" BorderThickness="4">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontWeight="Bold" Margin="0,0,0,10" FontSize="16" Text="Brow·SEO" />
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico" Stretch="Fill"  Margin="0,0,0,-80"  Width="45" Height="45" />
                                    </StackPanel>
                                </Border>
                            </VisualBrush.Visual>
                            <VisualBrush.Transform>
                                <RotateTransform Angle="-22.5" />
                            </VisualBrush.Transform>
                        </VisualBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Expander Name="SocialStatsExpander" 
                          ExpandDirection="Down"
                          VerticalAlignment="Top"
                          Grid.Column="0"
                          Header="Social Stats"
                          Height="300"
                          Background="WhiteSmoke"
                          Visibility="Collapsed"
                          IsExpanded="{Binding SocialStatsCrawlActive}"
                          Expanded="SocialCrawl_Click"
                          Collapsed="SocialStatsExpander_Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Check All Links On Page" IsChecked="{Binding IsCrawlAllActive}" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="3" />
                        <Button Content="Clear" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource FlatbtnStyle}" Width="70" Margin="3"
                                Command="{Binding OnCommandFromView}" CommandParameter="ClearSocialStats" Grid.Column="1"/>

                        <commonControls:CirclePBarControl Visibility="{Binding IsLoadingStatsVisible}" Grid.Column="1" Grid.Row="1" />
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Style="{StaticResource FlatbtnStyle}" Content="Check These Links" Margin="3,3,6,3"
