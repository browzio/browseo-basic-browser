<Window x:Class="DragDropListview.Windows.EditBookmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 SizeToContent="WidthAndHeight" Icon="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico" ResizeMode="NoResize" Title="Bookmarks" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10" Name="spName">
            <TextBlock Text="Name:" Height="18" Width="60" />
            <TextBox Name="tbName" Width="200" Height="25" PreviewMouseDown="Email_PreviewMouseDown" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="10" Visibility="Collapsed" Name="spCmbName">
            <TextBlock Text="Name:" Height="18" Width="60" />
            <ComboBox Name="cmbImportedFolders"  HorizontalAlignment="Left" Width="200" IsEditable="True" BorderThickness="0" Background="#eeeeee"/>
        </StackPanel>


        <StackPanel Name="spUrl" Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBlock Text="URL:" Height="18" Width="60" />
            <TextBox Name="tbURL" Width="200" Height="25" PreviewMouseDown="Email_PreviewMouseDown" />
        </StackPanel>

        <StackPanel Name="spFolder" Grid.Row="2" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Folder:" Height="18" Width="60" />
            <ComboBox Name="cmbFolders" Width="200" Height="25" BorderThickness="0" Background="#eeeeee" />
        </StackPanel>

        <StackPanel Name="spImports" Grid.Row="3" Orientation="Horizontal"  Visibility="Collapsed">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Email:" Height="18" Width="60" />
                    <TextBox Name="Email" Width="200" Height="25" PreviewMouseDown="Email_PreviewMouseDown" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Username:" Height="18" Width="60" />
                    <TextBox Name="Username" Width="200" Height="25" PreviewMouseDown="Email_PreviewMouseDown" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Password:" Height="18" Width="60" />
                    <TextBox Name="Password" Width="200" Height="25" PreviewMouseDown="Email_PreviewMouseDown" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--<CheckBox Grid.Row="3" Margin="10" Content="Save Time Stamp" Name="cbTimeStamt" x:FieldModifier="public" IsChecked="True" />-->
        
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right" Name="spButtons">
            <Button Name="btnCancel" Content="Cancel"  Width="70" Height="25" Margin="10" Click="btnCancel_Click" Style="{StaticResource FlatbtnStyle}" />

            <Button Name="btnSave" Content="Save" Width="70" Height="25" Margin="10" Click="btnSave_Click" Style="{StaticResource FlatbtnStyle}" />
        </StackPanel>
    </Grid>
</Window>
