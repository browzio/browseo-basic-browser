    <ItemsPanelTemplate x:Key="dtItemsPanes">
        <VirtualizingStackPanel />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="dtMedia">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top"  />
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Grid>
                        <Border Canvas.Left="55"
                                            Canvas.Top="30"
                                            Width="40"
                                            Height="40"
                                            Margin="2"
                                            VerticalAlignment="Top"
                                            BorderBrush="Black"
                                            BorderThickness=".5"
                                            CornerRadius="20">
                            <Border Name="ReceiverColor"
                                                BorderBrush="Black"
                                                BorderThickness="1"
                                                CornerRadius="17">
                                <Grid>
                                    <Border Name="Mask"
                                                        Background="White"
                                                        BorderBrush="Black"
                                                        BorderThickness=".5"
                                                        CornerRadius="15">
                                    </Border>
                                    <StackPanel>
                                        <Image Source="{Binding Path=User.ProfilePicture, Converter={StaticResource linktoimageconv}}" />
                                        <StackPanel.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=Mask}" />
                                        </StackPanel.OpacityMask>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding User.Username}" Foreground="{StaticResource colorInstagram}" 
                                            Margin="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CreatedTime, StringFormat='{}{0:MM/dd/yyyy}'}" 
                                            Foreground="{StaticResource colorInstagramGray}" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                </DockPanel>
                <Image Grid.Row="1"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           Source="{Binding Images.StandardResolution.Url, Converter={StaticResource linktoimageconv}}" />

                <Grid Grid.Row="2" >
                    <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Medium" FontSize="14">
                            <Run Text="Likes " />
                            <Run Text="{Binding Likes.Count}" />
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Row="3" FontWeight="Medium" FontSize="14">
                                <Run Text="Comments " />
                                <Run Text="{Binding CommentCount}" />
                </TextBlock>

                <TextBlock Grid.Row="4" FontWeight="Medium" FontSize="14">
                           <Run Text="Tags " />
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Tags}" Grid.Row="5" >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel Orientation="Horizontal" Grid.Row="6" Margin="5">
                    <Button Content="Load Comments" 
                                Margin="5"
                                Visibility="{Binding CommentsData, Converter={StaticResource emptyListToVisibleConv}}"
                                Command="{Binding OnCommandFromView}" CommandParameter="LOADComments" />
                </WrapPanel>

                <ListView Grid.Row="7" 
                              ItemsSource="{Binding CommentsData}"
                              ItemContainerStyle="{StaticResource dtCommentsListItemTemplate}"
                              BorderThickness="0"
                              Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8">
                                <TextBox Text="{Binding From.Username}"
                                             Style="{StaticResource readOnlytb}" 
                                             TextElement.Foreground="{StaticResource colorInstagram}" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip="{Binding Text}" />
                                <TextBlock Foreground="{StaticResource colorInstagramGray}" Text="{Binding CreatedTime}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="8" Margin="1,1,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button ToolTip="Like"
                                Width="25" Height="25"
                                Command="{Binding OnCommandFromView}" CommandParameter="LIKE"
                                Visibility="{Binding UserHasLiked, Converter={StaticResource booltovisConv}, ConverterParameter=NOT}">
                        <Image Source="/GoViral;component/Images/ic_favorite_border_black_24dp_2x.png" />
                    </Button>
                    <Button ToolTip="Un Like"
                                Width="25" Height="25"
                                Command="{Binding OnCommandFromView}" CommandParameter="unLIKE"
                                Visibility="{Binding UserHasLiked, Converter={StaticResource booltovisConv}}">
                        <Image Source="/GoViral;component/Images/ic_favorite_black_24dp_2x.png" />
                    </Button>
                    <TextBox  Grid.Column="1"
                                  Text="{Binding AddCommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                  BorderThickness="0,1,0,0" BorderBrush="{StaticResource colorInstagramGray}"
                                  Height="30" Margin="3,0,0,0" 
                                  HorizontalAlignment="Stretch"
                                  FontSize="14" TextElement.Foreground="{StaticResource colorInstagramGray}"
                                  GotMouseCapture="TextBox_GotMouseCapture">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding OnCommandFromView}" CommandParameter="ADDComment" />
                            <!--<MouseBinding Gesture="LeftClick" Command="{Binding OnCommandFromView}" CommandParameter="Clicked" />-->
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="dtUserAll">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top"  />

            <Grid Grid.IsSharedSizeScope="True" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" SharedSizeGroup="Foo" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Image Source="{Binding Path=ProfilePicture, Converter={StaticResource linktoimageconv}}"
                                        Margin="3"
                                        Stretch="UniformToFill"
                                        Width="80" Height="80"
                                        VerticalAlignment="Top" HorizontalAlignment="Center"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Top"
                                    Visibility="{Binding Relationship, Converter={StaticResource nulltovisConv}, ConverterParameter=NOT}">
                        <TextBlock Text="{Binding Relationship, Converter={StaticResource relationToText}, ConverterParameter=Follower}" 
                                       Margin="1" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Relationship, Converter={StaticResource relationToText}, ConverterParameter=Folowing}" 
                                       Margin="1" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Row="1" VerticalAlignment="Top"
                                Content="Get Relationship"
                                Command="{Binding OnCommandFromView}" CommandParameter="LOADRelation"
                                Visibility="{Binding Relationship, Converter={StaticResource nulltovisConv}}" />

                    <Button Grid.Row="2" 
                                Name="btnMore"
                                ToolTip="More Options"
                                Click="btnMore_Click"
                                VerticalAlignment="Bottom"
                                BorderThickness="0"
                                Background="Transparent"
                                Width="24" Height="24" 
                                Cursor="Hand"
                                Style="{x:Null}"
                                IsEnabled="{Binding Relationship, Converter={StaticResource relationToEnabledConv}}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/GoViral;component/Images/ic_more_horiz_black_24dp_2x.png"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Stretch="Fill" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Follow"
                                              Command="{Binding OnCommandFromView}" CommandParameter="FOLLOW"
                                              Visibility="{Binding Relationship, Converter={StaticResource relationToVisConv}, ConverterParameter=FOLLOW}" />
                                <MenuItem Header="Un Follow"
                                              Command="{Binding OnCommandFromView}" CommandParameter="FOLLOWUn"
                                              Visibility="{Binding Relationship, Converter={StaticResource relationToVisConv}, ConverterParameter=FOLLOWUn}" />
                                <MenuItem Header="Accept Request"
                                              Command="{Binding OnCommandFromView}" CommandParameter="FOLLOWAccept"
                                              Visibility="{Binding Relationship, Converter={StaticResource relationToVisConv}, ConverterParameter=FOLLOWAccept}" />
                                <MenuItem Header="Block User"
                                              Command="{Binding OnCommandFromView}" CommandParameter="FOLLOWBlock"
                                              Visibility="{Binding Relationship, Converter={StaticResource relationToVisConv}, ConverterParameter=FOLLOWBlock}" />
                                <MenuItem Header="UnBlock User"
                                              Command="{Binding OnCommandFromView}" CommandParameter="FOLLOWUnBlock"
                                              Visibility="{Binding Relationship, Converter={StaticResource relationToVisConv}, ConverterParameter=FOLLOWUnBlock}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <StackPanel Margin="5" Grid.Column="1" Grid.RowSpan="2">
                        <TextBox Text="{Binding Username}" IsReadOnly="True"  BorderThickness="0" Background="Transparent" />
                        <TextBox Text="{Binding Id}"       IsReadOnly="True"  BorderThickness="0" Background="Transparent" />
                        <TextBox Text="{Binding FullName}" IsReadOnly="True"  BorderThickness="0" Background="Transparent" />
                        <TextBox Text="{Binding Website}"  IsReadOnly="True"  BorderThickness="0" Background="Transparent" />
                        <TextBlock TextWrapping="Wrap" ToolTip="{Binding Bio}">
                                <Run Text="Bio: " />
                                <Run Text="{Binding Bio}"  />
                        </TextBlock>

                        <Button Content="Load Counts" ToolTip="Followers, Following, Media"
                                    HorizontalAlignment="Left"
                                    Margin="2"
                                    Command="{Binding OnCommandFromView}" CommandParameter="LOADCounts"
                                    Visibility="{Binding Counts, Converter={StaticResource nulltovisConv}}" />

                        <StackPanel Visibility="{Binding Counts, Converter={StaticResource nulltovisConv}, ConverterParameter=NOT}">
                            <TextBlock>
                                    <Run Text="Followed By: " />
                                    <Run Text="{Binding Counts.FollowedBy}" />
                            </TextBlock>
                            <TextBlock>
                                    <Run Text="Follows: " />
                                    <Run Text="{Binding Counts.Follows}" />
                            </TextBlock>
                            <TextBlock>
                                    <Run Text="Media: " />
                                    <Run Text="{Binding Counts.Media}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <WrapPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" Margin="5">
                    <Button Content="Load Media" 
                                Margin="5"
                                Visibility="{Binding MediaRecent, Converter={StaticResource emptyListToVisibleConv}}"
                                Command="{Binding OnCommandFromView}" CommandParameter="LOADMEDIA" />

                    <!--<Button Content="Load Folowing" 
                                Margin="5"
                                Visibility="{Binding Folowing, Converter={StaticResource emptyListToVisibleConv}}"
                                Command="{Binding OnCommandFromView}" CommandParameter="LOADFolowing" />

                        <Button Content="Load Followers" 
                                Margin="5"
                                Visibility="{Binding Folowers, Converter={StaticResource emptyListToVisibleConv}}"
                                Command="{Binding OnCommandFromView}" CommandParameter="LOADFollowers" />-->
                </WrapPanel>

                <Expander ExpandDirection="Down"
                              Grid.Row="2" Grid.ColumnSpan="2" 
                              Visibility="{Binding MediaRecent, Converter={StaticResource emptyListToVisibleConv}, ConverterParameter=NOT}">
                    <Expander.Header>
                        <TextBlock Text="Media" Foreground="{StaticResource colorInstagramBlue}" />
                    </Expander.Header>
                    <ListView ItemsSource="{Binding MediaRecent}"
                                  ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                                  ItemTemplate="{StaticResource dtMedia}"
                                  Grid.Row="2" Grid.ColumnSpan="2" 
                                  BorderThickness="0"
                                  Margin="5"
                                  Background="Transparent">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                    <Expander.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Collapse" Click="MenuItem_Click" />
                        </ContextMenu>
                    </Expander.ContextMenu>
                </Expander>

                <!--<ListView ItemsSource="{Binding Folowing}"
                              ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                              ItemTemplate="{DynamicResource dtUserAll}"
                              Grid.Row="3" Grid.ColumnSpan="2"
                              BorderThickness="0"
                              Background="Transparent"
                              PreviewMouseWheel="lv_PreviewMouseWheel">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>

                    <ListView ItemsSource="{Binding Folowers}"
                              ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                              ItemTemplate="{DynamicResource dtUserAll}"
                              Grid.Row="4" Grid.ColumnSpan="2"
                              BorderThickness="0"
                              Background="Transparent"
                              PreviewMouseWheel="lv_PreviewMouseWheel">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>-->
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="dtTags">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="5">
                    <TextBox Text="{Binding Name}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                    <TextBlock>
                                                                <Run Text="Media Count: " />
                                                                <Run Text="{Binding MediaCount}" />
                    </TextBlock>
                </StackPanel>

                <WrapPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" Margin="5">
                    <Button Content="Load Recent Media" 
                                                                Visibility="{Binding MediaRecent, Converter={StaticResource emptyListToVisibleConv}}"
                                                                Command="{Binding OnCommandFromView}" CommandParameter="LOADMEDIA" />
                </WrapPanel>

                <Expander ExpandDirection="Down"
                                                              Grid.Row="2" Grid.ColumnSpan="2" 
                                                              Visibility="{Binding MediaRecent, Converter={StaticResource emptyListToVisibleConv}, ConverterParameter=NOT}">
                    <Expander.Header>
                        <TextBlock Text="Media" Foreground="{StaticResource colorInstagramBlue}" />
                    </Expander.Header>
                    <ListView ItemsSource="{Binding MediaRecent}"
                                                                  ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                                                                  ItemTemplate="{StaticResource dtMedia}"
                                                                  Grid.Row="2" Grid.ColumnSpan="2" 
                                                                  BorderThickness="0"
                                                                  Margin="5"
                                                                  Background="Transparent">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                    <Expander.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Collapse" Click="MenuItem_Click" />
                        </ContextMenu>
                    </Expander.ContextMenu>
                </Expander>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>