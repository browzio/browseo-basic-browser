<UserControl x:Class="GoViral.Instagram.InstControls.InstaUserUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoViral.Instagram.InstControls"
             xmlns:mvm="clr-namespace:GoViral.Instagram.InstViewModels"
             xmlns:lConverter="clr-namespace:GoViral.Converters"
             mc:Ignorable="d" >
    <UserControl.Resources>
        <lConverter:LinkToImageConverter x:Key="linktoimageconv" />
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Source="{Binding Path=User.ProfilePicture, Source={x:Static mvm:InstaVM.Instance}, Converter={StaticResource linktoimageconv}}"
               Margin="5"
               Stretch="Fill"
               Width="35" Height="35" VerticalAlignment="Center"/>
        <StackPanel Margin="5" Grid.Column="1">
            <TextBox Text="{Binding User.Username, Source={x:Static mvm:InstaVM.Instance}}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
            <TextBox Text="{Binding User.Id, Source={x:Static mvm:InstaVM.Instance}}"       IsReadOnly="True" BorderThickness="0" Background="Transparent" />
            <TextBox Text="{Binding User.FullName, Source={x:Static mvm:InstaVM.Instance}}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
        </StackPanel>
    </Grid>
</UserControl>
