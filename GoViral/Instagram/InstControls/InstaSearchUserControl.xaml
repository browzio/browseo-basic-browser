<UserControl x:Class="GoViral.Instagram.InstControls.InstaSearchUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoViral.Instagram.InstControls"
             xmlns:mvm="clr-namespace:GoViral.Instagram.InstViewModels"
             xmlns:InstViewModels="clr-namespace:GoViral.Instagram.InstViewModels"
             xmlns:gConverters="clr-namespace:Organiser.Common.Converters;assembly=Organiser.Common"
             xmlns:lConverters="clr-namespace:GoViral.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
                <ResourceDictionary Source="../InstaResourcesDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Background="#fafafa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
         </Grid.RowDefinitions>

        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,2" Height="23"
                    Visibility="{Binding Source={x:Static mvm:InstaVM.Instance},
                                         Path=User,
                                         Converter={StaticResource nulltovisConv}}"
                    Command="{Binding Source={x:Static mvm:InstaVM.Instance}, Path=OnCommandFromView}" CommandParameter="LOGIN">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Login" VerticalAlignment="Center" />
                <Image Source="/GoViral;component/Images/ic_person_black_24dp_2x.png" />
            </StackPanel>
        </Button>
        <local:InstaUserUserControl Margin="0,2,0,2"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" 
                                    Visibility="{Binding Source={x:Static mvm:InstaVM.Instance},
                                                             Path=User,
                                                             Converter={StaticResource nulltovisConv},  
                                                             ConverterParameter=NOT}" />

        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,2" Height="23" Content="Save"
                Command="{Binding OnCommandFromView}" CommandParameter="SAVE" />
        
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Inst·EO"
				    HorizontalAlignment="Center"
				    FontWeight="Medium"
				    FontSize="30"
				    Foreground="{StaticResource colorInstagram}" />
            <TextBlock Text="1.Select search opions 2.Enter A Tag or comma seperated Tags 3.Click logo or press Enter to search." Foreground="{StaticResource colorInstagramGray}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="10" HorizontalAlignment="Stretch">
            <CheckBox Content="Users" IsChecked="{Binding CheckedSearchUsers}" Margin="3" />
            <CheckBox Content="Tags" IsChecked="{Binding CheckedSearchTags}" Margin="3" />
            <CheckBox Content="Media" IsChecked="{Binding CheckedSearchMedia}" Margin="3,3,5,3" />
            <Button DockPanel.Dock="Right" Margin="15,0,0,0" Height="25" Width="45" 
                    Command="{Binding OnCommandFromView}" CommandParameter="SEARCH">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="TextElement.FontWeight" Value="Medium" />
                        <Setter Property="TextElement.Foreground" Value="White" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border BorderThickness="1" UseLayoutRounding="False" BorderBrush="WhiteSmoke" x:Name="bd">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/GoViral;component/Images/instagram-logo.png" Stretch="UniformToFill"  />
                                            <!--<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <LinearGradientBrush.GradientStops>
                                                    <GradientStopCollection>
                                                        <GradientStop Color="#ff3939"  Offset="0"  />
                                                        <GradientStop Color="#ff3939"  Offset="0.1"  />
                                                        <GradientStop Color="#ff3939"  Offset="0.2"  />
                                                        <GradientStop Color="#fed049"  Offset="0.3" />
                                                        <GradientStop Color="#fed049"  Offset="0.4" />
                                                        <GradientStop Color="#fed049"  Offset="0.5" />
                                                        <GradientStop Color="#10dd76"  Offset="0.6" />
                                                        <GradientStop Color="#10dd76"  Offset="0.7" />
                                                        <GradientStop Color="#5fccff"  Offset="0.8" />
                                                        <GradientStop Color="#5fccff"  Offset="0.9" />
                                                        <GradientStop Color="#5fccff"  Offset="1" />
                                                    </GradientStopCollection>
                                                </LinearGradientBrush.GradientStops>
                                            </LinearGradientBrush>-->
                                        </Border.Background>
                                        <ContentPresenter Content="{TemplateBinding Content}"
											VerticalAlignment="Center"
											HorizontalAlignment="Center" />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="TextElement.Foreground" Value="#895a4d" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="Gray" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <TextBox Text="{Binding KeyWords, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding OnCommandFromView}" CommandParameter="SEARCH" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>


        <!--searches-->
        <Grid  Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--users-->
            <Grid  Margin="5" Name="grdUsers"
                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Border Background="{StaticResource colorInstagram}" HorizontalAlignment="Stretch">
                    <DockPanel>
                        <TextBlock Text="Users" Foreground="White" FontWeight="Medium" VerticalAlignment="Center" FontSize="15" Margin="3,0,0,0" />
                        <!--<Image Name="imgResize"
                                        Source="/GoViral;component/Images/ic_settings_resize_clean.png"
                                        DockPanel.Dock="Right"
                                        Width="20" Height="20" 
                                        Margin="5"
                                        Cursor="SizeWE"
                                        PreviewMouseDown="resize_grdUsers"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"/>-->

                        <Button ToolTip="Options"
                                        HorizontalAlignment="Right"
                                        Width="20" Height="20" 
                                        Margin="3"
                                        Click="btnMore_Click"
                                        ContextMenu="{StaticResource ctUsersBulk}"
                                        DockPanel.Dock="Right">
                            <Image Source="/GoViral;component/Images/ic_more_horiz_white.png"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Stretch="Fill" />
                        </Button>

                        <Button HorizontalAlignment="Right" Width="20" Height="20" Margin="3" ToolTip="Clear"
                                        DockPanel.Dock="Right"
                                        Command="{Binding OnCommandFromView}" CommandParameter="CLEARUSERS">
                            <Image Source="/GoViral;component/Images/ic_clear_black_24dp_2x.png" Stretch="Fill" />
                        </Button>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Name="svUsers" 
                              HorizontalAlignment="Stretch"
                              Grid.Row="1"
                              Margin="0,3,0,0"
                              ScrollViewer.CanContentScroll="True">
                    <ListView ItemsSource="{Binding InstaResponseListsList}"
                              SelectedItem="{Binding InstaResponseLists}"
                              Style="{StaticResource lvDefault}"
                              PreviewMouseWheel="lv_PreviewMouseWheel">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource dtCommentsListItemTemplate}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserSearchResponse.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander ExpandDirection="Down">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Foo" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Bar" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Tag}" VerticalAlignment="Center"  />
                                            <TextBlock Text="{Binding UsersCount}"  VerticalAlignment="Center"  Grid.Column="1" Margin="10,0,10,0"  />
                                            
                                            <Button Grid.Column="2" 
                                                    HorizontalAlignment="Right"
                                                    ToolTip="More Options"
                                                    Click="btnMore_Click"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Width="20" Height="20" 
                                                    Margin="3"
                                                    Cursor="Hand"
                                                    Style="{x:Null}"
                                                    ContextMenu="{StaticResource ctUsersBulk}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/GoViral;component/Images/ic_more_horiz_black_24dp_2x.png"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Stretch="Fill" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                    
                                    <ListView ItemsSource="{Binding UserSearchResponse}"
                                              ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                                              ItemTemplate="{StaticResource dtUserAll}"
                                              Style="{StaticResource lvDefault}">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </Grid>
            <GridSplitter ResizeDirection="Columns" 
                            Grid.Column="0"
                            Margin="0,31,0,0"
                            Width="3" 
                            Height="Auto"
                            Background="LightGray" />
            
            <!--tags-->
            <Grid Grid.Column="1" Margin="5" Name="grdTags"
                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource colorInstagram}">
                    <DockPanel>
                        <TextBlock Text="Tags" Foreground="White" FontWeight="Medium" VerticalAlignment="Center" FontSize="15" Margin="3,0,0,0" />

                        <Button ToolTip="Options"
                                    HorizontalAlignment="Right"
                                    Width="20" Height="20" 
                                    Margin="3"
                                ContextMenu="{StaticResource ctUTagsBulk}"
                                    Click="btnMore_Click"
                                    DockPanel.Dock="Right">
                            <Image Source="/GoViral;component/Images/ic_more_horiz_white.png"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Stretch="Fill" />
                        </Button>

                        <Button HorizontalAlignment="Right" Width="20" Height="20" Margin="3" ToolTip="Clear"
                                    DockPanel.Dock="Right"
                                    Command="{Binding OnCommandFromView}" CommandParameter="CLEARTAGS">
                            <Image Source="/GoViral;component/Images/ic_clear_black_24dp_2x.png" Stretch="Fill" />
                        </Button>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Name="svTags" 
                              Margin="0,3,0,0"
                              ScrollViewer.CanContentScroll="True">
                    <ListView ItemsSource="{Binding InstaResponseListsList}"
                              SelectedItem="{Binding InstaResponseLists}"
                              Style="{StaticResource lvDefault}"
                              PreviewMouseWheel="lv_PreviewMouseWheel">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource dtCommentsListItemTemplate}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TagsSearchResponse.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander ExpandDirection="Down">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Foo" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Bar" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Tag}" VerticalAlignment="Center"  />
                                            <TextBlock Text="{Binding TagsCount}" VerticalAlignment="Center"  Grid.Column="1" Margin="10,0,10,0"  />

                                            <Button Grid.Column="2" 
                                                    ToolTip="More Options"
                                                    Click="btnMore_Click"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Width="20" Height="20" 
                                                    Margin="3"
                                                    Cursor="Hand"
                                                    Style="{x:Null}"
                                                    ContextMenu="{StaticResource ctUTagsBulk}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/GoViral;component/Images/ic_more_horiz_black_24dp_2x.png"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Stretch="Fill" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                    
                                    <ListView ItemsSource="{Binding TagsSearchResponse}"
                                              ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                                              ItemTemplate="{StaticResource dtTags}" 
                                              Style="{StaticResource lvDefault}">
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </Grid>
            <GridSplitter ResizeDirection="Columns" 
                          Grid.Column="1"
                          Margin="0,31,0,0"
                          Width="3" 
                          Height="Auto"
                          Background="LightGray"/>

            <!--media-->
            <Grid Grid.Column="2" Margin="5" Name="grdMedia"
                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource colorInstagram}">
                    <DockPanel>
                        <TextBlock Text="Media" Foreground="White" FontWeight="Medium" VerticalAlignment="Center" FontSize="15" Margin="3,0,0,0" />
                        
                        <Button ToolTip="Options"
                                HorizontalAlignment="Right"
                                Width="20" Height="20" 
                                Margin="3"
                                ContextMenu="{StaticResource ctUMediaBulk}"
                                Click="btnMore_Click"
                                DockPanel.Dock="Right">
                            <Image Source="/GoViral;component/Images/ic_more_horiz_white.png"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Stretch="Fill" />
                        </Button>

                        <Button HorizontalAlignment="Right" Width="20" Height="20" Margin="3" ToolTip="Clear"
                                    DockPanel.Dock="Right"
                                    Command="{Binding OnCommandFromView}" CommandParameter="CLEARMedia">
                            <Image Source="/GoViral;component/Images/ic_clear_black_24dp_2x.png" Stretch="Fill" />
                        </Button>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Name="svMedia" 
                              Margin="0,3,0,0"
                              ScrollViewer.CanContentScroll="True">
                    <ListView ItemsSource="{Binding InstaResponseListsList}"
                              SelectedItem="{Binding InstaResponseLists}"
                              Style="{StaticResource lvDefault}"
                              PreviewMouseWheel="lv_PreviewMouseWheel">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource dtCommentsListItemTemplate}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MediaSearchResponse.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander ExpandDirection="Down">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Foo" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Bar" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Tag}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding MediaCount}" VerticalAlignment="Center" Grid.Column="1" Margin="10,0,10,0" />

                                            <Button Grid.Column="2" 
                                                    ToolTip="More Options"
                                                    Click="btnMore_Click"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Width="20" Height="20" 
                                                    Margin="3"
                                                    Cursor="Hand"
                                                    Style="{x:Null}"
                                                    ContextMenu="{StaticResource ctUMediaBulk}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/GoViral;component/Images/ic_more_horiz_black_24dp_2x.png"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Stretch="Fill" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Expander.Header>

                                    <ListView ItemsSource="{Binding MediaSearchResponse}"
                                              ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                                              ItemTemplate="{StaticResource dtMedia}"
                                              Style="{StaticResource lvDefault}">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
