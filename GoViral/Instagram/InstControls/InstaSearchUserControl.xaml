<UserControl x:Class="GoViral.Instagram.InstControls.InstaSearchUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoViral.Instagram.InstControls"
             xmlns:mvm="clr-namespace:GoViral.Instagram.InstViewModels"
             xmlns:InstViewModels="clr-namespace:GoViral.Instagram.InstViewModels"
             xmlns:gConverters="clr-namespace:Organiser.Common.Converters;assembly=Organiser.Common"
             xmlns:lConverters="clr-namespace:GoViral.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!--converters-->
            <gConverters:NullToVisibleConverter x:Key="nulltovisConv" />
            <gConverters:ElementSizeMathConverter x:Key="mathsizeConv" />
            <gConverters:EmptyListToVisibleConverter x:Key="emptyListToVisibleConv" />
            <gConverters:BooleanToVisible x:Key="booltovisConv" />
            <lConverters:LinkToImageConverter x:Key="linktoimageconv" />
            <lConverters:RelationshipToEnabledConv x:Key="relationToEnabledConv" />
            <lConverters:RelationshipToImageConv x:Key="relationToImage" />
            <lConverters:RelationshipToTextConv x:Key="relationToText" />

            <!--brushes-->
            <SolidColorBrush x:Key="colorListDevider" Color="#B6B6B6" />
            <SolidColorBrush x:Key="colorListDeviderSelected" Color="#C5CAE9" />
            <SolidColorBrush x:Key="colorInstagram" Color="#3f729b" />
            <SolidColorBrush x:Key="colorInstagramGray" Color="#a5a7aa" />
            <SolidColorBrush x:Key="colorInstagramBlue" Color="#4090db" />

            <!--styles-->
            <Style TargetType="ListViewItem" x:Key="dtBaseListItemTemplate">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Name="bd"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource colorListDevider}"
                                    Background="WhiteSmoke">
                                <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                               HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                               VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource colorListDeviderSelected}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource colorListDeviderSelected}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ListViewItem" x:Key="dtCommentsListItemTemplate">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Name="bd"
                                    BorderThickness="0,0,0,0"
                                    BorderBrush="{StaticResource colorListDevider}"
                                    Background="WhiteSmoke">
                                <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                               HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                               VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Button}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="TextElement.FontWeight" Value="Medium" />
                <Setter Property="TextElement.Foreground" Value="White" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="bd" Background="{StaticResource colorInstagramBlue}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Margin="3"
											      VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="TextElement.Foreground" Value="#895a4d" />
                                    <Setter TargetName="bd" Property="BorderBrush" Value="Gray" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox" x:Key="readOnlytb">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            
            <!--templates-->
            <DataTemplate x:Key="dtMedia">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Grid>
                            <Border Canvas.Left="55"
                                            Canvas.Top="30"
                                            Width="40"
                                            Height="40"
                                            Margin="2"
                                            VerticalAlignment="Top"
                                            BorderBrush="Black"
                                            BorderThickness=".5"
                                            CornerRadius="20">
                                <Border Name="ReceiverColor"
                                                BorderBrush="Black"
                                                BorderThickness="1"
                                                CornerRadius="17">
                                    <Grid>
                                        <Border Name="Mask"
                                                        Background="White"
                                                        BorderBrush="Black"
                                                        BorderThickness=".5"
                                                        CornerRadius="15">
                                        </Border>
                                        <StackPanel>
                                            <Image Source="{Binding Path=User.ProfilePicture, Converter={StaticResource linktoimageconv}}" />
                                            <StackPanel.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=Mask}" />
                                            </StackPanel.OpacityMask>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding User.Username}" Foreground="{StaticResource colorInstagram}" Cursor="Hand"
                                            Margin="10" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CreatedTime, StringFormat='{}{0:MM/dd/yyyy}'}" 
                                            Foreground="{StaticResource colorInstagramGray}" 
                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <Image Grid.Row="1"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Left"
                           Source="{Binding Images.StandardResolution.Url, Converter={StaticResource linktoimageconv}}"
                           Width="{Binding ElementName=lv, Path=ActualWidth, Converter={StaticResource mathsizeConv}, ConverterParameter=M-M15}"/>

                    <Grid Grid.Row="2" >
                        <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Medium" FontSize="14">
                            <Run Text="Likes " />
                            <Run Text="{Binding Likes.Count}" />
                        </TextBlock>
                    </Grid>

                    <TextBlock Grid.Row="3" FontWeight="Medium" FontSize="14">
                                <Run Text="Comments " />
                                <Run Text="{Binding Comments.Count}" />
                    </TextBlock>

                    <TextBlock Grid.Row="4" FontWeight="Medium" FontSize="14">
                           <Run Text="Tags " />
                    </TextBlock>
                    
                    <ItemsControl ItemsSource="{Binding Tags}" Grid.Row="5" >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Orientation="Horizontal" Grid.Row="6" Margin="5">
                        <Button Content="Load Comments" 
                                Margin="5"
                                Visibility="{Binding Comments.Data, Converter={StaticResource emptyListToVisibleConv}}"
                                Command="{Binding OnCommandFromView}" CommandParameter="LOADComments" />
                    </WrapPanel>

                    <ListView Grid.Row="7" 
                              ItemsSource="{Binding Comments.Data}"
                              ItemContainerStyle="{StaticResource dtCommentsListItemTemplate}"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8">
                                    <TextBox Text="{Binding From.Username}"
                                             Style="{StaticResource readOnlytb}" 
                                             TextElement.Foreground="{StaticResource colorInstagram}" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip="{Binding Text}" />
                                    <TextBlock Foreground="{StaticResource colorInstagramGray}" Text="{Binding CreatedTime}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="8" Margin="1,1,1,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button ToolTip="Like"
                                Width="25" Height="25"
                                Command="{Binding OnCommandFromView}" CommandParameter="LIKE"
                                Visibility="{Binding UserHasLiked, Converter={StaticResource booltovisConv}, ConverterParameter=NOT}">
                            <Image Source="/GoViral;component/Images/ic_favorite_border_black_24dp_2x.png" />
                        </Button>
                        <Button ToolTip="Un Like"
                                Width="25" Height="25"
                                Command="{Binding OnCommandFromView}" CommandParameter="unLIKE"
                                Visibility="{Binding UserHasLiked, Converter={StaticResource booltovisConv}}">
                            <Image Source="/GoViral;component/Images/ic_favorite_black_24dp_2x.png" />
                        </Button>
                        <TextBox  Grid.Column="1"
                                  Text="{Binding AddCommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                  BorderThickness="0,1,0,0" BorderBrush="{StaticResource colorInstagramGray}"
                                  Height="30" Margin="3,0,0,0" 
                                  HorizontalAlignment="Stretch"
                                  FontSize="14" TextElement.Foreground="{StaticResource colorInstagramGray}"
                                  GotMouseCapture="TextBox_GotMouseCapture">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding OnCommandFromView}" CommandParameter="ADDComment" />
                                <!--<MouseBinding Gesture="LeftClick" Command="{Binding OnCommandFromView}" CommandParameter="Clicked" />-->
                            </TextBox.InputBindings>
                        </TextBox>    
                    </Grid>      
                </Grid>
           </DataTemplate>

            <DataTemplate x:Key="dtUserAll">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" SharedSizeGroup="Foo" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Image Source="{Binding Path=ProfilePicture, Converter={StaticResource linktoimageconv}}"
                                        Margin="5"
                                        Stretch="Fill"
                                        Width="35" Height="35" 
                                        VerticalAlignment="Top" HorizontalAlignment="Center"/>
                        <Button Grid.Row="1" 
                                VerticalAlignment="Top"
                                IsEnabled="{Binding Relationship, Converter={StaticResource relationToEnabledConv}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Relationship, Converter={StaticResource relationToText}}" 
                                           Margin="1" VerticalAlignment="Center" />
                                <Image Source="{Binding Relationship, Converter={StaticResource relationToImage}}"
                                       Width="18" Height="18" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Stretch="Fill" /> 
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="5" Grid.Column="1" Grid.RowSpan="2">
                            <TextBox Text="{Binding Username}" IsReadOnly="True"  BorderThickness="0" Background="Transparent" />
                            <TextBox Text="{Binding Id}"       IsReadOnly="True"  BorderThickness="0" Background="Transparent" />
                            <TextBox Text="{Binding FullName}" IsReadOnly="True"  BorderThickness="0" Background="Transparent" />
                            <TextBox Text="{Binding Website}"  IsReadOnly="True"  BorderThickness="0" Background="Transparent" />
                            <TextBlock TextWrapping="Wrap" ToolTip="{Binding Bio}">
                            <Run Text="Bio: " />
                            <Run Text="{Binding Bio}"  />
                            </TextBlock>
                            <TextBlock>
                            <Run Text="Followed By: " />
                            <Run Text="{Binding Counts.FollowedBy}" />
                            </TextBlock>
                            <TextBlock>
                            <Run Text="Follows: " />
                            <Run Text="{Binding Counts.Follows}" />
                            </TextBlock>
                            <TextBlock>
                            <Run Text="Media: " />
                            <Run Text="{Binding Counts.Media}" />
                            </TextBlock>
                        </StackPanel>
                        

                    </Grid>

                    <WrapPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" Margin="5">
                        <Button Content="Load Media" 
                                Margin="5"
                                Visibility="{Binding MediaRecent, Converter={StaticResource emptyListToVisibleConv}}"
                                Command="{Binding OnCommandFromView}" CommandParameter="LOADMEDIA" />

                        <!--<Button Content="Load Folowing" 
                                Margin="5"
                                Visibility="{Binding Folowing, Converter={StaticResource emptyListToVisibleConv}}"
                                Command="{Binding OnCommandFromView}" CommandParameter="LOADFolowing" />

                        <Button Content="Load Followers" 
                                Margin="5"
                                Visibility="{Binding Folowers, Converter={StaticResource emptyListToVisibleConv}}"
                                Command="{Binding OnCommandFromView}" CommandParameter="LOADFollowers" />-->
                    </WrapPanel>

                    <ListView ItemsSource="{Binding MediaRecent}"
                                ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                                ItemTemplate="{StaticResource dtMedia}"
                                Grid.Row="2" Grid.ColumnSpan="2" 
                                Name="lv"
                                BorderThickness="0"
                                Margin="5"
                                Background="Transparent">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>

                    <!--<ListView ItemsSource="{Binding Folowing}"
                              ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                              ItemTemplate="{DynamicResource dtUserAll}"
                              Grid.Row="3" Grid.ColumnSpan="2"
                              BorderThickness="0"
                              Background="Transparent"
                              PreviewMouseWheel="lv_PreviewMouseWheel">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>

                    <ListView ItemsSource="{Binding Folowers}"
                              ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                              ItemTemplate="{DynamicResource dtUserAll}"
                              Grid.Row="4" Grid.ColumnSpan="2"
                              BorderThickness="0"
                              Background="Transparent"
                              PreviewMouseWheel="lv_PreviewMouseWheel">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>-->
                </Grid>
            </DataTemplate>
            
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="#fafafa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
         </Grid.RowDefinitions>

        <!--<Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>-->
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" Height="23"
                    Visibility="{Binding Source={x:Static mvm:InstaVM.Instance},
                                         Path=User,
                                         Converter={StaticResource nulltovisConv}}"
                    Command="{Binding Source={x:Static mvm:InstaVM.Instance}, Path=OnCommandFromView}" CommandParameter="LOGIN">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Login" VerticalAlignment="Center" />
                    <Image Source="/GoViral;component/Images/ic_person_black_24dp_2x.png" />
                </StackPanel>
            </Button>

        <local:InstaUserUserControl HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0"
                                        Visibility="{Binding Source={x:Static mvm:InstaVM.Instance},
                                                             Path=User,
                                                             Converter={StaticResource nulltovisConv},  
                                                             ConverterParameter=NOT}" />
        <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Inst·EO"
				    HorizontalAlignment="Center"
				    FontWeight="Medium"
				    FontSize="30"
				    Foreground="{StaticResource colorInstagram}" />
                <TextBlock Text="1.Select search opions 2.Enter A Tag or comma seperated Tags 3.Click logo or press Enter to search." Foreground="{StaticResource colorInstagramGray}" />
            </StackPanel>
        <!--</Grid>-->
        <DockPanel Grid.Row="1" Margin="10" HorizontalAlignment="Stretch">
            <CheckBox Content="Users" IsChecked="{Binding CheckedSearchUsers}" Margin="3" />
            <CheckBox Content="Tags" IsChecked="{Binding CheckedSearchTags}" Margin="3" />
            <CheckBox Content="Media" IsChecked="{Binding CheckedSearchMedia}" Margin="3,3,5,3" />
            <Button DockPanel.Dock="Right" Margin="15,0,0,0" Height="25" Width="45" 
                    Command="{Binding OnCommandFromView}" CommandParameter="SEARCH">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="TextElement.FontWeight" Value="Medium" />
                        <Setter Property="TextElement.Foreground" Value="White" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border BorderThickness="1" UseLayoutRounding="False" BorderBrush="WhiteSmoke" x:Name="bd">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/GoViral;component/Images/instagram-logo.png" Stretch="UniformToFill"  />
                                            <!--<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <LinearGradientBrush.GradientStops>
                                                    <GradientStopCollection>
                                                        <GradientStop Color="#ff3939"  Offset="0"  />
                                                        <GradientStop Color="#ff3939"  Offset="0.1"  />
                                                        <GradientStop Color="#ff3939"  Offset="0.2"  />
                                                        <GradientStop Color="#fed049"  Offset="0.3" />
                                                        <GradientStop Color="#fed049"  Offset="0.4" />
                                                        <GradientStop Color="#fed049"  Offset="0.5" />
                                                        <GradientStop Color="#10dd76"  Offset="0.6" />
                                                        <GradientStop Color="#10dd76"  Offset="0.7" />
                                                        <GradientStop Color="#5fccff"  Offset="0.8" />
                                                        <GradientStop Color="#5fccff"  Offset="0.9" />
                                                        <GradientStop Color="#5fccff"  Offset="1" />
                                                    </GradientStopCollection>
                                                </LinearGradientBrush.GradientStops>
                                            </LinearGradientBrush>-->
                                        </Border.Background>
                                        <ContentPresenter Content="{TemplateBinding Content}"
											VerticalAlignment="Center"
											HorizontalAlignment="Center" />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="TextElement.Foreground" Value="#895a4d" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="Gray" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <TextBox Text="{Binding KeyWords, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding OnCommandFromView}" CommandParameter="SEARCH" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid  Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource colorInstagram}">
                    <DockPanel>
                        <TextBlock Text="Users" Foreground="White" FontWeight="Medium" VerticalAlignment="Center" FontSize="15" Margin="3,0,0,0" />
                        <Button HorizontalAlignment="Right" Width="20" Height="20" Margin="3" ToolTip="Clear"
                                Command="{Binding OnCommandFromView}" CommandParameter="CLEARUSERS">
                            <Image Source="/GoViral;component/Images/ic_clear_black_24dp_2x.png" Stretch="Fill" />
                        </Button>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Name="svUsers" 
                              Margin="0,3,0,0">
                    <ListView ItemsSource="{Binding UserSearchResponse}"
                              ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                              ItemTemplate="{StaticResource dtUserAll}"
                              Grid.IsSharedSizeScope="True"
                              BorderThickness="0"
                              Background="Transparent"
                              PreviewMouseWheel="lv_PreviewMouseWheel">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource colorInstagram}">
                    <DockPanel>
                        <TextBlock Text="Tags" Foreground="White" FontWeight="Medium" VerticalAlignment="Center" FontSize="15" Margin="3,0,0,0" />
                        <Button HorizontalAlignment="Right" Width="20" Height="20" Margin="3" ToolTip="Clear"
                                Command="{Binding OnCommandFromView}" CommandParameter="CLEARTAGS">
                            <Image Source="/GoViral;component/Images/ic_clear_black_24dp_2x.png" Stretch="Fill" />
                        </Button>
                    </DockPanel>
                </Border>
                
            <ListView ItemsSource="{Binding TagsSearchResponse}"
                      ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                      BorderThickness="0"
                      Background="Transparent"
                      Grid.Row="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <StackPanel Margin="5" Grid.Column="1">
                                <TextBox Text="{Binding Name}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                                <TextBlock>
                                    <Run Text="Media Count: " />
                                    <Run Text="{Binding MediaCount}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </Grid>

            <Grid Grid.Column="3" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource colorInstagram}">
                    <DockPanel>
                        <TextBlock Text="Media" Foreground="White" FontWeight="Medium" VerticalAlignment="Center" FontSize="15" Margin="3,0,0,0" />
                        <Button HorizontalAlignment="Right" Width="20" Height="20" Margin="3" ToolTip="Clear"
                                Command="{Binding OnCommandFromView}" CommandParameter="CLEARMedia">
                            <Image Source="/GoViral;component/Images/ic_clear_black_24dp_2x.png" Stretch="Fill" />
                        </Button>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Name="svMedia" 
                              Margin="0,3,0,0">
                    <ListView ItemsSource="{Binding MediaSearchResponse}"
                              ItemContainerStyle="{StaticResource dtBaseListItemTemplate}"
                              ItemTemplate="{StaticResource dtMedia}"
                              PreviewMouseWheel="lv_PreviewMouseWheel"
                              BorderThickness="0"
                              Background="Transparent"
                              Grid.Row="1" Name="lv">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
