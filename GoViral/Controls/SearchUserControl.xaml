                              MaxHeight="{Binding ElementName=svLists,Path=ActualHeight,Converter={StaticResource mathConv}, ConverterParameter=M-M50}"
                              BorderThickness="0,0,0,0" 
                              PreviewMouseWheel="ListView_PreviewMouseWheel"
                              PreviewMouseDown="lvData_PreviewMouseDown"
                              MouseLeave="lvData_MouseLeave"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GroupsResult.data.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander ExpandDirection="Down" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Width="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M65}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Keyword}" HorizontalAlignment="Left" Foreground="#4c8cf5" />
                                            <TextBlock Text="{Binding GroupsResult.data.Count}" HorizontalAlignment="Right" Grid.Column="1" Foreground="#4c8cf5" />
                                        </Grid>
                                    </Expander.Header>
                                    <ListView ItemsSource="{Binding GroupsResult.data}"
                                              BorderThickness="0,0,0,0"
                                              Width="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M70}"
                                              ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Image Source="{Binding picture.data.url,IsAsync=True, Converter={StaticResource linktoimgcov}}"
                                                   Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,5,0" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding name}" FontWeight="Bold" Style="{StaticResource tbLinkStyle}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="privacy:" Width="85" />
                                                            <TextBlock Text="{Binding privacy}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="description:" Width="85" />
                                                            <TextBlock Text="{Binding description}" TextWrapping="Wrap" MaxHeight="150"
                                                                       MaxWidth="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M240}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="members:" Width="85" />
                                                            <TextBlock Text="{Binding members.summary.total_count}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Collapse" Name="miCollpse" Click="miCollpse_Click" />
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Name="grdEvents" Margin="15" Grid.Column="0" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Height="30" Background="#9196a1">
                        <TextBlock Text="Events" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0" HorizontalAlignment="Left" />
                    </Border>
                    <ListView Width="{Binding ElementName=uc,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M/M2M-M40}"
                              MaxHeight="{Binding ElementName=svLists,Path=ActualHeight,Converter={StaticResource mathConv}, ConverterParameter=M-M50}"
                              ItemsSource="{Binding SearchResultsWithKwList.SearchResultsList}"
                              BorderThickness="0,0,0,0"
                              PreviewMouseWheel="ListView_PreviewMouseWheel"
                              PreviewMouseDown="lvData_PreviewMouseDown"
                              MouseLeave="lvData_MouseLeave"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EventsResult.data.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander ExpandDirection="Down" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Width="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M65}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Keyword}" HorizontalAlignment="Left" Foreground="#4c8cf5" />
                                            <TextBlock Text="{Binding EventsResult.data.Count}" HorizontalAlignment="Right" Grid.Column="1" Foreground="#4c8cf5" />
                                        </Grid>
                                    </Expander.Header>
                                    <ListView ItemsSource="{Binding EventsResult.data}"
                                              BorderThickness="0,0,0,0"
                                              Width="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M70}"
                                              ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Image Source="{Binding picture.data.url,IsAsync=True, Converter={StaticResource linktoimgcov}}"
                                                   Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,5,0" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding name}" FontWeight="Bold" Style="{StaticResource tbLinkStyle}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="description:" Width="85" />
                                                            <TextBlock Text="{Binding description}" TextWrapping="Wrap" MaxHeight="150"
                                                                       MaxWidth="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M240}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="start time:" Width="85" />
                                                            <TextBlock Text="{Binding start_time}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="interested:" Width="85" />
                                                            <TextBlock Text="{Binding interested.summary.count}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="invited:" Width="85" />
                                                            <TextBlock Text="{Binding invited.summary.count}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="going:" Width="85" />
                                                            <TextBlock Text="{Binding invited.summary.attending_count}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="maybe:" Width="85" />
                                                            <TextBlock Text="{Binding invited.summary.maybe_count}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="declined:" Width="85" />
                                                            <TextBlock Text="{Binding invited.summary.declined_count}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="noreply:" Width="85" />
                                                            <TextBlock Text="{Binding invited.summary.noreply_count}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Collapse" Name="miCollpse" Click="miCollpse_Click" />
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Name="grdPlaces" Margin="15" Grid.Column="1" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Height="30" Background="#9196a1">
                        <TextBlock Text="Places" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0" HorizontalAlignment="Left" />
                    </Border>
                    <ListView ItemsSource="{Binding SearchResultsWithKwList.SearchResultsList}"
                              Width="{Binding ElementName=uc,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M/M2M-M40}"
                              MaxHeight="{Binding ElementName=svLists,Path=ActualHeight,Converter={StaticResource mathConv}, ConverterParameter=M-M50}"
                              BorderThickness="0,0,0,0" 
                              PreviewMouseWheel="ListView_PreviewMouseWheel"
                              PreviewMouseDown="lvData_PreviewMouseDown"
                              MouseLeave="lvData_MouseLeave"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacesResult.data.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander ExpandDirection="Down" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Width="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M65}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Keyword}" HorizontalAlignment="Left" Foreground="#4c8cf5" />
                                            <TextBlock Text="{Binding PlacesResult.data.Count}" HorizontalAlignment="Right" Grid.Column="1" Foreground="#4c8cf5" />
                                        </Grid>
                                    </Expander.Header>
                                    <ListView ItemsSource="{Binding PlacesResult.data}"
                                              BorderThickness="0,0,0,0" 
                                              Width="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M70}"
                                              ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Image Source="{Binding picture.data.url,IsAsync=True, Converter={StaticResource linktoimgcov}}"
                                                   Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,5,0" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding name}" FontWeight="Bold" Style="{StaticResource tbLinkStyle}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="category:" Width="85" />
                                                            <TextBlock Text="{Binding category}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="about:" Width="85" />
                                                            <TextBlock Text="{Binding about}" TextWrapping="Wrap" MaxHeight="150"
                                                                       MaxWidth="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M240}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="description:" Width="85" />
                                                            <TextBlock Text="{Binding description}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="founded:" Width="85" />
                                                            <TextBlock Text="{Binding founded}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="can post:" Width="85" />
                                                            <TextBlock Text="{Binding can_post}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="community page:" Width="85" />
                                                            <TextBlock Text="{Binding is_community_page}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="permanently closed:" Width="85" />
                                                            <TextBlock Text="{Binding is_permanently_closed}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="published:" Width="85" />
                                                            <TextBlock Text="{Binding is_published}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="unclaimed:" Width="85" />
                                                            <TextBlock Text="{Binding is_unclaimed}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="verified:" Width="85" />
                                                            <TextBlock Text="{Binding is_verified}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="website:" Width="85" />
                                                            <TextBlock Text="{Binding website}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="country:" Width="85" />
                                                            <TextBlock Text="{Binding country}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="city:" Width="85" />
                                                            <TextBlock Text="{Binding city}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="talking about:" Width="85" />
                                                            <TextBlock Text="{Binding talking_about_count}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="likes:" Width="85" />
                                                            <TextBlock Text="{Binding likes}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Collapse" Name="miCollpse" Click="miCollpse_Click" />
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Name="grdPeople" Margin="15" Grid.Column="0" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Height="30" Background="#9196a1">
                        <TextBlock Text="People" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0" HorizontalAlignment="Left" />
                    </Border>
                    <ListView ItemsSource="{Binding SearchResultsWithKwList.SearchResultsList}"
                              Width="{Binding ElementName=uc,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M/M2M-M40}"
                              MaxHeight="{Binding ElementName=svLists,Path=ActualHeight,Converter={StaticResource mathConv}, ConverterParameter=M-M50}"
                              BorderThickness="0,0,0,0" 
                              PreviewMouseWheel="ListView_PreviewMouseWheel"
                              PreviewMouseDown="lvData_PreviewMouseDown"
                              MouseLeave="lvData_MouseLeave"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PersonsResult.data.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander ExpandDirection="Down" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Width="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M65}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Keyword}" HorizontalAlignment="Left" Foreground="#4c8cf5" />
                                            <TextBlock Text="{Binding PersonsResult.data.Count}" HorizontalAlignment="Right" Grid.Column="1" Foreground="#4c8cf5" />
                                        </Grid>
                                    </Expander.Header>
                                    <ListView ItemsSource="{Binding PersonsResult.data}"
                                              BorderThickness="0,0,0,0" 
                                              Width="{Binding ElementName=lvData,Path=ActualWidth,Converter={StaticResource mathConv}, ConverterParameter=M-M70}"
                                              ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Image Source="{Binding picture.data.url,IsAsync=True, Converter={StaticResource linktoimgcov}}"
                                                   Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,5,0" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding name}" FontWeight="Bold" Style="{StaticResource tbLinkStyle}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="privacy:" Width="85" />
                                                            <TextBlock Text="{Binding privacy}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Collapse" Name="miCollpse" Click="miCollpse_Click" />
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
