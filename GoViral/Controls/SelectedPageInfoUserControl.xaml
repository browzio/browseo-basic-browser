<UserControl x:Class="GoViral.Controls.SelectedPageInfoUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoViral.Controls"
             xmlns:converter="clr-namespace:GoViral.Converters"
             xmlns:gloableConverter="clr-namespace:Organiser.Common.Converters;assembly=Organiser.Common"
             xmlns:controls="clr-namespace:Organiser.Common.Controlls;assembly=Organiser.Common"
             xmlns:localControls="clr-namespace:GoViral.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:LinkToImageConverter x:Key="linktoimgcov" />
            <converter:PhotoLinkToImageConverter x:Key="photolinktoimgcov" />
            <converter:PostIdToUrlConverter x:Key="idtolinkconv" />
            <converter:LinkCleanerConverter x:Key="linkCleanerconv" />
            <converter:PhotosVidsCountToTextConverter x:Key="mediaCountToTextconv" />
            <converter:PageTypeFromUrlToVisibleConverter x:Key="pageTypeToVisConv" />
            <gloableConverter:EmptyTextToVisibilityConverter x:Key="emptyTextToVisconv" />

            <DataTemplate x:Key="ListviewFeedOrPostsItemTemplate">
                <StackPanel Name="spPosts">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="MinWidth" Value="80" />
                            <Setter Property="MaxWidth" Value="390" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </StackPanel.Resources>

                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="caption:" />
                        <TextBlock Text="{Binding caption}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Width="70" Text="message:" />
                        <TextBlock Text="{Binding message}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Width="70" Text="type:" />
                        <TextBlock Text="{Binding type}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="picture:" />
                        <Image MaxWidth="150" MaxHeight="150" Source="{Binding picture,IsAsync=True, Converter={StaticResource linktoimgcov}}">
                            <Image.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Download" Name="fbPostImages" Click="fbPostImages_Click" Tag="{Binding full_picture}" />
                                </ContextMenu>
                            </Image.ContextMenu>
                        </Image>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="post url:" />
                        <TextBlock PreviewMouseDown="tbPostLink_PreviewMouseDown"
                                   TextWrapping="NoWrap"
                                   Width="388"
                                   Name="tbPostUrl"
                                   Style="{StaticResource tbLinkStyle}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource idtolinkconv}" UpdateSourceTrigger="PropertyChanged">
                                    <Binding Path="id" />
                                    <Binding Path="DataContext.SelectedFolder.SelectedPage.Url" ElementName="lvPosts"  />
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Name="miCopyLink" Click="miCopyLink_Click" Tag="{Binding ElementName=tbPostUrl, Path=Text}">
                                    </MenuItem>
                                    <MenuItem Header="Sync" Name="miSync" Click="miCopyLink_Click" Tag="{Binding ElementName=tbPostUrl, Path=Text}">
                                    </MenuItem>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="link:" />
                        <TextBlock Text="{Binding link, Converter={StaticResource linkCleanerconv}}" Name="tbPostLink"
                                   PreviewMouseDown="tbPostLink_PreviewMouseDown"
                                   TextWrapping="NoWrap" Width="388"
                                   Style="{StaticResource tbLinkStyle}">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Click="miCopyLink_Click" Tag="{Binding ElementName=tbPostLink, Path=Text}" />
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Width="70" Text="description:" />
                        <TextBlock Text="{Binding description}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Width="70" Text="expired:" />
                        <TextBlock Text="{Binding is_expired}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Width="70" Text="hidden:" />
                        <TextBlock Text="{Binding is_hidden}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Width="70" Text="published:" />
                        <TextBlock Text="{Binding is_published}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="updated time:" />
                        <TextBlock Text="{Binding updated_time}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="shares:" />
                        <TextBlock Text="{Binding shares.count}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="comments:" />
                        <TextBlock Text="{Binding comments.summary.total_count}" />
                    </StackPanel>
                    <StackPanel Margin="4" Orientation="Horizontal">
                        <TextBlock Text="Likes:" />
                        <TextBlock Text="{Binding likes.summary.total_count}" />
                    </StackPanel>
                    <Button Content="Add To Sorter" Name="cbSync" Click="cbSync_Click" Margin="5" HorizontalAlignment="Left" Width="100">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource idtolinkconv}" UpdateSourceTrigger="PropertyChanged">
                                <Binding Path="id" />
                                <Binding Path="DataContext.SelectedFolder.SelectedPageFBGraphData.link" ElementName="lvPosts"  />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </DataTemplate>
            <ContextMenu x:Key="CMLVFBData">
                <MenuItem Header="Order By Likes" Command="{Binding CTMenuClick}" CommandParameter="ORDER_PostsByLikes" />
                <MenuItem Header="Order By Shares" Command="{Binding CTMenuClick}" CommandParameter="ORDER_PostsByShares" />
                <MenuItem Header="Order By Comments" Command="{Binding CTMenuClick}" CommandParameter="ORDER_PostsByComments" />
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="4">
            <TextBlock Text="{Binding SelectedFolder.SelectedPageName, Converter={StaticResource linkCleanerconv}}" FontWeight="Bold" FontSize="14.667" MaxWidth="380" />
        </StackPanel>

        <ScrollViewer x:Name="MyScrollViewerFBContent"  
                        Grid.Row="1"
                        Width="500"
                        Background="WhiteSmoke"
                        HorizontalScrollBarVisibility="Disabled" 
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Background="WhiteSmoke">
                <!--#region header-->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFolder}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="MinWidth" Value="80" />
                            <Setter Property="MaxWidth" Value="390" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </StackPanel.Resources>
                    <StackPanel Orientation="Horizontal" Margin="4" Name="url">
                        <TextBlock Text="link:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPage.Url, Converter={StaticResource linkCleanerconv}}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.website, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="website:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.website}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.category, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="category:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.category}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.privacy, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="privacy:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.privacy}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.founded, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="founded:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.founded}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.updated_time, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="updated time:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.updated_time}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.start_time, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="start time:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.start_time}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.timezone, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="timezone:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.timezone}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.about, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="about:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.about}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.description, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="description:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.description}" MaxHeight="300" />
                    </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.name, Converter={StaticResource emptyTextToVisconv}}">
                    <TextBlock Text="about:" />
                    <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.name}" MaxHeight="300" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.picture, Converter={StaticResource emptyTextToVisconv}}">
                    <TextBlock Text="picture:" />
                    <Image MaxWidth="150" MaxHeight="150" Source="{Binding SelectedFolder.SelectedPageFBGraphData.picture,IsAsync=True, Converter={StaticResource linktoimgcov}}">
                        <Image.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Download" Name="fbPostImages" Click="fbPostImages_Click" Tag="{Binding full_picture}" />
                            </ContextMenu>
                        </Image.ContextMenu>
                    </Image>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.can_post, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="can post:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.can_post}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.is_community_page, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="community:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.is_community_page}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.is_permanently_closed, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="closed:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.is_permanently_closed}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.is_published, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="published:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.is_published}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.is_unclaimed, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="unclaimed:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.is_unclaimed}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.is_verified, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="verified:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.is_verified}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.talking_about_count, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="talking about:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.talking_about_count}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.likes, Converter={StaticResource emptyTextToVisconv}}">
                        <TextBlock Text="likes:" />
                        <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.likes}" />
                    </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.length, Converter={StaticResource emptyTextToVisconv}}">
                    <TextBlock Text="length:" />
                    <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.length}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.views, Converter={StaticResource emptyTextToVisconv}}">
                    <TextBlock Text="views:" />
                    <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.views}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="4">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.comments}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.comments.data}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.comments.data.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="comments:" />
                    <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.comments.summary.total_count}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.embed_html, Converter={StaticResource emptyTextToVisconv}}">
                    <TextBlock Text="embed_html:" />
                    <TextBox IsReadOnly="True" Style="{StaticResource TextboxGray}" Text="{Binding SelectedFolder.SelectedPageFBGraphData.embed_html, Converter={StaticResource linkCleanerconv}}" />
                </StackPanel>

                <Button Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.source, Converter={StaticResource emptyTextToVisconv}}" 
                        Tag="{Binding SelectedFolder.SelectedPageFBGraphData.source}" Content="Download" Name="btnDownload" Click="btnDownload_Click" />

                <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=SelectedFolder.SelectedPageFBGraphData.interested}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=SelectedFolder.SelectedPageFBGraphData.interested.summary}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.interested.summary.count, Converter={StaticResource emptyTextToVisconv}}">
                            <TextBlock Text="interested:" />
                            <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.interested.summary.count}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=SelectedFolder.SelectedPageFBGraphData.invited}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=SelectedFolder.SelectedPageFBGraphData.invited.summary}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="4" Visibility="{Binding Path=SelectedFolder.SelectedPageFBGraphData.invited.summary.count, Converter={StaticResource emptyTextToVisconv}}">
                            <TextBlock Text="invited:" />
                            <TextBlock Text="{Binding SelectedFolder.SelectedPageFBGraphData.invited.summary.count}" />
                        </StackPanel>
                    </StackPanel>

                <!--#endregion-->

                <Expander ExpandDirection="Down" Name="ExPhotos" Visibility="{Binding Path=SelectedFolder.SelectedPage.Url,Converter={StaticResource pageTypeToVisConv}}">
                    <Expander.Header>
                        <TextBlock Text="Photos" Foreground="#ffce44" />
                    </Expander.Header>
                    <StackPanel>
                        <ListView ItemsSource="{Binding SelectedFolder.SelectedPageFBGraphData.photos.data}" Name="lvPics"
                                    PreviewMouseWheel="lvVideos_PreviewMouseWheel"
                                    MouseLeave="lvVideos_MouseLeave"
                                    MouseEnter="lvVideos_MouseEnter">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="MinWidth" Value="80" />
                                                <Setter Property="MaxWidth" Value="390" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <Image Name="imgPics" Width="150" Height="150" Stretch="None" PreviewMouseDown="imgVideo_PreviewMouseDown"
                                                                                    Tag="{Binding link}" 
                                                                                    Source="{Binding picture,IsAsync=True, Converter={StaticResource photolinktoimgcov}}">
                                            <Image.ToolTip>
                                                <ToolTip ToolTipService.ShowDuration="15000">
                                                    <StackPanel>
                                                        <StackPanel.Resources>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="MinWidth" Value="80" />
                                                                <Setter Property="MaxWidth" Value="390" />
                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="updated time:" />
                                                            <TextBlock Text="{Binding updated_time}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="comments:" />
                                                            <TextBlock Text="{Binding comments.summary.total_count}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="likes:" />
                                                            <TextBlock Text="{Binding likes.summary.total_count}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Image.ToolTip>
                                            <Image.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Name="Copy" Header="Copy Link" Tag="{Binding link}" Click="miVids_Click" />
                                                    <MenuItem Name="Download" Header="Download Image" Tag="{Binding images}" Click="miPhotosPhotoDownload" />
                                                    <Separator Margin="-30,0,0,0" />
                                                    <MenuItem Header="Order By Likes" Click="MenuItem_Click" Name="ORDERPICS_LIKES" />
                                                    <MenuItem Header="Order By Comments" Click="MenuItem_Click" Name="ORDERPICS_COMMENTS" />
                                                </ContextMenu>
                                            </Image.ContextMenu>
                                        </Image>
                                        <StackPanel Orientation="Horizontal" Margin="1">
                                            <TextBlock Text="comments:" />
                                            <TextBlock Text="{Binding comments.summary.total_count}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="1">
                                            <TextBlock Text="likes:" />
                                            <TextBlock Text="{Binding likes.summary.total_count}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Tag="{Binding SelectedFolder}" 
                                    Style="{StaticResource tbLinkStyle}"
                                    HorizontalAlignment="Right" Name="tbLoadMorePhotos" PreviewMouseUp="tbLoadMorePhotos_PreviewMouseUp">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource mediaCountToTextconv}" UpdateSourceTrigger="PropertyChanged">
                                    <Binding Path="SelectedFolder.SelectedPage.Url" />
                                    <Binding Path="SelectedFolder.SelectedPageFBGraphData.photos.data" />
                                    <Binding Path="SelectedFolder.SelectedPageFBGraphData.photos.data.Count" />
                                    <Binding Path="SelectedFolder.SelectedPageFBGraphData.photos.paging" />
                                    <Binding Path="Binding SelectedFolder.SelectedPageFBGraphData.photos.paging.next" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <Expander ExpandDirection="Down" Name="ExVideos" Visibility="{Binding Path=SelectedFolder.SelectedPage.Url,Converter={StaticResource pageTypeToVisConv}}">
                    <Expander.Header>
                        <TextBlock Text="Videos" Foreground="#ffce44" />
                    </Expander.Header>
                    <StackPanel>
                        <ListView ItemsSource="{Binding SelectedFolder.SelectedPageFBGraphData.videos.data}" Name="lvVideos"
                                                PreviewMouseWheel="lvVideos_PreviewMouseWheel"
                                                MouseLeave="lvVideos_MouseLeave"
                                                MouseEnter="lvVideos_MouseEnter">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="MinWidth" Value="80" />
                                                <Setter Property="MaxWidth" Value="390" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <Image Name="imgVideo" Width="150" Height="150" Stretch="None" PreviewMouseDown="imgVideo_PreviewMouseDown"
                                                Tag="{Binding permalink_url}" 
                                                Source="{Binding picture,IsAsync=True, Converter={StaticResource linktoimgcov}}">
                                            <Image.ToolTip>
                                                <ToolTip ToolTipService.ShowDuration="15000">
                                                    <StackPanel>
                                                        <StackPanel.Resources>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="MinWidth" Value="80" />
                                                                <Setter Property="MaxWidth" Value="390" />
                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="description:" />
                                                            <TextBlock Text="{Binding description}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="length:" />
                                                            <TextBlock Text="{Binding length}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="updated time:" />
                                                            <TextBlock Text="{Binding updated_time}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="comments:" />
                                                            <TextBlock Text="{Binding comments.summary.total_count}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="likes:" />
                                                            <TextBlock Text="{Binding likes.summary.total_count}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="views:" />
                                                            <TextBlock Text="{Binding views}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Image.ToolTip>
                                            <Image.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Name="Copy" Header="Copy Link" Tag="{Binding permalink_url}" Click="miVids_Click" />
                                                    <MenuItem Name="Download" Header="Download Video" Tag="{Binding source}" Click="miVids_Click" />
                                                    <Separator Margin="-30,0,0,0" />
                                                    <MenuItem Header="Order By Likes" Click="MenuItem_Click" Name="ORDERVIDS_LIKES" />
                                                    <MenuItem Header="Order By Comments" Click="MenuItem_Click" Name="OORDERVIDS_COMMENTS" />
                                                    <MenuItem Header="Order By Views" Click="MenuItem_Click" Name="OORDERVIDS_VIEWS" />
                                                </ContextMenu>
                                            </Image.ContextMenu>
                                        </Image>
                                        <StackPanel Orientation="Horizontal" Margin="1">
                                            <TextBlock Text="comments:" />
                                            <TextBlock Text="{Binding comments.summary.total_count}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="1">
                                            <TextBlock Text="likes:" />
                                            <TextBlock Text="{Binding likes.summary.total_count}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="1">
                                            <TextBlock Text="views:" />
                                            <TextBlock Text="{Binding views}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Tag="{Binding SelectedFolder}"
                                    Style="{StaticResource tbLinkStyle}" 
                                    HorizontalAlignment="Right" Name="tbLoadMoreVideos" PreviewMouseUp="tbLoadMoreVideos_PreviewMouseUp">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource mediaCountToTextconv}" UpdateSourceTrigger="PropertyChanged">
                                    <Binding Path="SelectedFolder.SelectedPage.Url" />
                                    <Binding Path="SelectedFolder.SelectedPageFBGraphData.videos.data" />
                                    <Binding Path="SelectedFolder.SelectedPageFBGraphData.videos.data.Count" />
                                    <Binding Path="SelectedFolder.SelectedPageFBGraphData.videos.paging" />
                                    <Binding Path="Binding SelectedFolder.SelectedPageFBGraphData.videos.paging.next" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Expander> 
                
                <Expander ExpandDirection="Down" Name="ExPosts">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.posts}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.posts.data}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.posts.data.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="Posts" Foreground="#ffce44" />
                    </Expander.Header>
                    <StackPanel Name="spSelectedFBDataPosts" PreviewMouseWheel="spSelectedFBData_PreviewMouseWheel">
                        <ListView ItemsSource="{Binding SelectedFolder.SelectedPageFBGraphData.posts.data}" 
                              ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                              ItemTemplate="{StaticResource ListviewFeedOrPostsItemTemplate}"
                              ContextMenu="{StaticResource CMLVFBData}"
                              Name="lvPosts"
                              BorderThickness="0,0,0,0" />
                    </StackPanel>
                </Expander>
                
                <Expander ExpandDirection="Down" Name="ExFeed">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.feed}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.feed.data}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.feed.data.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="Feed" Foreground="#ffce44" />
                    </Expander.Header>
                    <StackPanel Name="spSelectedFBDataFeed" PreviewMouseWheel="spSelectedFBData_PreviewMouseWheel">
                        <ListView ItemsSource="{Binding SelectedFolder.SelectedPageFBGraphData.feed.data}"
                              ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                              ItemTemplate="{StaticResource ListviewFeedOrPostsItemTemplate}"
                              ContextMenu="{StaticResource CMLVFBData}"
                              Name="lvFeed"
                              BorderThickness="0,0,0,0" />
                    </StackPanel>
                </Expander>

                <Expander ExpandDirection="Down" Name="ExComments">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.comments}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.comments.data}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedFolder.SelectedPageFBGraphData.comments.data.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="Comments" Foreground="#ffce44" />
                    </Expander.Header>
                    <StackPanel PreviewMouseWheel="spSelectedFBData_PreviewMouseWheel">
                        <ListView ItemsSource="{Binding SelectedFolder.SelectedPageFBGraphData.comments.data}"
                              ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                              BorderThickness="0,0,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="4">
                                            <TextBlock Text="created_time:" Width="80" />
                                            <TextBlock Text="{Binding created_time}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="4">
                                            <TextBlock Text="message:" Width="80" />
                                            <TextBlock Text="{Binding message}" TextWrapping="Wrap" MaxWidth="420" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
