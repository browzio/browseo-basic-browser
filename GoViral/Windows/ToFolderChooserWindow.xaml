<Window x:Class="GoViral.Windows.ToFolderChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoViral.Windows"
        mc:Ignorable="d"
        Title="Select Options" SizeToContent="Height" Width="350" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown" ResizeMode="NoResize" Icon="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel>
        <DockPanel Margin="3" Name="dpName">
            <TextBlock Text="Name:" Width="40" VerticalAlignment="Center" />
            <TextBox Name="tbName" Margin="3" />
        </DockPanel>
        <DockPanel Margin="3" Name="dpUrl">
            <TextBlock Text="Url:" Width="40" VerticalAlignment="Center" />
            <TextBox Name="tbUrl" Margin="3" />
        </DockPanel>
        <ComboBox DisplayMemberPath="FolderTitle" SelectedIndex="{Binding SIFolders}" ItemsSource="{Binding Folders}" />
        <Button Content="OK" Style="{StaticResource FlatbtnStyle}" Click="Button_Click" Margin="3,10,3,3" />
    </StackPanel>
</Window>
