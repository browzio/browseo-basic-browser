                                    </DockPanel.Style>-->
                                    <TextBlock DockPanel.Dock="Left" Text="Starting From" Width="80" />
                                    <TextBox DockPanel.Dock="Right" Text="{Binding StartingFrom}" />
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
