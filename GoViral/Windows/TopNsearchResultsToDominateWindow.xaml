    </Window.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <RadioButton Content="Top Results" GroupName="rb" IsChecked="True" Margin="3" Name="rbTopResults" />
            <RadioButton Content="Bottom Results" GroupName="rb" Margin="3" Name="rbBottom" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderThickness="0,0.5,0,0" Margin="1" BorderBrush="Black" />
            <CheckBox Grid.Row="1" IsChecked="{Binding ThreeStateFilterchecked}" />
            <ListView Grid.Row="2" 
                      Background="WhiteSmoke"
                      Name="lvAvailKws" 
                      BorderThickness="0,0,0,0"
                      ItemsSource="{Binding SearchResultsForFilter}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Keyword}" IsChecked="{Binding IsChecked}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
            <StackPanel Grid.Row="2" HorizontalAlignment="Left">
            <DockPanel Margin="3" Name="dpName">
                <TextBlock Text="Max:" Width="40" VerticalAlignment="Center" />
                <TextBox Name="tbMax" Margin="3" Width="40" HorizontalAlignment="Left" Text="0" />
            </DockPanel>

            <GroupBox Header="Filter" Width="250" HorizontalAlignment="Left">
                <ListView ItemsSource="{Binding FilterOptionsList}"
                          Background="WhiteSmoke"
                          BorderThickness="0,0,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" />
