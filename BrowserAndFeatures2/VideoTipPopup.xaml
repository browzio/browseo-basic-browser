<UserControl x:Class="BrowserAndFeatures2.VideoTipPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrowserAndFeatures2"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920"
             SizeChanged="UserControl_SizeChanged">
    <Grid>
        <Grid Background="Black">
        </Grid>
        <Rectangle Name="rctangle"
                   Grid.RowSpan="2">
            <Rectangle.Fill>
                <VisualBrush TileMode="Tile"
                             Viewport="0,0,150,150"
                             ViewportUnits="Absolute"
                             Opacity="0.05">
                    <VisualBrush.Visual>
                        <Border BorderBrush="#FFF0F0F0"
                                BorderThickness="4">
                            <StackPanel Orientation="Vertical">
                                <TextBlock FontWeight="Bold"
                                           Margin="0,0,0,10"
                                           FontSize="16"
                                           Text="Brow·SEO" />
                                <Image Source="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico"
                                       Stretch="Fill"
                                       Margin="0,0,0,-80"
                                       Width="45"
                                       Height="45" />
                            </StackPanel>
                        </Border>
                    </VisualBrush.Visual>
                    <VisualBrush.Transform>
                        <RotateTransform Angle="-22.5" />
                    </VisualBrush.Transform>
                </VisualBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Name="grdBrowser"
             Height="480"
              Width="854">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <WebBrowser Name="Webview"
                        x:FieldModifier="public" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

                <Button Content="Click Here to Discover BrowSEO"
                    HorizontalAlignment="Left"
                    Margin="3"
                    Name="btnOpenInBrowser"
                    Click="btnOpenInBrowser_Click" />

            <!--<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Grid.Column="1"
                        Margin="3">
                <CheckBox Content="Dont Show Again"
                          Margin="3"
                          Name="cbDontShow"
                          x:FieldModifier="public" />
                <Button Content="Close"
                        Click="btnClose_Click"
                        Grid.Column="1"
                        Margin="3"
                        Name="btnClose" />
            </StackPanel>-->
        </Grid>
    </Grid>
    </Grid>
</UserControl>
