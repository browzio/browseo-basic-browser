<UserControl x:Class="NichResearch.Controls.SocialMentionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        
        <ListView IsSynchronizedWithCurrentItem="True" 
                  MaxHeight="600"
                  MaxWidth="850"
                  ItemsSource="{Binding Path=SocialmentionResultsList}" 
                  SelectedIndex="{Binding SISocialmentionResultsList, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="IconSentiment">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Background="WhiteSmoke" Orientation="Horizontal">
                                    <Image Source="{Binding IconSentiment}" Width="20" Height="20" Stretch="UniformToFill" />
                                    <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="UniformToFill" />
                                    <StackPanel>
                                        <TextBox Background="Transparent"
                                         BorderThickness="0"
                                         Text="{Binding Title, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Foreground="Blue" />
                                        <TextBox Background="Transparent"
                                         BorderThickness="0"
                                         Text="{Binding Link, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Foreground="Green" />
                                        <TextBox Background="Transparent"
                                         BorderThickness="0"
                                         Text="{Binding Description, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Foreground="Black" />
                                        <TextBox Background="Transparent"
                                         BorderThickness="0"
                                         Text="{Binding Info, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Foreground="Gray" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding CommandType}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToWindow}" CommandParameter="social" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListView>
    </Grid>
</UserControl>

