<UserControl x:Class="zFirefoxXulBrowser.Controls.FFXulBrowserUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:zFirefoxXulBrowser.Controls"
             xmlns:viewModel="clr-namespace:zFirefoxXulBrowser.ViewModels"
             xmlns:browserCommonViews="clr-namespace:Browser.Common.Views;assembly=Browser.Common"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <Grid>
        <ContentPresenter Content="{Binding WebBrowserHost}"
                          Name="host"
                          Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
