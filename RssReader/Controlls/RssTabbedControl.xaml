<UserControl x:Class="RssReader.Controlls.RssTabbedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:commonControlls="clr-namespace:Organiser.Common.Controlls;assembly=Organiser.Common"
             xmlns:controls="clr-namespace:RssReader"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>


            <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}" >
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid Width="12" Height="12">
                                <Rectangle x:Name="rec" Fill="Transparent"/>
                                <ContentPresenter/>
                                <Image Source="pack://application:,,,/Organiser.Common;component/Image/close.png" Stretch="None" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"  Value="True">
                                    <Setter TargetName="rec" Property="Fill" Value="#e0e0e0" />
                                </Trigger>
                                <Trigger Property="IsPressed"  Value="True">
                                    <Setter TargetName="rec" Property="Fill" Value="#d5d5d5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!--<Style.Resources>
                    <Style TargetType="{x:Type Path}">
                        <Setter Property="Fill" Value="#FF969696" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                <Setter Property="Fill" Value="Black" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Style.Resources>-->

            </Style>

            <Style TargetType="Button" x:Key="ButtonStyle">
                <Setter Property="Height" Value="23" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border 
                                Background="#a1a5ad" Cursor="Hand"
                                Padding="{TemplateBinding Padding}" MinWidth="95"
                                CornerRadius="0" x:Name="Border">
                                <ContentControl Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Center" Margin="7,0"
                                                VerticalAlignment="Center" TextElement.Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="#FF376ED4" Offset="0"/>
                                                <GradientStop Color="#FF588DF0" Offset="0.332"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" x:Key="NarrowButtonStyle">
                <Setter Property="Height" Value="23" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border 
                                Background="#a1a5ad" Cursor="Hand"
                                Padding="{TemplateBinding Padding}" MinWidth="25"
                                CornerRadius="0" x:Name="Border">
                                <ContentControl Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Center" Margin="7,0"
                                                VerticalAlignment="Center" TextElement.Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="#FF376ED4" Offset="0"/>
                                                <GradientStop Color="#FF588DF0" Offset="0.332"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type commonControlls:NonReloadingTabControl}">
              <Setter Property="Template">
                <Setter.Value>
                        <ControlTemplate TargetType="{x:Type commonControlls:NonReloadingTabControl}">
                        <Grid ClipToBounds="True"
                                  KeyboardNavigation.TabNavigation="Local"
                                  SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="RowDefinition0" Height="60" />
                                <RowDefinition x:Name="RowDefinition1" Height="*" />
                            </Grid.RowDefinitions>
                                <ScrollViewer HorizontalScrollBarVisibility="Visible" CanContentScroll="True" VerticalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                    <Border BorderThickness="0,0,0,0" BorderBrush="#d0d0d0">
                                            <Grid Margin="1,11,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TabPanel x:Name="HeaderPanel"
                                                      SnapsToDevicePixels="True"
                                                      Margin="15,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Panel.ZIndex="1"
                                                      IsItemsHost="True"
                                                      KeyboardNavigation.TabIndex="1" />
                                                <!--<Button Width="20" Height="20" Name="btnAddTab" 
                                                Command="ApplicationCommands.New"
                                                Grid.Column="1" Margin="3" ToolTip="New Tab" >
                                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
                                                </Button>-->
                                               
                                            <Button Width="25" Name="btnAddTab" 
                                                    Command="ApplicationCommands.New" Style="{StaticResource NarrowButtonStyle}"
                                                    Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" >
                                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                            </Button>

                                                <Button Command="ApplicationCommands.Open" Width="25" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource NarrowButtonStyle}">
                                                    <Image Source="pack://application:,,,/Organiser.Common;component/Image/import.png" Margin="-3"
                                                   ToolTip="Import From Other Project" />
                                                </Button>
                                                
                                            </Grid>
                                        </Border>
                                            </Grid>
                                </ScrollViewer>

                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.TabNavigation="Local">
                                <Grid x:Name="PART_ItemsHolder"
                                      Margin="{TemplateBinding Padding}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                          <Grid Cursor="Hand">
                            <!--<Button Name="btnFirstTab"
                                    Content="{Binding TabTitle}" 
                                    VerticalAlignment="Top"
                                    Width="100" 
                                    Height="25" 
                                    Style="{StaticResource tabButtonStyle}" />-->
                                <Border Name="contentRect"
                                        Height="23" 
                                        Margin="5,0"
                                        Background="#ffa1a5ad"
                                        >
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                       <TextBlock Text="{Binding TabTitle}" ClipToBounds="True" Margin="10,0" Foreground="White" VerticalAlignment="Center"  />
                                        <Button Command="ApplicationCommands.Close" Width="25"
                                                Style="{StaticResource CloseButtonStyle}">
                                            <Image Source="../Images/close.png" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                    
                                    <!--<Border.ContextMenu>
                                        <ContextMenu Opened="ContextMenu_Opened">
                                            <MenuItem Header="Remove" Command="ApplicationCommands.Close" />
                                        </ContextMenu>
                                    </Border.ContextMenu>-->
                                </Border>
                            </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" TargetName="contentRect">
                                            <Setter.Value>
                                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                    <GradientStop Color="#FF376ED4" Offset="0"/>
                                                    <GradientStop Color="#FF588DF0" Offset="0.332"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                </Trigger>

                          
                            
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type controls:MainViewModel}">
            <controls:RssControl />
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    
    
    <Grid >
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>-->
        <!--<Button Content="Create Rss Feed" Click="Button_Click" Style="{StaticResource ButtonStyle}" Margin="5" Width="150" HorizontalAlignment="Left" />-->
        <commonControlls:NonReloadingTabControl x:Name="tbContrl"  
                                                Grid.Row="1"
                                                BorderThickness="0" 
                                                SelectionChanged="tbContrl_SelectionChanged"
                                                ItemsSource="{Binding UserRssTabs}">
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </commonControlls:NonReloadingTabControl>
    </Grid>
</UserControl>
