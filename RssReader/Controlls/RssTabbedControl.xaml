<UserControl x:Class="RssReader.Controlls.RssTabbedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:commonControlls="clr-namespace:Organiser.Common.Controlls;assembly=Organiser.Common"
             xmlns:controls="clr-namespace:RssReader"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RssReader;component/Styles/ScrollBarStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            
       
       <Style TargetType="{x:Type commonControlls:NonReloadingTabControl}">
            <Setter Property="Template">
                <Setter.Value>
                        <ControlTemplate TargetType="{x:Type commonControlls:NonReloadingTabControl}">
                        <Grid ClipToBounds="True"
                                  Background="#FFFDFDFD"
                                  KeyboardNavigation.TabNavigation="Local"
                                  SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="RowDefinition0" Height="50" />
                                <RowDefinition x:Name="RowDefinition1" Height="*" />
                            </Grid.RowDefinitions>
                                <ScrollViewer HorizontalScrollBarVisibility="Visible" CanContentScroll="True" VerticalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TabPanel x:Name="HeaderPanel"
                                                      SnapsToDevicePixels="True"
                                                      Margin="0,0,0,-1"
                                                      VerticalAlignment="Bottom"
                                                      Panel.ZIndex="1"
                                                      IsItemsHost="True"
                                                      KeyboardNavigation.TabIndex="1" />

                                        <Button Width="20" Height="20" Name="btnAddTab" 
                                                Command="ApplicationCommands.New"
                                                Grid.Column="1" Margin="3" >
                                            <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
                                        </Button>
                                    </Grid>
                            </ScrollViewer>

                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2"
                                    Background="White"
                                    KeyboardNavigation.TabNavigation="Local">
                                <Grid x:Name="PART_ItemsHolder"
                                      Margin="{TemplateBinding Padding}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                          <Grid Height="60" Margin="{Binding TabMargin}">
                            <!--<Button Name="btnFirstTab"
                                    Content="{Binding TabTitle}" 
                                    VerticalAlignment="Top"
                                    Width="100" 
                                    Height="25" 
                                    Style="{StaticResource tabButtonStyle}" />-->
                                <Border Name="contentRect"
                                        BorderBrush="Black" 
                                        BorderThickness="0.5"
                                        Width="100" Height="25" 
                                        Margin="5"
                                        VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TabTitle}" ClipToBounds="True" Width="65" VerticalAlignment="Center"  />
                                        <Button Command="ApplicationCommands.Close" 
                                                HorizontalAlignment="Right" Width="18" Height="18">
                                            <TextBlock Text="x" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"  />
                                        </Button>
                                    </StackPanel>
                                    
                                    <!--<Border.ContextMenu>
                                        <ContextMenu Opened="ContextMenu_Opened">
                                            <MenuItem Header="Remove" Command="ApplicationCommands.Close" />
                                        </ContextMenu>
                                    </Border.ContextMenu>-->
                                </Border>
                            </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" TargetName="contentRect" Value="#FFD7D7D7" />
                            </Trigger>

                            <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="Background" TargetName="contentRect" Value="#FFFDFDFD" />
                            </Trigger>

                            <Trigger Property="IsMouseOver"  Value="True">
                                    <Setter TargetName="contentRect" Property="Background" Value="#FFD7D7D7" />
                            </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type controls:MainViewModel}">
            <controls:RssControl />
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    
    
    <Grid Background="#FFFDFDFD">
        <commonControlls:NonReloadingTabControl x:Name="tbContrl"  
                                                BorderThickness="0" 
                                                ItemsSource="{Binding UserRssTabs}">
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </commonControlls:NonReloadingTabControl>
    </Grid>
</UserControl>
