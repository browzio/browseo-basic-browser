<Window x:Class="RssReader.Windows.LinksToRssWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Title="Feed Masher - One Link On A Line keep http://" Height="350" Width="450" Icon="/RssReader;component/Images/browseo (1).ico">
    <Window.Resources>
        <!-- Flat Button Style -->
        <Color x:Key="DefaultColor" A="255" R="240" G ="240" B="240"/>
        <Color x:Key="HighlightColor" A="255" R="229" G ="229" B="229"/>
        <Color x:Key="PressedColor" A="255" R="215" G ="215" B="215"/>

        <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource DefaultColor}" />
        <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
        <SolidColorBrush x:Key="PressedBrush" Color="#FF8B8B8B" />

        <Style TargetType="Border" x:Key="innerShaddowBorder">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="Margin" Value="-2" />
            <Setter Property="Border.Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="FlatButtonStyle">
            <Setter Property="Background" Value="{StaticResource DefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.6" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="0">
                            <ContentControl Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
                    <Setter Property="Border.Background" Value="Transparent" />
                    <Setter Property="Border.BorderThickness" Value="1" />
                    <Setter Property="Border.BorderBrush" Value="{StaticResource PressedBrush}" />
                    <Setter Property="Border.Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="1.5" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- End Flat Button Style -->
    </Window.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
            <RowDefinition Height="35" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox Name="tbInputedText" IsEnabled="{Binding EnableOkBtn}" Text="{Binding InputedText}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Verdana" FontSize="15" />
        <DockPanel Grid.Row="1">
            <TextBlock Text="Feed Title:" VerticalAlignment="Center" Width="60" Margin="3" />
            <TextBox Text="{Binding SiteName}" Margin="3" />
        </DockPanel>
        <DockPanel Grid.Row="2" Margin="3">
            <TextBlock Text="Category" VerticalAlignment="Center" Margin="3" />
            <ComboBox ItemsSource="{Binding Catigories}"
                  IsEnabled="{Binding EnableOkBtn}"
                  SelectedIndex="{Binding SICategories}"
                      Margin="3"
                  Cursor="Hand"
                  Background="#eeeeee" />
        </DockPanel>
        <Button Style="{StaticResource FlatButtonStyle}" IsEnabled="{Binding EnableOkBtn}"
                Command="{Binding OkClicked}" Grid.Row="3" Cursor="Hand" Margin="3" >
            <TextBlock Text="Mash It" HorizontalAlignment="Center" />
        </Button>
        <Grid Grid.Row="4" Visibility="{Binding ResultsVisible}">
            <TextBox Text="{Binding OutputedLinks}" VerticalScrollBarVisibility="Auto" FontFamily="Verdana" FontSize="15" />
        </Grid>
    </Grid>
</Window>
