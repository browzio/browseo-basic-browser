<UserControl x:Class="RssReader.Views.RSSMainWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RssReader.Views"
             xmlns:commonControlls="clr-namespace:Organiser.Common.Controlls;assembly=Organiser.Common"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CloseButtonStyle"
                   TargetType="{x:Type Button}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid Width="12"
                                  Height="12">
                                <Rectangle x:Name="rec"
                                           Fill="Transparent" />
                                <ContentPresenter />
                                <Image Source="pack://application:,,,/Organiser.Common;component/Image/close.png"
                                       Stretch="None" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="rec"
                                            Property="Fill"
                                            Value="#e0e0e0" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="rec"
                                            Property="Fill"
                                            Value="#d5d5d5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style  x:Key="ButtonStyle" 
                    TargetType="Button">
                <Setter Property="Height"
                        Value="23" />
                <Setter Property="Margin"
                        Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#a1a5ad"
                                    Cursor="Hand"
                                    Padding="{TemplateBinding Padding}"
                                    MinWidth="95"
                                    CornerRadius="0"
                                    x:Name="Border">
                                <ContentControl Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Center"
                                                Margin="7,0"
                                                VerticalAlignment="Center"
                                                TextElement.Foreground="White" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Border"
                                            Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1"
                                                                 StartPoint="0.5,0">
                                                <GradientStop Color="#FF376ED4"
                                                              Offset="0" />
                                                <GradientStop Color="#FF588DF0"
                                                              Offset="0.332" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NarrowButtonStyle" 
                   TargetType="Button">
                <Setter Property="Height"
                        Value="23" />
                <Setter Property="Margin"
                        Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#5ea9f5"
                                    Cursor="Hand"
                                    Padding="{TemplateBinding Padding}"
                                    MinWidth="25"
                                    CornerRadius="0"
                                    x:Name="Border">
                                <ContentControl Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Center"
                                                Margin="7,0"
                                                VerticalAlignment="Center"
                                                TextElement.Foreground="White" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Border"
                                            Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1"
                                                                 StartPoint="0.5,0">
                                                <GradientStop Color="#5ea9f5"
                                                              Offset="0.6" />
                                                <GradientStop Color="#4b87c4"
                                                              Offset="0.5" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type commonControlls:NonReloadingTabControl}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type commonControlls:NonReloadingTabControl}">
                            <Grid ClipToBounds="True"
                                  KeyboardNavigation.TabNavigation="Local"
                                  SnapsToDevicePixels="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowDefinition0"
                                                   Height="60" />
                                    <RowDefinition x:Name="RowDefinition1"
                                                   Height="*" />
                                </Grid.RowDefinitions>
                                <ScrollViewer HorizontalScrollBarVisibility="Visible"
                                              CanContentScroll="True"
                                              VerticalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border BorderThickness="0,0,0,0"
                                                BorderBrush="#d0d0d0">
                                            <Grid Margin="1,11,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TabPanel x:Name="HeaderPanel"
                                                          SnapsToDevicePixels="True"
                                                          Margin="15,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Panel.ZIndex="1"
                                                          IsItemsHost="True"
                                                          KeyboardNavigation.TabIndex="1" />
                                                
                                                <Button Name="btnAddTab"
                                                        Command="{Binding OnCommandFromView}"
                                                        CommandParameter="New"
                                                        Grid.Column="1"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <!--<TextBlock Text="+"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="0,-3,0,0"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="16" />-->
                                                    <Image Source="pack://application:,,,/Organiser.Common;component/Image/ic_add_black_24dp_1x.png"
                                                           Margin="0,2,0,0"
                                                           ToolTip="New Tab" />
                                                </Button>

                                                <Button Command="{Binding OnCommandFromView}"
                                                        CommandParameter="Open"
                                                        Grid.Column="2"
                                                        Margin="10,0,0,0">
                                                    <Image Source="pack://application:,,,/Organiser.Common;component/Image/ic_input_black_24dp_1x.png"
                                                           Margin="0,2,0,0"
                                                           ToolTip="Import From Other Project" />
                                                </Button>

                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>

                                <Border x:Name="ContentPanel"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                        KeyboardNavigation.TabIndex="2"
                                        KeyboardNavigation.TabNavigation="Local">
                                    <Grid x:Name="PART_ItemsHolder"
                                          Margin="{TemplateBinding Padding}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid Cursor="Hand">
                                <Border Name="contentRect"
                                        Height="23"
                                        Background="#f5f5f5"
                                        BorderBrush="LightGray"
                                        BorderThickness="1"
                                        Margin="5,0">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Name="TitleContent"
                                                   Text="{Binding Title}"
                                                   ClipToBounds="True"
                                                   Margin="10,0"
                                                   Foreground="Black"
                                                   VerticalAlignment="Center" />
                                        <Button Command="{Binding OnCommandFromView}"
                                                CommandParameter="Close"
                                                Width="25"
                                                Style="{StaticResource CloseButtonStyle}">
                                            <Image Source="../Images/close.png"
                                                   Stretch="None"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter TargetName="contentRect"
                                            Property="Background"
                                            Value="#1E8EFF" />
                                    <Setter TargetName="contentRect"
                                            Property="BorderThickness"
                                            Value="1" />
                                    <Setter TargetName="contentRect"
                                            Property="BorderBrush"
                                            Value="White" />
                                    <Setter TargetName="TitleContent"
                                            Property="TextElement.Foreground"
                                            Value="White" />
                                </Trigger>

                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="contentRect"
                                            Property="BorderBrush"
                                            Value="White" />
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <commonControlls:NonReloadingTabControl BorderThickness="0"
                                                SelectedItem="{Binding SelectedRSSTab}"
                                                ItemsSource="{Binding RSSTabs}">
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <local:RSSTabView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </commonControlls:NonReloadingTabControl>
    </Grid>
</UserControl>
