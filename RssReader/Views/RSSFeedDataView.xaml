                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/reddit-icon.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="reddit" />
                                    </Button>

                                    <!--<Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="stumbleupon"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/StumbleUpon-icon.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="stumbleupon" />
                                    </Button>-->

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="tumblr"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/tumblr-icon.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="tumblr" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="twitter"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/twitter-icon.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="twitter" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="wordpress"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/wordpress-icon.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="wordpress" />
                                    </Button>
                                </StackPanel>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button HorizontalAlignment="Left"
                            Margin="0"
                            Click="Button_Click"
                            ContextMenuService.IsEnabled="False"
                            Content="Share Via Firefox"
                            Grid.Row="5"
                            Style="{StaticResource linkStyle}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="ff_facebook"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/facebook-icon.png"
                                               ToolTip="facebook"
                                               Width="18"
                                               Height="18" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="ff_google"
                                            Click="Button_Click_1">
