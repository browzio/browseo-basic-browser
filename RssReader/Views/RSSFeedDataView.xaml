                                               ToolTip="buffer" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="ff_Scoopit"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/it_24.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="Scoop.it!" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="ff_hootsuite"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/hootsuite_normal.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="Hootsuite" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="ff_pintrest"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/Pinterest-icon.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="pintrest" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="ff_reddit"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/reddit-icon.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="reddit" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="ff_stumbleupon"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/StumbleUpon-icon.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="stumbleupon" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
