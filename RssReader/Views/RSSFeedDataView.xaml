                                            CommandParameter="scoopit"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/it_24.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="Scoop.it!" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="hootsuite"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/hootsuite_normal.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="Hootsuite" />
                                    </Button>

                                    <Button Cursor="Hand"
                                            Style="{StaticResource browser_btn}"
                                            Margin="3"
                                            Command="{Binding OnCommandFromView}"
                                            CommandParameter="pintrest"
                                            Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/Pinterest-icon.png"
                                               Width="18"
                                               Height="18"
                                               ToolTip="pintrest" />
                                    </Button>

