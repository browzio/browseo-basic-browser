<UserControl x:Class="RssReader.Views.RSSFeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RssReader.Views"
             xmlns:commonControls="clr-namespace:Organiser.Common.Controlls;assembly=Organiser.Common"
             xmlns:helpers="clr-namespace:RssReader.Helpers"
             mc:Ignorable="d" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Height="30"
                Background="#9196a1">
            <TextBlock Text="{Binding FeedUrl}"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"
                       HorizontalAlignment="Left" />
        </Border>

        <ListView ItemsSource="{Binding RSSFeedDataResults}"
                  SelectedItem="{Binding SelectedFeedDataResult}"
                  Grid.Row="1"
                  Name="lv"
                  PreviewMouseWheel="lv_PreviewMouseWheel"
                  BorderThickness="0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="true"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ItemContainerStyle="{DynamicResource MetroListBoxItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <local:RSSFeedDataView   />
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="View In FF">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="BrowserFF" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <MenuItem Header="View In Chrome">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="Browser" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <Separator Margin="-30,0,0,0" />
                    <MenuItem Header="Grab All Links">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="GrabAllLinks" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <Separator Margin="-30,0,0,0" />
                    <MenuItem Header="Facebook Order By Shares">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_FBSHARES" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Facebook Order By Likes">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_FBLIKES" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Facebook Order By Comments">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_FBCOMMENTS" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Google+ Order By Plus Ones">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_GPLUSONES" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Pinterest Order By Pins">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_PINTERESTPINS" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Stumble Order By Views">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_STUMBLEVIEWS" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="LinkedIn Order By Count">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_LINKEDINCOUNT" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Buffer Order By Shares">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_BUFFERSHARES" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Youtube Order By Views"
                              Visibility="{Binding HasYoutubeFeed, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_YOUTUBEVIEWS" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Youtube Order By Ratings"
                              Visibility="{Binding HasYoutubeFeed, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_YOUTUBERATINGS" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Youtube Order By Average Rating"
                              Visibility="{Binding HasYoutubeFeed, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_YOUTUBERATINGAVERAGE" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Reddit Order By Ups">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_REDDITUPS" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Reddit Order By Score">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="ORDERBY_REDDITSCORE" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <Separator Margin="-30,0,0,0" />

                    <MenuItem Header="Send To Feed Masher">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="Masher" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <MenuItem Header="Curate It">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="PBNPOSTER" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <MenuItem Header="Curaste...">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="Curaste" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <MenuItem Header="To Social Enagager">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OnCommandFromView}"
                                          CommandParameter="TOSEO" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <StackPanel Visibility="{Binding IsLoadingFeedData, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Grid.Row="1">
            <commonControls:CirclePBarControl />
        </StackPanel>
    </Grid>
</UserControl>
