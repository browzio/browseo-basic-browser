<UserControl x:Class="BrowseoFX_WPF.Browseo.SocialBirdEye.Views.FacebookEyeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrowseoFX_WPF.Browseo.SocialBirdEye.Views"
             xmlns:converters="clr-namespace:Organiser.Common.Converters;assembly=Organiser.Common"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="350">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:NullToVisibleConverter x:Key="nullToVis" />

            <DataTemplate x:Key="summaryTemplate">
                <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                    <local:KeyValDisplayControl ParamTitle="likes:"
                                                ParamValue="{Binding likes.summary.total_count}"/>

                    <local:KeyValDisplayControl ParamTitle="comments:" 
                                                ParamValue="{Binding comments.summary.total_count}" />

                    <local:KeyValDisplayControl ParamTitle="reactions:" 
                                                ParamValue="{Binding reactions.summary.total_count}" />
                </StackPanel>
            </DataTemplate>

            <ControlTemplate x:Key="lvNoScrollTemplate">
                <ItemsPresenter></ItemsPresenter>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#413f41"
          DataContext="{Binding FacebookApisController}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button ToolTip="Api Key Settings" 
                    HorizontalAlignment="Left"
                    Style="{StaticResource FlatbtnStyle}"
                    Command="{Binding OnCommandFromView}"
                    CommandParameter="SetApiKeys">
                <Image Source="pack://application:,,,/Organiser.Common;component/Image/settings2.png" />
            </Button>

            <Button ToolTip="Oauth Api" 
                    Style="{StaticResource FlatbtnStyle}"
                    Command="{Binding OnCommandFromView}"
                    CommandParameter="OauthApi">
                <Image Source="pack://application:,,,/Organiser.Common;component/Image/user.png" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="1"
              Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <UniformGrid Rows="1"
                         Margin="3">
                <Button Content="Analyze" 
                        Background="#dd2c28"
                        TextElement.Foreground="White"
                        Style="{StaticResource FlatbtnStyle}"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="AnalyzeAllData" />

                <Button Content="Insites" 
                        Background="#dd2c28"
                        TextElement.Foreground="White"
                        Style="{StaticResource FlatbtnStyle}"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="AnalyzeAllInsitesData" />
            </UniformGrid>

            <ScrollViewer Grid.Row="1"
                          Name="svContent"
                          Margin="3"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Style="{x:Null}">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    
                        <Expander Header="Summary"
                              Grid.Row="1"
                              Margin="3,0,3,3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.userResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                            <local:KeyValDisplayControl ParamTitle="Name:" 
                                                        ParamValue="{Binding UserSummary.userResponse.name}" />
                            <local:KeyValDisplayControl ParamTitle="Friends Count:"
                                                        ParamValue="{Binding UserSummary.userResponse.friends.summary.total_count}" />
                        </StackPanel>
                    </Expander>
                        
                        <Expander Header="Feed"
                              Grid.Row="2"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.feedResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <StackPanel Orientation="Vertical" 
                                    Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding UserSummary.feedResponse.data}"
                                      Template="{StaticResource lvNoScrollTemplate}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical"
                                                    Grid.IsSharedSizeScope="True">
                                            
                                                <local:KeyValDisplayControl ParamTitle="Type:" 
                                                                        ParamValue="{Binding type}" />

                                                <local:KeyValDisplayControl ParamTitle="Status Type:" 
                                                                        ParamValue="{Binding status_type}" />

                                                <local:KeyValDisplayControl ParamTitle="Permalink Url:" 
                                                                        ParamValue="{Binding permalink_url}" />

                                            <local:KeyValDisplayControl ParamTitle="Link:" 
                                                                        ParamValue="{Binding link}" />

                                            <local:KeyValDisplayControl ParamTitle="Source:" 
                                                                        ParamValue="{Binding source}" />

                                            <local:KeyValDisplayControl ParamTitle="Shares:" 
                                                                        ParamValue="{Binding shares.count}" />

                                            <ContentPresenter ContentTemplate="{StaticResource summaryTemplate}"/>
                                            
                                            <local:KeyValDisplayControl ParamTitle="Created At:" 
                                                                        ParamValue="{Binding created_time}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                        
                        <Expander Header="Albums"
                              Grid.Row="3"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.albumsResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                            <StackPanel Orientation="Vertical" 
                                    Grid.IsSharedSizeScope="True">
                                <ListView ItemsSource="{Binding UserSummary.albumsResponse.data}"
                                      Template="{StaticResource lvNoScrollTemplate}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical"
                                                    Grid.IsSharedSizeScope="True">
                                                
                                                <local:KeyValDisplayControl ParamTitle="Type:" 
                                                                        ParamValue="{Binding type}" />

                                                <local:KeyValDisplayControl ParamTitle="Link:" 
                                                                        ParamValue="{Binding link}" />

                                            <ContentPresenter ContentTemplate="{StaticResource summaryTemplate}"/>
                                                
                                            <local:KeyValDisplayControl ParamTitle="Created At:" 
                                                                        ParamValue="{Binding created_time}" />
                                        </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                        
                        <Expander Header="Photos"
                              Grid.Row="4"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.photosResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                            <StackPanel Orientation="Vertical" 
                                    Grid.IsSharedSizeScope="True">
                                <ListView ItemsSource="{Binding UserSummary.photosResponse.data}"
                                      Template="{StaticResource lvNoScrollTemplate}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical"
                                                    Grid.IsSharedSizeScope="True">

                                                <local:KeyValDisplayControl ParamTitle="Link:" 
                                                                        ParamValue="{Binding link}" />

                                            <ContentPresenter ContentTemplate="{StaticResource summaryTemplate}"/>
                                                
                                            <local:KeyValDisplayControl ParamTitle="Created At:" 
                                                                        ParamValue="{Binding created_time}" />
                                        </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                        
                        <Expander Header="Videos"
                              Grid.Row="5"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.videosResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                            <StackPanel Orientation="Vertical" 
                                    Grid.IsSharedSizeScope="True">
                                <ListView ItemsSource="{Binding UserSummary.videosResponse.data}"
                                      Template="{StaticResource lvNoScrollTemplate}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical"
                                                    Grid.IsSharedSizeScope="True">

                                                <local:KeyValDisplayControl ParamTitle="Content Category:" 
                                                                        ParamValue="{Binding content_category}" />

                                                <local:KeyValDisplayControl ParamTitle="Link:" 
                                                                        ParamValue="{Binding link}" />

                                                <local:KeyValDisplayControl ParamTitle="Embed Html:" 
                                                                        ParamValue="{Binding embed_html}" />

                                                <local:KeyValDisplayControl ParamTitle="Source:" 
                                                                        ParamValue="{Binding source}" />

                                            <ContentPresenter ContentTemplate="{StaticResource summaryTemplate}"/>
                                                
                                            <local:KeyValDisplayControl ParamTitle="Created At:" 
                                                                        ParamValue="{Binding created_time}" />
                                        </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                        
                        <Expander Header="Live Videos"
                              Grid.Row="6"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.live_videosResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                            <StackPanel Orientation="Vertical" 
                                    Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding UserSummary.live_videosResponse.data}"
                                      Template="{StaticResource lvNoScrollTemplate}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical"
                                                    Grid.IsSharedSizeScope="True">
                                            <local:KeyValDisplayControl ParamTitle="Title:" 
                                                                        ParamValue="{Binding title}" />

                                            <local:KeyValDisplayControl ParamTitle="Status:" 
                                                                        ParamValue="{Binding status}" />

                                            <local:KeyValDisplayControl ParamTitle="Permalink Url:" 
                                                                        ParamValue="{Binding permalink_url}" />

                                            <local:KeyValDisplayControl ParamTitle="Live Views:" 
                                                                        ParamValue="{Binding live_views}" />

                                            <ContentPresenter ContentTemplate="{StaticResource summaryTemplate}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Video Broadcasts"
                              Grid.Row="7"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.videoBroadcastsResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <StackPanel Orientation="Vertical" 
                                    Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding UserSummary.videoBroadcastsResponse.data}"
                                      Template="{StaticResource lvNoScrollTemplate}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical"
                                                    Grid.IsSharedSizeScope="True">
                                            <local:KeyValDisplayControl ParamTitle="Title:" 
                                                                        ParamValue="{Binding title}" />

                                            <local:KeyValDisplayControl ParamTitle="Status:" 
                                                                        ParamValue="{Binding status}" />

                                            <local:KeyValDisplayControl ParamTitle="Permalink Url:" 
                                                                        ParamValue="{Binding permalink_url}" />

                                            <local:KeyValDisplayControl ParamTitle="Live Views:" 
                                                                        ParamValue="{Binding live_views}" />

                                            <ContentPresenter ContentTemplate="{StaticResource summaryTemplate}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>

                        <Expander Header="Likes"
                              Grid.Row="8"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.likesResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <StackPanel Orientation="Vertical" 
                                    Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding UserSummary.likesResponse.data}"
                                      Template="{StaticResource lvNoScrollTemplate}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical"
                                                    Grid.IsSharedSizeScope="True">

                                            <local:KeyValDisplayControl ParamTitle="Name:" 
                                                                        ParamValue="{Binding name}" />

                                            <local:KeyValDisplayControl ParamTitle="Category:" 
                                                                        ParamValue="{Binding category}" />

                                            <local:KeyValDisplayControl ParamTitle="Link:" 
                                                                        ParamValue="{Binding link}" />

                                            <local:KeyValDisplayControl ParamTitle="Website:" 
                                                                        ParamValue="{Binding website}" />

                                            <local:KeyValDisplayControl ParamTitle="Fan Count:" 
                                                                        ParamValue="{Binding fan_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Talking About:" 
                                                                        ParamValue="{Binding talking_about_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Rating:" 
                                                                        ParamValue="{Binding rating_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Overall Rating:" 
                                                                        ParamValue="{Binding overall_star_rating}" />

                                            <local:KeyValDisplayControl ParamTitle="Created At:" 
                                                                        ParamValue="{Binding created_time}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                        
                        <Expander Header="Groups"
                              Grid.Row="9"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.groupsResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <StackPanel Orientation="Vertical" 
                                    Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding UserSummary.groupsResponse.data}"
                                      Template="{StaticResource lvNoScrollTemplate}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical"
                                                    Grid.IsSharedSizeScope="True">
                                            <local:KeyValDisplayControl ParamTitle="Name:" 
                                                                        ParamValue="{Binding name}" />

                                            <local:KeyValDisplayControl ParamTitle="unread:" 
                                                                        ParamValue="{Binding unread}" />

                                            <local:KeyValDisplayControl ParamTitle="Created At:" 
                                                                        ParamValue="{Binding created_time}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>

                        <Expander Header="Events"
                              Grid.Row="10"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.eventsResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <StackPanel Orientation="Vertical" 
                                    Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding UserSummary.eventsResponse.data}"
                                      Template="{StaticResource lvNoScrollTemplate}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical"
                                                    Grid.IsSharedSizeScope="True">
                                            <local:KeyValDisplayControl ParamTitle="Name:" 
                                                                        ParamValue="{Binding name}" />

                                            <local:KeyValDisplayControl ParamTitle="category:" 
                                                                        ParamValue="{Binding category}" />

                                            <local:KeyValDisplayControl ParamTitle="Attending:" 
                                                                        ParamValue="{Binding attending_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Declined:" 
                                                                        ParamValue="{Binding declined_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Interested:" 
                                                                        ParamValue="{Binding interested_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Maybes:" 
                                                                        ParamValue="{Binding maybe_count}" />

                                            <local:KeyValDisplayControl ParamTitle="No Reply:" 
                                                                        ParamValue="{Binding noreply_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Timezone:" 
                                                                        ParamValue="{Binding Timezone}" />

                                            <local:KeyValDisplayControl ParamTitle="updated_time:" 
                                                                        ParamValue="{Binding updated_time}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>

                        <Expander Header="Accounts"
                              Grid.Row="11"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down"
                              Visibility="{Binding Path=UserSummary.accountsOwenedResponse, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <StackPanel Orientation="Vertical" 
                                    Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding UserSummary.accountsOwenedResponse.data}"
                                      Template="{StaticResource lvNoScrollTemplate}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical"
                                                    Grid.IsSharedSizeScope="True">
                                            <local:KeyValDisplayControl ParamTitle="Status:" 
                                                                        ParamValue="{Binding name}" />

                                            <local:KeyValDisplayControl ParamTitle="Category:" 
                                                                        ParamValue="{Binding category}" />

                                            <local:KeyValDisplayControl ParamTitle="Link:" 
                                                                        ParamValue="{Binding link}" />

                                            <local:KeyValDisplayControl ParamTitle="Website:" 
                                                                        ParamValue="{Binding website}" />

                                            <local:KeyValDisplayControl ParamTitle="Fan Count:" 
                                                                        ParamValue="{Binding fan_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Talking About:" 
                                                                        ParamValue="{Binding talking_about_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Rating:" 
                                                                        ParamValue="{Binding rating_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Overall Rating:" 
                                                                        ParamValue="{Binding overall_star_rating}" />

                                            <local:KeyValDisplayControl ParamTitle="checkins:" 
                                                                        ParamValue="{Binding checkins}" />

                                            <local:KeyValDisplayControl ParamTitle="Country Page Likes:" 
                                                                        ParamValue="{Binding country_page_likes}" />

                                            <local:KeyValDisplayControl ParamTitle="New Likes:" 
                                                                        ParamValue="{Binding new_like_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Talking About:" 
                                                                        ParamValue="{Binding talking_about_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Unread Messages:" 
                                                                        ParamValue="{Binding unread_message_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Unread Notifications:" 
                                                                        ParamValue="{Binding unread_notif_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Were Here:" 
                                                                        ParamValue="{Binding were_here_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Unseen Messages:" 
                                                                        ParamValue="{Binding unseen_message_count}" />

                                            <local:KeyValDisplayControl ParamTitle="Created At:" 
                                                                        ParamValue="{Binding created_time}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
