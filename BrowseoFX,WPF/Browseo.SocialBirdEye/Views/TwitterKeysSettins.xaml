<UserControl x:Class="BrowseoFX_WPF.Browseo.SocialBirdEye.Views.TwitterKeysSettins"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrowseoFX_WPF.Browseo.SocialBirdEye.Views"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
        <Grid Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0">Oauth Token:</Label>
            <TextBox Grid.Column="1"
                     Text="{Binding OauthToken}"/>
        </Grid>

        <Grid Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0">Oauth Token Secret:</Label>
            <TextBox Grid.Column="1"
                     Text="{Binding OauthTokenSecret}"/>
        </Grid>
        
        <Grid Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0">Oauth Consumer Key:</Label>
            <TextBox Grid.Column="1"
                     Text="{Binding OauthConsumerKey}"/>
        </Grid>

        <Grid Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0">Oauth Consumer Secret:</Label>
            <TextBox Grid.Column="1"
                     Text="{Binding OauthConsumerSecret}"/>
        </Grid>


        <Grid Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0">Screen Name:</Label>
            <TextBox Grid.Column="1"
                     Text="{Binding ScreenName}"/>
        </Grid>
    </StackPanel>
</UserControl>
