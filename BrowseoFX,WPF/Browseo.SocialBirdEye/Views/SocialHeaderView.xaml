<UserControl x:Class="BrowseoFX_WPF.Browseo.SocialBirdEye.Views.SocialHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrowseoFX_WPF.Browseo.SocialBirdEye.Views"
             xmlns:converters="clr-namespace:Organiser.Common.Converters;assembly=Organiser.Common"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:NullToVisibleConverter x:Key="nullToVis" />
            <converters:DatetimeToStringConverter x:Key="DatetimeToStringConverter" />

            <ControlTemplate x:Key="lvNoScrollTemplate">
                <ItemsPresenter></ItemsPresenter>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!--<Border Background="White" />-->
        <Ellipse Height="38" Width="38"
                 Margin="3"
                 Visibility="{Binding
                            RelativeSource={RelativeSource AncestorType={x:Type local:SocialHeaderView}}, 
                            Path=ImageUrl, 
                            Converter={StaticResource nullToVis}}">
            <Ellipse.Fill>
                <ImageBrush ImageSource="pack://application:,,,/Organiser.Common;component/Image/social/baseline_person_black_18dp.png"/>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Height="38" Width="38"
                 Margin="3"
                 Visibility="{Binding
                            RelativeSource={RelativeSource AncestorType={x:Type local:SocialHeaderView}},
                            Path=ImageUrl, 
                            Converter={StaticResource nullToVis}, 
                            ConverterParameter=NOT}">
            <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:SocialHeaderView}}, Path=ImageUrl}"/>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Grid.Column="1"
              Margin="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:SocialHeaderView}}, Path=FromName}"
                       Margin="3"
                       FontWeight="Medium"
                       FontSize="18"
                       Style="{StaticResource tbLinkStyle}" />

            <TextBlock Text="{Binding 
                                RelativeSource={RelativeSource AncestorType={x:Type local:SocialHeaderView}}, 
                                Path=CreatedAtFull,
                                Converter={StaticResource DatetimeToStringConverter}}"
                       ToolTip="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:SocialHeaderView}}, Path=CreatedAtFull}"
                       
                       Style="{StaticResource tbLinkStyle}" 
                       
                       VerticalAlignment="Top"
                       Margin="3"
                       FontSize="14"
                       Grid.Row="1"
                       Foreground="Black" />

            <!--<TextBlock Text="Eli Dadia"
                       FontSize="18"
                       Style="{StaticResource tbLinkStyle}" />

            <TextBlock Text="July 4, 2018"
                       FontSize="16"
                       Grid.Row="1"
                       Foreground="Black"
                       Style="{StaticResource tbLinkStyle}"  />-->
        </Grid>
    </Grid>
</UserControl>
