<UserControl x:Class="BrowseoFX_WPF.Browseo.SocialBirdEye.Views.PinterestEyeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrowseoFX_WPF.Browseo.SocialBirdEye.Views"
             xmlns:converters="clr-namespace:Organiser.Common.Converters;assembly=Organiser.Common"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="350">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:NullToVisibleConverter x:Key="nullToVis" />
            
            <DataTemplate x:Key="countsTemplate">
                <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                    <Grid Visibility="{Binding Path=pins, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Pins:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding pins}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=following, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Following:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding following}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=followers, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Followers:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding followers}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=boards, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Boards:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding boards}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=saves, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Saves:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding saves}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=comments, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Comments:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding comments}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=collaborators, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Collaborators:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding collaborators}"/>
                    </Grid>
                </StackPanel>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Background="#413f41"
          DataContext="{Binding PinterestApisController}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button ToolTip="Api Key Settings" 
                    HorizontalAlignment="Left"
                    Style="{StaticResource FlatbtnStyle}"
                    Command="{Binding OnCommandFromView}"
                    CommandParameter="SetApiKeys">
                <Image Source="pack://application:,,,/Organiser.Common;component/Image/settings2.png" />
            </Button>

            <Button ToolTip="Oauth Api" 
                    Style="{StaticResource FlatbtnStyle}"
                    Command="{Binding OnCommandFromView}"
                    CommandParameter="OauthApi">
                <Image Source="pack://application:,,,/Organiser.Common;component/Image/user.png" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="1"
              Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <UniformGrid Rows="1">
                <Button Content="Analyze" 
                        Background="#dd2c28"
                        TextElement.Foreground="White"
                        Style="{StaticResource FlatbtnStyle}"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="AnalyzeAllPinterestData" />
            </UniformGrid>

            <ScrollViewer Grid.Row="1"
                          Margin="3"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="False"
                          Style="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Expander Header="User Info"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">Username:</Label>
                                <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding UserInfo.data.username}"/>
                            </Grid>

                            <ContentPresenter DataContext="{Binding UserInfo.data.counts}" 
                                              Content="{Binding UserInfo.data.counts}"
                                              ContentTemplate="{StaticResource countsTemplate}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="User Boards"
                              Grid.Row="1"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <ListView ItemsSource="{Binding UserBoards.data}">
                            <ListView.Template>
                                <ControlTemplate>
                                    <ItemsPresenter></ItemsPresenter>
                                </ControlTemplate>
                            </ListView.Template>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0">Board Name:</Label>
                                            <TextBox Grid.Column="1"
                                                    Style="{StaticResource SelectableTextBlock}"
                                                    Text="{Binding name}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0">Url:</Label>
                                            <TextBox Grid.Column="1"
                                                    Style="{StaticResource SelectableTextBlock}"
                                                    Text="{Binding url}"/>
                                        </Grid>

                                        <ContentPresenter DataContext="{Binding counts}" 
                                              Content="{Binding counts}"
                                              ContentTemplate="{StaticResource countsTemplate}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>

                    <Expander Header="User Pins"
                              Grid.Row="2"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <ListView ItemsSource="{Binding UserPins.data}">
                            <ListView.Template>
                                <ControlTemplate>
                                    <ItemsPresenter></ItemsPresenter>
                                </ControlTemplate>
                            </ListView.Template>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0">Url:</Label>
                                            <TextBox Grid.Column="1"
                                                    Style="{StaticResource SelectableTextBlock}"
                                                    Text="{Binding url}"/>
                                        </Grid>

                                        <ContentPresenter DataContext="{Binding counts}" 
                                              Content="{Binding counts}"
                                              ContentTemplate="{StaticResource countsTemplate}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>

                    <Expander Header="User Followers"
                              Grid.Row="3"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <ListView ItemsSource="{Binding UserFollowers.data}">
                            <ListView.Template>
                                <ControlTemplate>
                                    <ItemsPresenter></ItemsPresenter>
                                </ControlTemplate>
                            </ListView.Template>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0">Username:</Label>
                                            <TextBox Grid.Column="1"
                                                    Style="{StaticResource SelectableTextBlock}"
                                                    Text="{Binding username}"/>
                                        </Grid>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0">Url:</Label>
                                            <TextBox Grid.Column="1"
                                                    Style="{StaticResource SelectableTextBlock}"
                                                    Text="{Binding url}"/>
                                        </Grid>

                                        <ContentPresenter DataContext="{Binding counts}" 
                                              Content="{Binding counts}"
                                              ContentTemplate="{StaticResource countsTemplate}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>

                    <Expander Header="Boards Following"
                              Grid.Row="4"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <ListView ItemsSource="{Binding BoardsFollowing.data}">
                            <ListView.Template>
                                <ControlTemplate>
                                    <ItemsPresenter></ItemsPresenter>
                                </ControlTemplate>
                            </ListView.Template>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0">Board Name:</Label>
                                            <TextBox Grid.Column="1"
                                                    Style="{StaticResource SelectableTextBlock}"
                                                    Text="{Binding name}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0">Url:</Label>
                                            <TextBox Grid.Column="1"
                                                    Style="{StaticResource SelectableTextBlock}"
                                                    Text="{Binding url}"/>
                                        </Grid>

                                        <ContentPresenter DataContext="{Binding counts}" 
                                              Content="{Binding counts}"
                                              ContentTemplate="{StaticResource countsTemplate}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>

                    <Expander Header="Users Following"
                              Grid.Row="5"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <ListView ItemsSource="{Binding UserFollowing.data}">
                            <ListView.Template>
                                <ControlTemplate>
                                    <ItemsPresenter></ItemsPresenter>
                                </ControlTemplate>
                            </ListView.Template>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0">Username:</Label>
                                            <TextBox Grid.Column="1"
                                                    Style="{StaticResource SelectableTextBlock}"
                                                    Text="{Binding username}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0">Url:</Label>
                                            <TextBox Grid.Column="1"
                                                    Style="{StaticResource SelectableTextBlock}"
                                                    Text="{Binding url}"/>
                                        </Grid>

                                        <ContentPresenter DataContext="{Binding counts}" 
                                              Content="{Binding counts}"
                                              ContentTemplate="{StaticResource countsTemplate}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
