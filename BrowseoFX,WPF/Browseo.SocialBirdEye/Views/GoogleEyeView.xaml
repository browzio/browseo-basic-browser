<UserControl x:Class="BrowseoFX_WPF.Browseo.SocialBirdEye.Views.GoogleEyeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrowseoFX_WPF.Browseo.SocialBirdEye.Views"
             xmlns:controls="clr-namespace:Organiser.Common.Controlls;assembly=Organiser.Common"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="350">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="#413f41"
          DataContext="{Binding GoogleApisController}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button ToolTip="Api Key Settings" 
                    HorizontalAlignment="Left"
                    Style="{StaticResource FlatbtnStyle}"
                    Command="{Binding OnCommandFromView}"
                    CommandParameter="SetApiKeys">
                    <Image Source="pack://application:,,,/Organiser.Common;component/Image/settings2.png" />
                </Button>

                <Button ToolTip="Oauth Api" 
                    Style="{StaticResource FlatbtnStyle}"
                    Command="{Binding OnCommandFromView}"
                    CommandParameter="OauthGoogleApis">
                    <Image Source="pack://application:,,,/Organiser.Common;component/Image/user.png" />
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Grid.Column="1">
                <Button ToolTip="Youtube View" 
                        Name="btnYoutubeView"
                        Click="ViewBtn_Click"
                        Style="{StaticResource FlatbtnStyle}">
                    <Image Source="pack://application:,,,/Organiser.Common;component/Image/youtube_icon_x1.png" />
                </Button>

                <Button ToolTip="Google+ View" 
                        Name="btnGPlusView"
                        Click="ViewBtn_Click"
                        Style="{StaticResource FlatbtnStyle}">
                    <Image Source="pack://application:,,,/Organiser.Common;component/Image/googleplus-icon.png" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Name="grdYoutube"
              Grid.Row="1"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <!--<Button ToolTip="Open Youtube Options" 
                    Width="35"
                    Height="35"
                    HorizontalAlignment="Left"
                    Name="btnYoutubeOptions"
                    Click="btnYoutubeOptions_Click"
                    Style="{StaticResource FlatImageBtn}">
                <Image Source="pack://application:,,,/Organiser.Common;component/Image/youtube_icon_x1.png" />
            </Button>-->

                <UniformGrid Name="grdYoutubeOptions"
                         Rows="1">
                    <Button Content="Channels" 
                        ToolTip="Returns a list of logged in users channels"
                        Background="#dd2c28"
                        TextElement.Foreground="White"
                    Style="{StaticResource FlatbtnStyle}"
                    Command="{Binding OnCommandFromView}"
                    CommandParameter="GetYoutubeChannels" />

                    <Button Content="Videos" 
                        ToolTip="Returns a list of logged in users videos"
                        Background="#dd2c28"
                        TextElement.Foreground="White"
                        Style="{StaticResource FlatbtnStyle}"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="GetYoutubeVideos" />

                    <Button Content="Likes" 
                        ToolTip="Returns a list of logged in users liked videos"
                        Background="#dd2c28"
                        TextElement.Foreground="White"
                    Style="{StaticResource FlatbtnStyle}"
                    Command="{Binding OnCommandFromView}"
                    CommandParameter="GetYoutubeLikedVideos" />

                    <Button Content="Popular" 
                        ToolTip="Returns a list of the most popular videos"
                        Background="#dd2c28"
                        TextElement.Foreground="White"
                    Style="{StaticResource FlatbtnStyle}"
                    Command="{Binding OnCommandFromView}"
                    CommandParameter="GetYoutubeMostPopularVideos" />
                </UniformGrid>
            </Grid>

            <ScrollViewer Grid.Row="1"
                      Margin="3"
                          VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="False"
                      Style="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

