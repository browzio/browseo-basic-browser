                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Favorites:</Label>
                                                <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding statistics.favoriteCount}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Likes:</Label>
                                                <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding statistics.likeCount}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Views:</Label>
                                                <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding statistics.viewCount}"/>
                                            </Grid>

                                            <Expander Header="Comments"
                                                  Margin="3"
                                                  Background="White"
                                                  ExpandDirection="Down">
                                                <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                                    <ListView ItemsSource="{Binding Comments}"
                                                              BorderThickness="0"
                                                              Background="Transparent">
                                                        <ListView.Template>
                                                            <ControlTemplate>
                                                                <ItemsPresenter></ItemsPresenter>
                                                            </ControlTemplate>
                                                        </ListView.Template>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Label Grid.Column="0">Author Display Name:</Label>
                                                                        <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding snippet.topLevelComment.snippet.authorDisplayName}"/>
                                                                    </Grid>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Label Grid.Column="0">Author Channel Url:</Label>
                                                                        <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding snippet.topLevelComment.snippet.authorChannelUrl}"/>
                                                                    </Grid>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Label Grid.Column="0">Likes:</Label>
                                                                        <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding snippet.topLevelComment.snippet.likeCount}"/>
                                                                    </Grid>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Label Grid.Column="0">Total Replys:</Label>
                                                                        <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding snippet.totalReplyCount}"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Name="grdGooglePlus"
              Grid.Row="1"
              Visibility="Visible">
            <!--<controls:NonReloadingTabControl Name="tbCntrl"
                                             Background="Transparent"
                                             BorderThickness="0">
                <TabItem Header="Activities"
                         Background="#dd2c28"
                         Foreground="Black"
                         Style="{StaticResource anyTabStyle}">
                    
                </TabItem>

                <TabItem Header="Comments"
                         Background="#dd2c28"
                         Foreground="Black"
                         Style="{StaticResource anyTabStyle}">

                </TabItem>
            </controls:NonReloadingTabControl>-->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <UniformGrid Rows="1">
                <Button Content="Activities" 
                        ToolTip="Returns a list of logged in users recent activities"
                        Background="#dd2c28"
                        TextElement.Foreground="White"
                        Style="{StaticResource FlatbtnStyle}"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="GetGooglePlusActivities" />
            </UniformGrid>

            <ScrollViewer Grid.Row="1"
                      Margin="3"
                      HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="False"
                      Style="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Expander Header="Activities"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">Total Results:</Label>
                                <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding PlusActivities.items.length}"/>
                            </Grid>

                            <ListView ItemsSource="{Binding PlusActivities.items}"
                                  BorderThickness="0"
                                  Background="Transparent">
                                <ListView.Template>
                                    <ControlTemplate>
                                        <ItemsPresenter></ItemsPresenter>
                                    </ControlTemplate>
                                </ListView.Template>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Title:</Label>
                                                <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding title}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Verb:</Label>
                                                <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding verb}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Original Owner:</Label>
                                                <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding actor.displayName}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Url:</Label>
                                                <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding url}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Replies:</Label>
                                                <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding pObject.replies.totalItems}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Plusoners:</Label>
                                                <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding pObject.plusoners.totalItems}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Resharers:</Label>
                                                <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding pObject.resharers.totalItems}"/>
                                            </Grid>

                                            <Expander Header="Comments"
                                                  Margin="3"
                                                  Background="White"
                                                  ExpandDirection="Down">
                                                <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                                    <ListView ItemsSource="{Binding Comments}"
                                                              BorderThickness="0"
                                                              Background="Transparent">
                                                        <ListView.Template>
                                                            <ControlTemplate>
                                                                <ItemsPresenter></ItemsPresenter>
                                                            </ControlTemplate>
                                                        </ListView.Template>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Label Grid.Column="0">Owner:</Label>
                                                                        <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding actor.displayName}"/>
                                                                    </Grid>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Label Grid.Column="0">Verb:</Label>
                                                                        <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding verb}"/>
                                                                    </Grid>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Label Grid.Column="0">Plusoners:</Label>
                                                                        <TextBox Grid.Column="1"
                                                     Style="{StaticResource SelectableTextBlock}"
                                                     Text="{Binding plusoners.totalItems}"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

