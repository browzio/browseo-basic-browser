<UserControl x:Class="Browseo.SocialBirdEye.Views.BirdsEyeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Browseo.SocialBirdEye.Views"
             mc:Ignorable="d" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        
        <Grid Margin="5"
              VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <UniformGrid Rows="1">
                <Button Content="Oauth Facebook"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="FacebookOauth" />

                <Button Content="Get Summary"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="FacebookSummary" />

                <!--<Button Content="Get Facebook Pages"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="GetPages" />

                <Button Content="Get My Feed"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="GetFeed" />

                <Button Content="Get Friend Count"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="GetFriendCount" />-->
            </UniformGrid>

            <Grid Grid.IsSharedSizeScope="True"
                  Grid.Row="1"
                  DataContext="{Binding Controller_Facebook}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" SharedSizeGroup="g1" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Text="Friends: " />
                <TextBlock Grid.Column="1"
                           Text="{Binding UserFriendCount}" />

                <TextBlock Grid.Row="1"
                           Text="Pages: " />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding UserPagesList.Count}" />

                <ListView ItemsSource="{Binding UserPagesList}"
                          Grid.Row="2"
                          Grid.ColumnSpan="2"
                          Background="WhiteSmoke"
                          Grid.IsSharedSizeScope="True"
                          ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                          BorderThickness="0,0,0,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="g1" />
                                    <ColumnDefinition Width="*" SharedSizeGroup="g2" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Name: " />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding name}" />

                                <TextBlock Grid.Row="1"
                                           Text="Likes: " />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding fan_count}" />

                                <TextBlock Grid.Row="2"
                                           Text="Talking About: " />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding talking_about_count}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
            </Grid>
        </Grid>

        <GridSplitter ResizeDirection="Columns"
                      Margin="1"
                      VerticalAlignment="Stretch"
                      Grid.Column="0"
                      Grid.RowSpan="2"
                      Width="2"
                      Background="DarkGray" />
        
        <Grid Grid.Column="1"
              VerticalAlignment="Top"
              Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <UniformGrid Rows="1">
                <Button Content="Get Twitter Info"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="TwitterInfo" />
            </UniformGrid>

            <Grid Grid.Row="1"
                  DataContext="{Binding Controller_Twitter}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Expander ExpandDirection="Down"
                          Grid.IsSharedSizeScope="True"
                          Header="Api Keys">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Oauth Token: "
                                   Margin="3" />
                        <TextBox Grid.Column="1"
                                 Width="200"
                                 Margin="3"
                                 Text="{Binding OauthToken}" />

                        <TextBlock Grid.Row="1"
                                   Margin="3"
                                   Text="Oauth Token Secret: " />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Width="200"
                                 Margin="3"
                                 Text="{Binding OauthTokenSecret}" />

                        <TextBlock Grid.Row="2"
                                   Margin="3"
                                   Text="Oauth Consumer Key: " />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Width="200"
                                 Margin="3"
                                 Text="{Binding OauthConsumerKey}" />

                        <TextBlock Grid.Row="3"
                                   Margin="3"
                                   Text="Oauth Consumer Secret: " />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Width="200"
                                 Margin="3"
                                 Text="{Binding OauthConsumerSecret}" />

                        <TextBlock Grid.Row="4"
                                   Margin="3"
                                   Text="Screen Name: " />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Width="200"
                                 Margin="3"
                                 Text="{Binding ScreenName}" />

                        <Button Grid.Row="5"
                                Margin="3"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Right"
                                Content="Save Keys"
                                Command="{Binding OnCommandFromView}"
                                CommandParameter="SaveFile" />
                    </Grid>
                </Expander>

                <StackPanel Grid.Row="1">
                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.name}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Screen Name:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.screen_name}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Location:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.location}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Profile Location:"
                                   Width="100"/>
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.profile_location}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Description:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.description}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Url:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.url}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Followers:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.followers_count}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Friends:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.friends_count}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Listed:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.listed_count}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Favourites:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.favourites_count}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Statuses:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.statuses_count}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Created At:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.created_at}" />
                    </Grid>

                    <Grid Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Lang:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.Lang}" />
                    </Grid>

                    <Grid Grid.Row="1"
                          Grid.IsSharedSizeScope="True"
                          Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Friends:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding TwitterUserInfo.friends_count}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter ResizeDirection="Columns"
                      Margin="1"
                      VerticalAlignment="Stretch"
                      Grid.Column="1"
                      Grid.RowSpan="2"
                      Width="2"
                      Background="DarkGray" />

        <Grid Grid.Column="2"
              VerticalAlignment="Top"
              Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <UniformGrid Rows="1">
                <Button Content="Oauth Instagram"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="OauthInstagram" />

                <Button Content="Get Summary"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="InstagramInfo" />
            </UniformGrid>

            <Grid Grid.Row="1"
                  DataContext="{Binding Controller_Instagram}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Expander ExpandDirection="Down"
                          Grid.IsSharedSizeScope="True"
                          Header="Api Keys">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Facebook App Id: "
                                   Margin="3" />
                        <TextBox Grid.Column="1"
                                 Width="200"
                                 Margin="3"
                                 Text="{Binding FacebookAppId}" />

                        <TextBlock Text="Instagram Buisness Page ID: "
                                   Grid.Row="1"
                                   Margin="3" />
                        <TextBox Grid.Column="1"
                                 Grid.Row="1"
                                 Width="200"
                                 Margin="3"
                                 Text="{Binding InstagramBuisnessPageID}" />

                        <Button Grid.Row="5"
                                Margin="3"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Right"
                                Content="Save Info"
                                Command="{Binding OnCommandFromView}"
                                CommandParameter="SaveFile" />
                    </Grid>
                </Expander>

                <StackPanel Grid.Row="1">
                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Username:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding InstagramUserInfo.username}" />
                    </Grid>

                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Followers:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding InstagramUserInfo.followers_count}" />
                    </Grid>

                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Media:"
                                   Width="100" />
                        <TextBlock Grid.Column="1"
                                   Margin="5,0,0,0"
                                   MaxWidth="200"
                                   TextWrapping="Wrap"
                                   Text="{Binding InstagramUserInfo.media_count}" />
                    </Grid>

                    <Grid Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Profile Views This Week:" />

                        <ListView ItemsSource="{Binding InsightsValuesViews}"
                                  Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  Background="WhiteSmoke"
                                  Grid.IsSharedSizeScope="True"
                                  ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                                  BorderThickness="0,0,0,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"
                                                              SharedSizeGroup="g1" />
                                            <ColumnDefinition Width="*"
                                                              SharedSizeGroup="g2" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="Count: " />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding value}" />

                                        <TextBlock Grid.Row="1"
                                                   Text="Date: " />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding end_time}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Unique Profile Views This Week:" />

                        <ListView ItemsSource="{Binding InsightsValuesViewsUnique}"
                                  Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  Background="WhiteSmoke"
                                  Grid.IsSharedSizeScope="True"
                                  ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                                  BorderThickness="0,0,0,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"
                                                              SharedSizeGroup="g1" />
                                            <ColumnDefinition Width="*"
                                                              SharedSizeGroup="g2" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="Count: " />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding value}" />

                                        <TextBlock Grid.Row="1"
                                                   Text="Date: " />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding end_time}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter ResizeDirection="Columns"
                      Margin="1"
                      VerticalAlignment="Stretch"
                      Grid.Column="2"
                      Grid.RowSpan="2"
                      Width="2"
                      Background="DarkGray" />

        <Grid Grid.Column="3"
              VerticalAlignment="Top"
              Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            
            <UniformGrid Rows="1">
                <Button Content="Oauth Google Apis Project"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="OauthGoogleApis" />

                <Button Content="Recent Activity+"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="GooglePlusSummary" />

                <Button Content="Youtube Channels"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="YoutubeChannels" />
            </UniformGrid>

            <Grid Grid.Row="1"
                  DataContext="{Binding Controller_Google}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Expander ExpandDirection="Down"
                          Grid.IsSharedSizeScope="True"
                          Header="Api Keys">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="g1" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Client ID: "
                                   Margin="3" />
                        <TextBox Grid.Column="1"
                                 Width="200"
                                 Margin="3"
                                 Text="{Binding ClientID}" />

                        <TextBlock Text="Client Secret: "
                                   Grid.Row="1"
                                   Margin="3" />
                        <TextBox Grid.Column="1"
                                 Grid.Row="1"
                                 Width="200"
                                 Margin="3"
                                 Text="{Binding ClientSecret}" />

                        <TextBlock Text="Redirect Url: "
                                   Grid.Row="2"
                                   Margin="3" />
                        <TextBox Grid.Column="1"
                                 Grid.Row="2"
                                 Width="200"
                                 Margin="3"
                                 Text="{Binding RedirectUrl}" />

                        <Button Grid.Row="5"
                                Margin="3"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Right"
                                Content="Save Info"
                                Command="{Binding OnCommandFromView}"
                                CommandParameter="SaveFile" />
                    </Grid>
                </Expander>

                <TextBlock Text="Activies+:" Grid.Row="1" />
                <ListView ItemsSource="{Binding PlusActivities}"
                          SelectedItem="{Binding SelectedPlusActivitie}"
                          Grid.Row="2"
                          Grid.ColumnSpan="2"
                          Background="WhiteSmoke"
                          Grid.IsSharedSizeScope="True"
                          ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                          BorderThickness="0,0,0,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"
                                                      SharedSizeGroup="g1" />
                                    <ColumnDefinition Width="*"
                                                      SharedSizeGroup="g2" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="title: " />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding title}" />

                                <TextBlock Grid.Row="1"
                                           Text="published: " />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding published}" />

                                <TextBlock Grid.Row="2"
                                           Text="updated: " />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding updated}" />

                                <TextBlock Grid.Row="3"
                                           Text="url: " />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding url}" />

                                <TextBlock Grid.Row="4"
                                           Text="Type: " />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Text="{Binding verb}" />

                                <TextBlock Grid.Row="5"
                                           Text="By: " />
                                <TextBlock Grid.Row="5"
                                           Grid.Column="1"
                                           Text="{Binding actor.displayName}" />

                                <TextBlock Grid.Row="6"
