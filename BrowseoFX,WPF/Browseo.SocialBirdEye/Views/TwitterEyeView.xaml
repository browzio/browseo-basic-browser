<UserControl x:Class="BrowseoFX_WPF.Browseo.SocialBirdEye.Views.TwitterEyeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrowseoFX_WPF.Browseo.SocialBirdEye.Views"
             xmlns:converters="clr-namespace:Organiser.Common.Converters;assembly=Organiser.Common"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="350">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:NullToVisibleConverter x:Key="nullToVis" />

            <DataTemplate x:Key="tweetTimelinesTemplate">
                <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                    <Grid Visibility="{Binding Path=created_at, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Created At:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding created_at}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=text, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Text:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding text}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=retweet_count, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Retweet Count:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding retweet_count}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=favorite_count, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Favorite Count:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding favorite_count}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=user.name, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">By User:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding user.name}"/>
                    </Grid>


                    <Grid Visibility="{Binding Path=user.friends_count, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Followers:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding user.followers_count}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=pins, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Friends:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding user.friends_count}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=user.listed_count, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Listed:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding user.listed_count}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=user.favourites_count, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Favourites:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding user.favourites_count}"/>
                    </Grid>

                    <Grid Visibility="{Binding Path=user.statuses_count, Converter={StaticResource nullToVis}, ConverterParameter=NOT}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Statuses:</Label>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding user.statuses_count}"/>
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#413f41"
          DataContext="{Binding TwitterApisController}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button ToolTip="Api Key Settings" 
                    HorizontalAlignment="Left"
                    Style="{StaticResource FlatbtnStyle}"
                    Command="{Binding OnCommandFromView}"
                    CommandParameter="SetApiKeys">
                <Image Source="pack://application:,,,/Organiser.Common;component/Image/settings2.png" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="1"
              Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <UniformGrid Rows="1">
                <Button Content="Analyze" 
                        Background="#dd2c28"
                        TextElement.Foreground="White"
                        Style="{StaticResource FlatbtnStyle}"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="AnalyzeAllData" />
            </UniformGrid>

            <ScrollViewer Grid.Row="1"
                          Margin="3"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="False"
                          Style="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Expander Header="User Info"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">Created at:</Label>
                                <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding UserInfo.created_at}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">Followers:</Label>
                                <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding UserInfo.followers_count}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">Friends:</Label>
                                <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding UserInfo.friends_count}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">Listed:</Label>
                                <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding UserInfo.listed_count}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">Favourites:</Label>
                                <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding UserInfo.favourites_count}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">Statuses:</Label>
                                <TextBox Grid.Column="1"
                                     Style="{StaticResource SelectableTextBlock}"
                                     Text="{Binding UserInfo.statuses_count}"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="User Timeline"
                              Grid.Row="1"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding UserTimelines}"
                                      ItemTemplate="{StaticResource tweetTimelinesTemplate}">
                                <ListView.Template>
                                    <ControlTemplate>
                                        <ItemsPresenter></ItemsPresenter>
                                    </ControlTemplate>
                                </ListView.Template>
                            </ListView>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Home Timeline"
                              Grid.Row="2"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding HomeTimelines}"
                                      ItemTemplate="{StaticResource tweetTimelinesTemplate}">
                                <ListView.Template>
                                    <ControlTemplate>
                                        <ItemsPresenter></ItemsPresenter>
                                    </ControlTemplate>
                                </ListView.Template>
                            </ListView>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Mentions Timeline"
                              Grid.Row="3"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding MentionsTimelines}"
                                      ItemTemplate="{StaticResource tweetTimelinesTemplate}">
                                <ListView.Template>
                                    <ControlTemplate>
                                        <ItemsPresenter></ItemsPresenter>
                                    </ControlTemplate>
                                </ListView.Template>
                            </ListView>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Trending"
                              Grid.Row="4"
                              Margin="3"
                              Background="White"
                              ExpandDirection="Down">
                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                            <ListView ItemsSource="{Binding TweetTrends}">
                                <ListView.Template>
                                    <ControlTemplate>
                                        <ItemsPresenter></ItemsPresenter>
                                    </ControlTemplate>
                                </ListView.Template>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">As Of:</Label>
                                                <TextBox Grid.Column="1"
                                                         Style="{StaticResource SelectableTextBlock}"
                                                         Text="{Binding as_of}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0">Created at:</Label>
                                                <TextBox Grid.Column="1"
                                                         Style="{StaticResource SelectableTextBlock}"
                                                         Text="{Binding created_at}"/>
                                            </Grid>

                                            <ListView ItemsSource="{Binding trends}">
                                                <ListView.Template>
                                                    <ControlTemplate>
                                                        <ItemsPresenter></ItemsPresenter>
                                                    </ControlTemplate>
                                                </ListView.Template>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Label Grid.Column="0">Name:</Label>
                                                                <TextBox Grid.Column="1"
                                                                         Style="{StaticResource SelectableTextBlock}"
                                                                         Text="{Binding name}"/>
                                                            </Grid>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Label Grid.Column="0">Url:</Label>
                                                                <TextBox Grid.Column="1"
                                                                         Style="{StaticResource SelectableTextBlock}"
                                                                         Text="{Binding url}"/>
                                                            </Grid>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Label Grid.Column="0">Tweet Volume:</Label>
                                                                <TextBox Grid.Column="1"
                                                                         Style="{StaticResource SelectableTextBlock}"
                                                                         Text="{Binding tweet_volume}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
