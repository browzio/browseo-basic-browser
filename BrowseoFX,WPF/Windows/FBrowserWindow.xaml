<Window x:Class="BrowseoFX_WPF.Windows.FBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrowseoFX_WPF.Windows"
        xmlns:interop="clr-namespace:Microsoft.DwayneNeed.Interop;assembly=Microsoft.DwayneNeed"
        xmlns:mdi="clr-namespace:Microsoft.DwayneNeed.MDI;assembly=Microsoft.DwayneNeed"
        mc:Ignorable="d">
    <Grid>
        <interop:AirspaceDecorator AirspaceMode="None"
                                       Grid.Row="1"
                                       IsInputRedirectionEnabled="True"
                                       IsOutputRedirectionEnabled="True">
                <interop:AirspaceDecorator.Background>
                    <VisualBrush TileMode="Tile"
                                 Viewport="0,0,150,150"
                                 ViewportUnits="Absolute"
                                 Opacity="0.05">
                        <VisualBrush.Visual>
                            <Border BorderBrush="#FFF0F0F0"
                                    BorderThickness="4">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock FontWeight="Bold"
                                               Margin="0,0,0,10"
                                               FontSize="16"
                                               Text="Brow·SEO" />
                                    <Image Source="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico"
                                           Stretch="Fill"
                                           Margin="0,0,0,-80"
                                           Width="45"
                                           Height="45" />
                                </StackPanel>
                            </Border>
                        </VisualBrush.Visual>
                        <VisualBrush.Transform>
                            <RotateTransform Angle="-22.5" />
                        </VisualBrush.Transform>
                    </VisualBrush>
                </interop:AirspaceDecorator.Background>
                <Grid Name="host"
                      Grid.Row="1"
                      HorizontalAlignment="Stretch">
                    <!--<ContentPresenter 
                                  Grid.Row="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />-->
                </Grid>
            </interop:AirspaceDecorator>
    </Grid>
</Window>
