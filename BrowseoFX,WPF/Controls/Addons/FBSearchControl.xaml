<UserControl x:Class="BrowseoFX_WPF.Controls.Addons.FBSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrowseoFX_WPF.Controls.Addons"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Grid HorizontalAlignment="Left"
              VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!--#region saved usernames-->
            <Grid Margin="5"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <TextBlock Text="Username:"
                       VerticalAlignment="Center"/>
                <TextBox Text="{Binding UsernameInput}"
                         VerticalAlignment="Center"
                     Grid.Column="1"
                     MinWidth="150"
                     MaxWidth="150"
                     Margin="3"
                     />
                
                <Button Content="Save"
                    Grid.Row="1"
                    Margin="0"
                    VerticalAlignment="Center"
                    Command="{Binding OnCommandFromView}" 
                    CommandParameter="SAVE" />

                <Button Grid.Row="2"
                        HorizontalAlignment="Left" 
                        Margin="0,5,0,0"
                        Style="{StaticResource FlatbtnStyle}"
                        Command="{Binding OnCommandFromView}"
                        CommandParameter="Refresh">
                    <Image Source="pack://application:,,,/Organiser.Common;component/Image/refresh.png"  />
                </Button>
            </Grid>
            <!--#endregion-->

            <!--#region saved usernames list-->
            <Grid Grid.Row="1"
                  VerticalAlignment="Top"
                  Margin="5,2,5,5">
                <ScrollViewer Name="svSavedProjects">
                    <ListView ItemsSource="{Binding ProjectsSavedUsernamesList}" 
                              SelectedItem="{Binding SelectedProjectsSavedUsernamesList}"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding ProjectName}"
                                          PreviewMouseWheel="Expander_PreviewMouseWheel"
                                      ExpandDirection="Down">
                                    <ItemsControl Grid.Row="1"
                                          Grid.IsSharedSizeScope="True"
                                          ItemsSource="{Binding SavedData}"
                                          BorderThickness="0" >
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" SharedSizeGroup="s1" />
                                                        <ColumnDefinition Width="2*" SharedSizeGroup="s2" />
                                                        <ColumnDefinition Width="*" SharedSizeGroup="s2" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Text="{Binding Username}"
                                                         IsReadOnly="True" 
                                                         BorderThickness="0" />

                                                    <TextBox Text="{Binding ID}"
                                                         Grid.Column="1"
                                                         IsReadOnly="True" 
                                                         BorderThickness="0" />

                                                    <Button Width="15"
                                                        Height="15"
                                                        Grid.Column="2"
                                                        Command="{Binding OnCommandFromView}"
                                                        Style="{DynamicResource FlatbtnStyle}">
                                                        <Image HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Stretch="None"
                                                           Source="pack://application:,,,/Organiser.Common;component/Image/close.png" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Delete Saved Folder"
                                          Command="{Binding OnCommandFromView}" 
                                          CommandParameter="DeleteProjectFolder" 
                                          />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </ScrollViewer>
                
                
                
            </Grid>
            <!--#endregion-->

            <!--#region search options--><!--
            <Grid Grid.Row="2"
              VerticalAlignment="Top"
                  Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Search"
                           FontWeight="Medium"
                           FontSize="16"
                           Margin="5"
                           />

                --><!--#region single--><!--
                <Grid Grid.Row="1"
                      Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Single Person"
                           FontWeight="Medium"
                           FontSize="14"
                           Margin="5"
                           Grid.Row="0"
                           />

                    <ComboBox ItemsSource="{Binding SingleOptionsList}" 
                              SelectedItem="{Binding SelectedSingleOption}" 
                              DisplayMemberPath="Key"
                              Grid.Column="0"
                              Grid.Row="1"
                              MinWidth="100"
                             />
                    <CheckBox Content="Friends Of" 
                              IsChecked="{Binding IsFriendsOfChecked}"
                              Grid.Row="1"
                              Grid.Column="1"
                              />
                    <ComboBox ItemsSource="{Binding SavedUsernamesList}" 
                              SelectedItem="{Binding SelectedSavedUsernameSingle}" 
                              DisplayMemberPath="Username"
                              Grid.Column="2"
                              Grid.Row="1"
                              MinWidth="100"
                              />

                    <Button Content="Search"
                            Command="{Binding OnCommandFromView}" 
                            CommandParameter="SearchSINGLE"
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            Margin="2"
                            />

                </Grid>
                --><!--#endregion-->

                <!--#region inCommon--><!--
                <Grid Grid.Row="2"
                      Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="What do they have in common?"
                           FontWeight="Medium"
                           FontSize="14"
                           Margin="5"
                           Grid.Row="0"
                           />

                    <ComboBox ItemsSource="{Binding InCommonOptionsList}" 
                              SelectedItem="{Binding SelectedInCommonOptions}" 
                              DisplayMemberPath="Key"
                              Grid.Column="0"
                              Grid.Row="1"
                              MinWidth="100"
                              />

                    <ComboBox ItemsSource="{Binding SavedUsernamesList}" 
                              SelectedItem="{Binding SelectedSavedUsernameInCommonA}" 
                              DisplayMemberPath="Username"
                              Grid.Column="1"
                              Grid.Row="1"
                              MinWidth="100"
                              />

                    <ComboBox ItemsSource="{Binding SavedUsernamesList}" 
                              SelectedItem="{Binding SelectedSavedUsernameInCommonB}" 
                              DisplayMemberPath="Username"
                              Grid.Column="2"
                              Grid.Row="1"
                              MinWidth="100"
                              />

                    <Button Content="Search"
                            Command="{Binding OnCommandFromView}" 
                            CommandParameter="SearchINCOMMON"
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            Margin="2"
                            />
                </Grid>
                --><!--#endregion-->

                <!--#region wall--><!--
                <Grid Grid.Row="3"
                      Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="All wall postings"
                           FontWeight="Medium"
                           FontSize="14"
                           Margin="5"
                           Grid.Row="0"
                           />

                    <TextBox Text="{Binding WallSearchText}" 
                             VerticalAlignment="Center"
                             Grid.Column="0"
                             Grid.Row="1"
                             MinWidth="150"
                             MaxWidth="150"
                             />
                    <Button Content="Search Any"
                            Command="{Binding OnCommandFromView}" 
                            CommandParameter="SearchWALL"
                            Grid.Column="0"
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            Margin="2"
                            />

                    <TextBlock Text="made by" 
                               Grid.Column="0"
                               Grid.Row="3"
                               VerticalAlignment="Center"
                               Margin="3"
                               />

                    <ComboBox ItemsSource="{Binding SavedUsernamesList}" 
                              SelectedItem="{Binding SelectedSavedUsernameWall}" 
                              DisplayMemberPath="Username"
                              Grid.Column="1"
                              Grid.Row="3"
                              MinWidth="100"
                              />

                    <StackPanel Orientation="Horizontal"
                                Grid.Row="2">

                    </StackPanel>

                    <Button Content="Search"
                            Command="{Binding OnCommandFromView}" 
                            CommandParameter="SearchWALLUSER"
                            HorizontalAlignment="Left"
                            Margin="2"
                            Grid.Row="4"
                            />


                </Grid>
                --><!--#endregion-->

                <!--#region place--><!--
                <Grid Grid.Row="4"
                      Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Who went where?"
                           FontWeight="Medium"
                           FontSize="14"
                           Margin="5"
                           Grid.Row="0"
                           />

                    <TextBlock Text="Which people who live in"
                               VerticalAlignment="Center"
                               Margin="3"
                               Grid.Row="1"
                               />

                    <TextBox Text="{Binding PlaceSearchTextA}" 
                             VerticalAlignment="Center"
                             Grid.Column="1"
                             Grid.Row="1"
                             MinWidth="150"
                             MaxWidth="150"
                             />

                    <TextBlock Text="visited" 
                               Grid.Column="2"
                               Grid.Row="1"
                               VerticalAlignment="Center"
                               Margin="3"
                               />

                    <TextBox Text="{Binding PlaceSearchTextB}" 
                             VerticalAlignment="Center"
                             Grid.Column="3"
                             Grid.Row="1"
                             MinWidth="150"
                             MaxWidth="150"
                             />
                    
                    <Button Content="Search"
                            Command="{Binding OnCommandFromView}" 
                            CommandParameter="SearchPLACE"
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            Margin="2"
                            />
                </Grid>
                --><!--#endregion--><!--
            </Grid>
            --><!--#endregion-->

            <Grid Grid.Row="4"
                  Margin="5">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Select Username"
                           FontWeight="Medium"
                           FontSize="14"
                           Margin="0,5"
                           Grid.Row="0"
                           />

                        <Border x:Name="a" 
                            Grid.Column="0"
                            Grid.Row="2"
                            />
                        <ComboBox ItemsSource="{Binding SavedUsernamesList}" 
                              SelectedItem="{Binding SelectedSavedUsernameSearch}" 
                              DisplayMemberPath="Username"
                              Grid.Column="1"
                              Grid.Row="0"
                              MinWidth="100"
                             Width="{Binding ActualWidth, ElementName=a}"
                              />
                    </Grid>

                    <TextBlock Text="Filter by keywords"
                           FontWeight="Medium"
                           FontSize="14"
                           Margin="0,5"
                           Grid.Row="1"
                           />

                    <Border x:Name="b" 
                            Grid.Column="0"
                            Grid.Row="2"
                            />
                    <TextBox Text="{Binding KeywordSearchText}" 
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             Grid.Column="0"
                             Margin="0,5"
                             Grid.Row="2"
                             Width="{Binding ActualWidth, ElementName=b}"
                             />

                    <WrapPanel Grid.Row="3"
                               Margin="0,5">
                        <Button Content="Search Posts"
                            Command="{Binding OnCommandFromView}" 
                            CommandParameter="SearchPosts"
                            HorizontalAlignment="Left"
                            Width="100"
                            />

                        <Button Content="Search Photos"
                            Command="{Binding OnCommandFromView}" 
                            CommandParameter="SearchPhotos"
                            HorizontalAlignment="Left"
                            Width="100"
                            />

                        <Button Content="Search Top"
                            Command="{Binding OnCommandFromView}" 
                            CommandParameter="SearchTop"
                            HorizontalAlignment="Left"
                            Width="100"
                            />
                    </WrapPanel>
                    
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
