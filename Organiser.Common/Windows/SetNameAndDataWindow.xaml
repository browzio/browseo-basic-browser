<Window x:Class="Organiser.Common.Windows.SetNameAndDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico"
        Title="" Topmost="True" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <StackPanel>
        <TextBlock Name="tblockInfo" Text="" Margin="5" x:FieldModifier="public" />
        <TextBox Name="tbInputText" Margin="5" x:FieldModifier="public" PreviewKeyDown="tbInputText_PreviewKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Ok" Margin="5" Click="Button_Click" Width="75" Style="{StaticResource FlatbtnStyle}" />
            <Button Content="Cancel" Margin="5" Click="Button_Click_1" Width="75" Style="{StaticResource FlatbtnStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
