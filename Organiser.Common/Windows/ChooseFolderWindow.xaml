<Window x:Class="Organiser.Common.Windows.ChooseFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico"
        WindowStartupLocation="CenterScreen"
        Title="Choose Folder" ResizeMode="NoResize" SizeToContent="WidthAndHeight" SnapsToDevicePixels="True" MaxHeight="650">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button Content="Select All" Width="100" Margin="5" Command="{Binding SelectFolderSelect_Click}" CommandParameter="All" Style="{StaticResource FlatbtnStyle}" />
            <Button Content="Select None" Width="100" Margin="5" Command="{Binding SelectFolderSelect_Click}" CommandParameter="None" Style="{StaticResource FlatbtnStyle}" />
        </StackPanel>
        
        <ListBox Grid.Row="1" Name="lstItems" x:FieldModifier="public" IsSynchronizedWithCurrentItem="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" MaxWidth="200" Margin="5" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3">
            <Button Content="Ok" Margin="5" Click="Button_Click" Style="{StaticResource FlatbtnStyle}" />
            <Button Content="Load All Projects" Margin="5" Name="btnLoadAllProjects" Visibility="Collapsed" x:FieldModifier="public" Click="btnLoadAllProjects_Click" Style="{StaticResource FlatbtnStyle}" />
        </StackPanel>

    </Grid>
</Window>
