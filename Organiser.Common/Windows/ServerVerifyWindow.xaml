<Window x:Class="Organiser.Common.Windows.ServerVerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Organiser.Common.Windows"
        mc:Ignorable="d"
        Title="Authentication Required" SizeToContent="Height" ResizeMode="NoResize" Width="500" 
        Icon="/Organiser.Common;component/Image/browseo (1).ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:FieldModifier="public" TextWrapping="Wrap" Name="tBlockinfo" Margin="5" />
        <StackPanel Grid.Row="1">
            <DockPanel Margin="5">
                <TextBlock Text="Username: " Width="65" />
                <TextBox Name="tbUsername" x:FieldModifier="public"  />
            </DockPanel>
            <DockPanel Margin="5">
                <TextBlock Text="Password: " Width="65" />
                <TextBox Name="tbPassword" x:FieldModifier="public"  />
            </DockPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center">
            <Button Content="OK" Width="70" Margin="5" Name="btnOk" Click="btnOk_Click" Style="{StaticResource FlatbtnStyle}" />
            <Button Content="Cancel" Width="70" Margin="5" Name="btnCancel" Click="btnCancel_Click" Style="{StaticResource FlatbtnStyle}" />
        </StackPanel>
    </Grid>
</Window>
