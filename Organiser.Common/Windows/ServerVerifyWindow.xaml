<Window x:Class="Organiser.Common.Windows.ServerVerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Organiser.Common.Windows"
        mc:Ignorable="d"
        Title="Authentication Required" SizeToContent="Height" ResizeMode="NoResize" Width="500" 
        Icon="/Organiser.Common;component/Image/browseo (1).ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <!--#region flat btns-->
        <!-- Flat Button Style -->
        <Color x:Key="DefaultColor" A="255" R="240" G ="240" B="240"/>
        <Color x:Key="HighlightColor" A="255" R="229" G ="229" B="229"/>
        <Color x:Key="PressedColor" A="255" R="215" G ="215" B="215"/>

        <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource DefaultColor}" />
        <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
        <SolidColorBrush x:Key="BtnPressedBrush" Color="#FF8B8B8B" />

        <Style TargetType="Border" x:Key="innerShaddowBorder">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="Margin" Value="-2" />
            <Setter Property="Border.Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="5" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.6" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="0">
                            <ContentControl Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
                    <Setter Property="Border.Background" Value="Transparent" />
                    <Setter Property="Border.BorderThickness" Value="1" />
                    <Setter Property="Border.BorderBrush" Value="{StaticResource BtnPressedBrush}" />
                    <Setter Property="Border.Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="1.5" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- End Flat Button Style -->
        <!--#endregion-->
    </Window.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:FieldModifier="public" TextWrapping="Wrap" Name="tBlockinfo" Margin="5" />
        <StackPanel Grid.Row="1">
            <DockPanel Margin="5">
                <TextBlock Text="Username: " Width="65" />
                <TextBox Name="tbUsername" x:FieldModifier="public"  />
            </DockPanel>
            <DockPanel Margin="5">
                <TextBlock Text="Password: " Width="65" />
                <TextBox Name="tbPassword" x:FieldModifier="public"  />
            </DockPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center">
            <Button Content="OK" Width="70" Margin="5" Name="btnOk" Click="btnOk_Click" />
            <Button Content="Cancel" Width="70" Margin="5" Name="btnCancel" Click="btnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
