<Window x:Class="Organiser.Common.Windows.RssFeedsLinksMultiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="One Link Per Line" Height="300" Width="500" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Icon="/Organiser.Common;component/Image/browseo (1).ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <TextBox Name="tbInputedText" AcceptsReturn="True" x:FieldModifier="public" VerticalScrollBarVisibility="Auto" FontFamily="Verdana" FontSize="15" />
        <UniformGrid Grid.Row="1" Rows="1">
            <Button Content="OK" 
                    Click="Button_Click"
                    x:Name="buttonLeft"
                    x:FieldModifier="public"
                    Style="{StaticResource FlatbtnStyle}" />
            <Button Content="Cancel"
                    Click="buttonRight_Click"
                    Visibility="Collapsed"
                    x:Name="buttonRight"
                    x:FieldModifier="public"
                    Style="{StaticResource FlatbtnStyle}" />
        </UniformGrid>
    </Grid>
</Window>
