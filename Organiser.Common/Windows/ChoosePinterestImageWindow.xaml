<Window x:Class="BrowserHost.Windows.ChoosePinterestImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico"
        Title="Choose Image" Height="500" Width="500" WindowStartupLocation="CenterScreen" Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Content="&lt;" Width="30" Style="{StaticResource FlatbtnStyle}" Click="btnScrollLeft_Click" Height="70" />

            <ListBox x:Name="list" Grid.Column="1" 
                     Width="400"
                     Height="400"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ItemsSource="{Binding WebPageImages}" SelectedIndex="{Binding SLImageLink}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                            <Image Source="{Binding ImgUrl}" Width="405" Height="405" Stretch="Uniform" StretchDirection="DownOnly" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content=">" Width="30" Style="{StaticResource FlatbtnStyle}" Click="btnScrollRight_Click" Grid.Column="2" Height="70" />
        </Grid>

        <Button Content="Select" Grid.Row="1" Click="Button_Click" Margin="5">
        </Button>
    </Grid>
</Window>
