                    xmlns:local="clr-namespace:Organiser.Common"
                    xmlns:extensions="clr-namespace:Organiser.Common.Extensions"
                    xmlns:converters="clr-namespace:Organiser.Common.Converters"
                    xmlns:localControls="clr-namespace:Organiser.Common.Controlls">

    <BooleanToVisibilityConverter  x:Key="BooleanToVisibilityConverter" />
    <converters:TextEmptyToVisibleConverter x:Key="TextEmptyToVisibleConverter" />
    <converters:NullToVisibleConverter x:Key="NullToVisibleConverter" />
    <converters:StringTomageSourceConverter x:Key="StringTomageSourceConverter" />
    <converters:EmptyListToVisibleConverter x:Key="EmptyListToVisibleConverter" />
    <converters:GreaterthenToVisibleConverter x:Key="GreaterthenToVisibleConverter" />
    <!--<extensions:Int32Extension x:Key="Int32Extension" />-->

    <SolidColorBrush Color="#5c5c5c" x:Key="text_fg"/>
    <SolidColorBrush x:Key="StandardBorderBrush" Color="DarkGray"></SolidColorBrush>
    <SolidColorBrush x:Key="StandardBrush" Color="WhiteSmoke"></SolidColorBrush>
    <SolidColorBrush x:Key="PressedBrush" Color="Black"></SolidColorBrush>
    <SolidColorBrush x:Key="HoverBrush" Color="Gray"></SolidColorBrush>
    <SolidColorBrush x:Key="GlyphBrush" Color="#333333"></SolidColorBrush>
    <SolidColorBrush x:Key="ThumbBrush" Color="#FFB4B4B4"></SolidColorBrush>
    <Color x:Key="DefaultColor" A="255" R="240" G ="240" B="240"/>
    <Color x:Key="HighlightColor" A="255" R="229" G ="229" B="229"/>
    <Color x:Key="PressedColor" A="255" R="215" G ="215" B="215"/>

    <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource DefaultColor}" />
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="BtnPressedBrush" Color="#FF8B8B8B" />

    <SolidColorBrush x:Key="brushWatermarkBackground" Color="White" />
    <SolidColorBrush x:Key="brushWatermarkForeground" Color="LightSteelBlue" />
    <SolidColorBrush x:Key="brushWatermarkBorder" Color="Indigo" />
    
    <Style x:Key="EntryFieldStyle" TargetType="Grid" >
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0" />
    </Style>

    <Style  TargetType="{x:Type TextBox}" x:Key="TextboxGray">
        <Setter Property="Background" Value="#eeeeee"/>
        <Setter Property="Foreground" Value="#5c5c5c"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="true"/>
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bd" Height="26" Background="{TemplateBinding Background}"   SnapsToDevicePixels="true">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,0,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Name="linkStyle" TargetType="{x:Type TextBlock}" x:Key="tbLinkStyle">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="Foreground" Value="#558aed" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Trigger>
        </Style.Triggers>
        <!--<Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Height="25" Background="Transparent" x:Name="Border">
