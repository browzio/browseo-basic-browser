                    </Button.Style>-->
                </Button>
            </UniformGrid>

            <ListView Grid.Row="2" ItemsSource="{Binding ImportedPrjects}" BorderThickness="0" Margin="5">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <GridSplitter ResizeDirection="Columns"
                      Margin="1"
                      VerticalAlignment="Stretch"
                      Grid.Column="1"
                      Width="1" 
                      Background="DarkGray" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Run Settings" Grid.ColumnSpan="2" FontSize="16" Margin="10" />

            <TextBlock Text="Min Times To Play Each Macro" Margin="5" Grid.Row="1" />
            <TextBox Text="{Binding TimesToPlay, UpdateSourceTrigger=PropertyChanged}" Margin="5" Grid.Row="1" Grid.Column="1" />

            <TextBlock Text="Max Times To Play Each Macro" Margin="5" Grid.Row="2" />
            <TextBox Text="{Binding TimesToPlayMax}" Margin="5" Grid.Row="2" Grid.Column="1" />

            <TextBlock Text="Close Window On Complete" Margin="5" Grid.Row="3" />
            <CheckBox IsChecked="{Binding CloseOnComplete}" Margin="5" Grid.Row="3" Grid.Column="1" />

            <TextBlock Text="Macros In Seperate Window" Margin="5" Grid.Row="4" ToolTip="Each project still runs in a seperate window when unchecked. When checked each macro will also have a seperate window." />
            <CheckBox IsChecked="{Binding EachOnSeperateProcessChecked}" Margin="5" Grid.Row="4" Grid.Column="1" />

            <TextBlock Text="Data" Grid.Row="5" Margin="5" />
            <TextBox Text="{Binding DataSource}" Margin="5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Grid.Row="5" Grid.Column="1" />

            <Button Content="Run" Grid.Row="6" Grid.ColumnSpan="2" HorizontalAlignment="Right" MinWidth="50" Margin="5"
                    Command="{Binding OnCommandFromView}" CommandParameter="Run" />
        </Grid>
    </Grid>
</UserControl>
