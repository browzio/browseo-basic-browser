                                                    <GradientStop Color="#4b87c4" Offset="0.7"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentControl Content="{TemplateBinding Content}"
                                                        HorizontalAlignment="Center" 
                                                        Margin="5,0,5,2"
