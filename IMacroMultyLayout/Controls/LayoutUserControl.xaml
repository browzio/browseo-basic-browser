                                                        TextElement.Foreground="White">
                                                --><!--<ContentControl.Effect>
                                <DropShadowEffect BlurRadius="2" ShadowDepth="0.7" Color="Black" Direction="290" />
                            </ContentControl.Effect>--><!--
                                            </ContentControl>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush EndPoint="0,1.5" StartPoint="0,0">
                                                            <GradientStop Color="#5ea9f5" Offset="0.6"/>
