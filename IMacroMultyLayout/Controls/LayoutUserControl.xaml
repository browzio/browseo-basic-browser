                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>-->
                </Button>
            </UniformGrid>

            <ListView Grid.Row="2" ItemsSource="{Binding ImportedPrjects}" BorderThickness="0" Margin="5">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <GridSplitter ResizeDirection="Columns"
                      Margin="1"
                      VerticalAlignment="Stretch"
                      Grid.Column="1"
                      Width="1" 
                      Background="DarkGray" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Run Settings" Grid.ColumnSpan="2" FontSize="16" Margin="10" />

            <TextBlock Text="Min Times To Play Each Macro" Margin="5" Grid.Row="1" />
            <TextBox Text="{Binding TimesToPlay, UpdateSourceTrigger=PropertyChanged}" Margin="5" Grid.Row="1" Grid.Column="1" BorderThickness="0" />

            <TextBlock Text="Max Times To Play Each Macro" Margin="5" Grid.Row="2" />
            <TextBox Text="{Binding TimesToPlayMax}" Margin="5" Grid.Row="2" Grid.Column="1" BorderThickness="0" />

            <TextBlock Text="Min Wait Time In Seconds Between Each Run" Margin="5" Grid.Row="3" />
            <TextBox Text="{Binding MinWaitTimeBetweenLaunches}" Margin="5" Grid.Row="3" Grid.Column="1" BorderThickness="0" />

            <TextBlock Text="Max Wait Time In Seconds Between Each Run" Margin="5" Grid.Row="4" />
            <TextBox Text="{Binding MaxWaitTimeBetweenLaunches}" Margin="5" Grid.Row="4" Grid.Column="1" BorderThickness="0" />

            <TextBlock Text="Close Window On Complete" Margin="5" Grid.Row="5" />
            <CheckBox IsChecked="{Binding CloseOnComplete}" Margin="5" Grid.Row="5" Grid.Column="1" />

            <TextBlock Text="Macros In Seperate Window" Margin="5" Grid.Row="6" ToolTip="Each project still runs in a seperate window when unchecked. When checked each macro will also have a seperate window." />
            <CheckBox IsChecked="{Binding EachOnSeperateProcessChecked}" Margin="6" Grid.Row="6" Grid.Column="1" />

            <Grid Grid.ColumnSpan="2" Grid.Row="7" Margin="5" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Datasource Settings" Grid.ColumnSpan="10" FontSize="14"  />

                <!--<TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,0,3,0" Text="Start Line:" />
                <TextBox   Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" MinWidth="25" Text="{Binding DatasourceSettingsStartLine}" />-->

                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,2,0"  Text="Data Line Increments Per Project:"/>
                <TextBox   Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,3,0" Width="25" Text="{Binding DatasourceSettingsEndLine}" BorderThickness="0" />
                <Button    Grid.Row="1" Grid.Column="4" Content="Apply" 
                           Command="{Binding OnCommandFromView}" CommandParameter="Apply" />

                <UniformGrid Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="10" Rows="1" Margin="0,3,0,3">
                    <Button    Grid.Row="2" Grid.Column="2" Content="Use All Lines" Margin="0,0,0,0" 
                           Command="{Binding OnCommandFromView}" CommandParameter="UseAll"
                               ToolTip="Uses all lines in the data on all projects."/>
                    <Button    Grid.Row="2" Grid.Column="3" Content="Randomize" Margin="4,0,0,0" 
                           Command="{Binding OnCommandFromView}" CommandParameter="Random" 
                               ToolTip="Randomizes the lines in the data with the projects below in selected increments and will also not use the same lines in the same project."/>
                    <Button    Grid.Row="2" Grid.Column="4" Content="Shared Random" Margin="4,0,0,0" 
                           Command="{Binding OnCommandFromView}" CommandParameter="SharedRandom"
                               ToolTip="Randomizes the data in the increments selected but may also overlap into other projects."/>
                </UniformGrid>
            </Grid>

            <Grid Grid.ColumnSpan="2" Grid.Row="8" Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ListView Grid.Column="0" Grid.Row="3" Margin="4" ItemsSource="{Binding CheckedProjects}" BorderThickness="0" Grid.IsSharedSizeScope="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="g1" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" MinWidth="20" SharedSizeGroup="g2"/>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" MinWidth="20" SharedSizeGroup="g3"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="1" Text="{Binding Name}" />
                                <TextBlock Margin="1" Text="From:" Grid.Column="1" />
                                <TextBox   Margin="1" Text="{Binding DataSourceLinesFrom}" Grid.Column="2" />
                                <TextBlock Margin="1" Text="To:" Grid.Column="3" />
                                <TextBox   Margin="1" Text="{Binding DataSourceLinesTo}"  Grid.Column="4" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!--<GridSplitter ResizeDirection="Rows"
                          Margin="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Grid.ColumnSpan="2" 
                          Grid.Row="7"
                          Height="1" 
                          Background="DarkGray" />-->
                <Grid Grid.Row="7" Margin="5" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Data"/>
                    <TextBlock Grid.Row="1">
                    <Run Text="Total Lines:" />
                    <Run Text="{Binding DataLinesTotal}" />
                    </TextBlock>
                </Grid>

                <TextBox Grid.Row="7" Grid.Column="2" Margin="5" BorderThickness="0"
                    Text="{Binding DataSource, UpdateSourceTrigger=PropertyChanged}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
            </Grid>

            <Grid Grid.Row="9" Grid.ColumnSpan="2" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Content="Stop"  MinWidth="50" Margin="5" IsEnabled="{Binding Running}"
                        Command="{Binding OnCommandFromView}" CommandParameter="Stop" />
                <Button Content="Run"  MinWidth="50" Margin="5" Grid.Column="1"
                        Command="{Binding OnCommandFromView}" CommandParameter="Run" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
