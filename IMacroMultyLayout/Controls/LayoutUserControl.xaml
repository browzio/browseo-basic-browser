<UserControl x:Class="IMacroMultyLayout.Controls.LayoutUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IMacroMultyLayout.Controls"
             xmlns:commonControls="clr-namespace:Organiser.Common.Controlls;assembly=Organiser.Common"
             mc:Ignorable="d" Background="WhiteSmoke">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid MinWidth="300" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Macros" Grid.ColumnSpan="2" FontSize="16" Margin="10" />
            <Button Grid.Row="1" HorizontalAlignment="Right" Margin="5"
                    Command="{Binding OnCommandFromView}" CommandParameter="MacrosReload">
                <Image Source="pack://application:,,,/Organiser.Common;component/Image/refresh.png"  />
            </Button>
            <commonControls:TrvMacrosUserControl Grid.Row="2" Margin="5" DataContext="{Binding MacroMangerImpl}"  />
        </Grid>
        
        <GridSplitter ResizeDirection="Columns"
                      Margin="1"
                      VerticalAlignment="Stretch"
                      Grid.Column="0"
                      Width="1" 
                      Background="DarkGray" />

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Projects" Grid.ColumnSpan="2" FontSize="16" Margin="10" />
            <UniformGrid Rows="1" Margin="2" Grid.Row="1">
                <Button Content="un/Check all" Margin="3"
                    Command="{Binding OnCommandFromView}" CommandParameter="ProjectsCheckUnAll" />
                <Button Content="Import" Margin="3"
                    Command="{Binding OnCommandFromView}" CommandParameter="ProjectsImport" />
                <Button Content="Remove Selected" Margin="3"
                    Command="{Binding OnCommandFromView}" CommandParameter="ProjectsRemove">
                    <!--<Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="24" />
