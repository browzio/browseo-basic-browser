<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoViral.Instagram.InstControls"
             xmlns:InstViewModels="clr-namespace:GoViral.Instagram.InstViewModels"
             x:Class="GoViral.Instagram.InstControls.InstTabsUserControl"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <TabControl>
            <TabItem Header="Search">
                <local:InstaSearchUserControl >
                    <local:InstaSearchUserControl.DataContext>
                        <InstViewModels:InstaSearchVM  />
                    </local:InstaSearchUserControl.DataContext>
                </local:InstaSearchUserControl>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
