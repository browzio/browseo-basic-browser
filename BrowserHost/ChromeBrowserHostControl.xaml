<UserControl x:Class="BrowserHost.ChromeBrowserHostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrowserHost"
             xmlns:viewModel="clr-namespace:WpfCefDynamBrowser.ViewModels"
             xmlns:browserCommonViews="clr-namespace:Browser.Common.Views;assembly=Browser.Common"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>

        <DataTemplate DataType="{x:Type viewModel:ChromeBrowserTabViewModel}">
            <browserCommonViews:BrowserTabView  />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <browserCommonViews:BrowserHostCntrl Name="browserHost" x:FieldModifier="public"
                                             OnCloseTab="browserHost_OnCloseTab" OnOpenNewTab="browserHost_OnOpenNewTab" OnContentRenderd="browserHost_OnContentRenderd" />
    </Grid>
</UserControl>
