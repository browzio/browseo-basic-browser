<Window x:Class="BrowserHost.Windows.ChoosePinterestImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico"
        Title="Choose Image" Height="300" Width="300" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="&lt;" Width="30" Click="btnScrollLeft_Click" />

            <ListBox x:Name="list" Grid.Column="1" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ItemsSource="{Binding WebPageImages}" SelectedIndex="{Binding SLImageLink}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                            <Image Source="{Binding ImgUrl}" Width="200" Height="200"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content=">" Width="30" Click="btnScrollRight_Click" Grid.Column="2" />
        </Grid>
        
        <Button Content="OK" Grid.Row="1" Click="Button_Click" />
    </Grid>
</Window>
