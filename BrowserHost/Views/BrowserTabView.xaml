                        </DrawingGroup.Children>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <SolidColorBrush x:Key="BorderBrush" Color="#FFe4f6fa"/>
            <LinearGradientBrush x:Key="TabControlBackgroundBrush" EndPoint="0.5,0" StartPoint="0.5,1">
                <GradientStop Color="#FFa9cde7" Offset="0"/>
                <GradientStop Color="#FFe7f4fc" Offset="0.3"/>
                <GradientStop Color="#FFf2fafd" Offset="0.85"/>
                <GradientStop Color="#FFe4f6fa" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <Border  VerticalAlignment="Top"
                     DockPanel.Dock="Top"
                     BorderBrush="#FF999999" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button Command="{Binding BackCommand}" Width="35" Height="35"  ToolTip="Back" Style="{DynamicResource MetroCircleButtonStyle}">
                    <Path 
                                        Margin="0,0,2,0" 
                                        Stroke="Black" 
                                        Fill="Black" 
                                        Data="M 4,0 L 0,3.5 L 4,7 Z"/>
                </Button>
                <Button Command="{Binding ForwardCommand}"
                        Width="35"
                        Height="35"
                        ToolTip="Forward"
                        Style="{DynamicResource MetroCircleButtonStyle}">
                    <Path 
                                        Margin="2,0,0,0" 
                                        Stroke="Black"
                                        Fill="Black"
                                        Data="M 0,0 L 4,3.5 L 0,7 Z"/>
                </Button>
                <Button Height="35"
                        Width="35"
                        Command="{Binding ReloadCommand}" 
                        ToolTip="Refresh"
                        Style="{DynamicResource MetroCircleButtonStyle}">
                    <Image 
                                        Width="12" 
                                        Height="12" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center" 
                                        Stretch="Uniform" 
                                        Source="{StaticResource ReloadImage}" />
                </Button>
                <Button Name="openFlyout"  
                    Width="35" 
                    Height="35"
                    DockPanel.Dock="Right"
                    Click="openFlyout_Click"
                    ToolTip="Open Saved Sites"
                    Command="{Binding FillListCommand}"
                    Style="{DynamicResource MetroCircleButtonStyle}">
                <TextBlock Text="+" FontWeight="Bold" FontSize="30" Margin="0,-8,0,0"/>
               
            </Button>
                <Button Name="Inject" 
                    Grid.Column="3"  
                    Width="35" 
                    Height="35"
                    DockPanel.Dock="Right"
                    ToolTip="Fill Form With Profile Data"
                    Command="{Binding InjectCommand}"
                    Style="{DynamicResource MetroCircleButtonStyle}">
                    <TextBlock Text="F"  FontWeight="Black" FontSize="20" Margin="0,-4,0,0"/>
                </Button>                
                <Button Name="SaveSite" 
                    Width="35" 
                    Height="35"
                    DockPanel.Dock="Right"
                    ToolTip="Save Site From Navigation Box Text"
                    Click="SaveSite_Click"
                    Style="{DynamicResource MetroCircleButtonStyle}">
                        <TextBlock Text="S"  FontSize="20" FontWeight="Bold" Margin="0,-4,0,0"/>
                    </Button>

                  <Button Name="Share" 
                    Width="50" 
                    Click="Share_Click"
                    Height="35"
                    DockPanel.Dock="Right"
                    ToolTip="Share Site"
                    Style="{DynamicResource MetroCircleButtonStyle}">
                        <TextBlock Text="Share"  FontSize="10" FontWeight="Bold" Margin="0,-4,0,0"/>
                        <Button.ContextMenu>
                            <ContextMenu Width="415">
                                <StackPanel Orientation="Horizontal" Margin="-27,0,0,0" Background="WhiteSmoke">
                                    <Button Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="facebook"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/facebook-icon.png" 
                                                                   ToolTip="facebook"
                                                                   Width="18" Height="18" />
                                    </Button>

                                    <Button Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="google"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/googleplus-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="google+" />
                                    </Button>

                                    <Button Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="digg"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/digg-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="digg" />
                                    </Button>

                                    <Button Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="pintrest"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/Pinterest-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="pintrest" />
                                    </Button>

                                    <Button Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="reddit"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/reddit-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="reddit" />
                                    </Button>

                                    <Button Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="stumbleupon"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/StumbleUpon-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="stumbleupon" />
                                    </Button>

                                    <Button Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="tumblr"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/tumblr-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="tumblr" />
                                    </Button>

                                    <Button Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="twitter"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/twitter-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="twitter" />
                                    </Button>

                                    <Button Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="wordpress"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/wordpress-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="wordpress" />
                                    </Button>
                                </StackPanel>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                
                    <ComboBox Height="23"
                          IsEditable="True"
                          x:Name="cmbSites"
                          IsTextSearchEnabled="False"
                          PreviewKeyDown="cmbSites_PreviewKeyDown"
                         Text="{Binding AddressEditable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Width" Value="{Binding Path=ActualWidth,ElementName=cmbSites}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding GoCommand}" />
                    </ComboBox.InputBindings>
                </ComboBox>

                <!--<TextBox Height="23"
                         Text="{Binding AddressEditable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                         GotMouseCapture="OnTextBoxGotMouseCapture">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding GoCommand}" />
                    </TextBox.InputBindings>
                </TextBox>-->
            </DockPanel>
            </Border>

            <StatusBar DockPanel.Dock="Bottom">
                <Controls:MetroProgressBar
                            HorizontalAlignment="Right"
                             IsIndeterminate="{Binding IsLoading}"
                             Width="100"
                             Height="16"
                             Margin="3" />
                <TextBlock Text="{Binding StatusMessage}" />
                <Separator />
                <TextBlock Text="{Binding OutputMessage}" />
            </StatusBar>
            <Grid Background="#FFF0F0F0" Name="browserGrd">
                <Rectangle>
                    <Rectangle.Fill>
                        <VisualBrush TileMode="Tile"
                                     Viewport="0,0,500,90"
                                     ViewportUnits="Absolute"
                                     Opacity="0.05">
                            <VisualBrush.Visual>
                                <StackPanel>
                                    <TextBlock Margin="6,12" FontWeight="Bold">brow·seo</TextBlock>
                                </StackPanel>
                            </VisualBrush.Visual>
                            <VisualBrush.Transform>
                                <RotateTransform Angle="-22.5" />
                            </VisualBrush.Transform>
                        </VisualBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <ContentControl Content="{Binding WebBrowserHost}" Name="host" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                
                <Controls:FlyoutsControl Panel.ZIndex="1"  x:Name="flyOutsControl" Background="Black" BorderBrush="Black">
                    <Controls:Flyout Theme="Light" x:Name="flyOut" Header="Saved Sites" Position="Right" 
                                 ClosingFinished="flyOut_ClosingFinished"
                                 Background="#F0F0F0"
                                 BorderBrush="Black">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Content="Export All Bookmarks" Name="btnExportAllBookmarks" Style="{DynamicResource SquareButtonStyle}" Margin="5" Click="btnExportAllBookmarks_Click" />
                            <dragNdrop:DraggableListBox Width="300" Name="dragnDropListview" Grid.Row="1" />
                        </Grid>
                        <!--<dragNdrop:DraggableTreeview Width="275" Name="dragnDropTreeview" />-->
                        <!--<ListBox ItemsSource="{Binding Path=SitesList}" 
                                 SelectedIndex="{Binding SISitesList}"
                                 Background="WhiteSmoke" 
                                 Width="200">
                            <ListBox.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick"
                                              Command="{Binding NavigateListItemCommand}"/>
                            </ListBox.InputBindings>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Site}" 
                                               Width="{Binding Path=ActualWidth, 
                                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListView}}}" >
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.NavigateListItemCommand,
                                                                RelativeSource={RelativeSource FindAncestor,  
                                                                AncestorType ={x:Type UserControl}}}" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Name="deleteSiteMenueItem" Header="Delete" Command="{Binding DeleteSiteMenueItemCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>-->
                    </Controls:Flyout>
                </Controls:FlyoutsControl>
                
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
