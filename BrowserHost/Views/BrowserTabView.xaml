<UserControl x:Class="WpfCefDynamBrowser.Views.BrowserTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfCefDynamBrowser.ViewModels"
             xmlns:mControls="clr-namespace:BrowserHost.Controls"
             xmlns:dragNdrop="clr-namespace:DragDropListview.Controls;assembly=DragDropListview"
             xmlns:commonConvs="clr-namespace:Organiser.Common.Converters;assembly=Organiser.Common"
             mc:Ignorable="d"
             d:DesignWidth="640"
             d:DesignHeight="480">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <commonConvs:OpisiteVisibilityConverter x:Key="convOppositVisibility" /> 
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <Border  VerticalAlignment="Top"
                     DockPanel.Dock="Top" Height="28"
                     BorderBrush="#FFd3d3d3" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button Command="{Binding BackCommand}"  ToolTip="Back" Style="{DynamicResource browser_btn}">
                        <Grid HorizontalAlignment="Left" Height="18" VerticalAlignment="Bottom" Width="18" >
                            <Path Data="M12.71873,3.0490813 L12.719011,13.408316 4.698245,8.2381057 z" Fill="#FFC7C7C7" Margin="4.583,3,4.25,3.521" Stretch="Fill"/>
                        </Grid>
                    </Button>
                    <Button Command="{Binding ForwardCommand}"
                        ToolTip="Forward"
                        Style="{DynamicResource browser_btn}">
                        <Grid  Height="18" Width="18">
                            <Path Data="M12.71873,3.0490813 L12.719011,13.408316 4.698245,8.2381057 z" Fill="#FFC7C7C7" Margin="4.583,3,4.25,3.521" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleY="1" ScaleX="-1"/>
                                        <SkewTransform AngleY="0" AngleX="0"/>
                                        <RotateTransform Angle="0"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Button>
                    <Button
                        Command="{Binding ReloadCommand}" 
                        ToolTip="Refresh" Margin="0,0,7,0"
                        Style="{DynamicResource browser_btn}">
                        <Image 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="None" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/refresh.png" />
                    </Button>

                    <Button Name="openFlyout"  
                    DockPanel.Dock="Right"
                    Click="openFlyout_Click"
                    ToolTip="Open Saved Sites"
                    Margin="5,0,10,0"
                    Command="{Binding FillListCommand}"
                    Style="{DynamicResource browser_btn}">
                        <Image 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="None" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/add.png" />

                    </Button>

                    <Button Name="Settings" 
                        DockPanel.Dock="Right"
                        ToolTip="Browser Settings" 
                        ContextMenuService.IsEnabled="False"
                        Click="BtnWithContextMenue_Click"
                        Style="{DynamicResource browser_btn}" Margin="5,0,0,3" VerticalAlignment="Bottom">
                        <Image Width="17" Height="17"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="Uniform" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/settings2.png" />
                        <Button.ContextMenu>
                            <ContextMenu Name="cmBrowserSettings" Opened="cmBrowserSettings_Opened" Closed="cmBrowserSettings_Closed">
                                <ContextMenu.Resources>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatbtnStyle}">
                                        <Setter Property="Width" Value="100" />
                                        <Setter Property="Margin" Value="0,3,3,3" />
                                        <Setter Property="BorderBrush" Value="Black" />
                                        <Setter Property="BorderThickness" Value="0.7" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="False">
                                                <Setter Property="Background" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Save Session" Command="{Binding SaveSession}" />
                                <MenuItem Header="Delete Last Session" Command="{Binding DeleteSession}" />

                                <Separator Margin="-30,0,0,0" />
                                
                                <MenuItem Header="Save Open Tabs" ToolTip="Will save all open tabs to a bookmarks folder" Command="{Binding SaveSessionToBMs}" />
                                
                                <Separator Margin="-30,0,0,0" />
                                
                                <CheckBox Content="Flash" IsChecked="{Binding FlashEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Javascript" IsChecked="{Binding JavascriptEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Java" IsChecked="{Binding JavaEnabled, UpdateSourceTrigger=PropertyChanged}" />

                                <Separator Margin="-30,0,0,0" />

                                <CheckBox Content="Allow Tracking (DNT)"  ToolTip="Can only be set with session settings" IsChecked="{Binding DoNotTrackEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Sync Time" ToolTip="Can only be set with session settings" IsChecked="{Binding SetSysDateEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid>
                                    <StackPanel Visibility="{Binding VisibleDtPbar}">
                                        <TextBlock Text="Getting Time Zone" />
                                        <ProgressBar IsIndeterminate="True" />
                                    </StackPanel>
                                    
                                    <ComboBox SelectedIndex="{Binding SITimeZone}" 
                                              ItemsSource="{Binding AvailableTimeZones}"
                                              Visibility="{Binding Path=VisibleDtPbar, Converter={StaticResource convOppositVisibility}}"
                                              MaxWidth="200" />
                                </Grid>

                                <Separator Margin="-30,0,0,0" />

                                <DockPanel>
                                    <Button Content="Apply To Tab" Command="{Binding SettingsCTClick}" CommandParameter="TAB" Click="cmsBtn_Click" 
                                            DockPanel.Dock="Left" />
                                        <Button Content="Apply To Session" Command="{Binding SettingsCTClick}" CommandParameter="SESSION" Click="cmsBtn_Click"
                                            DockPanel.Dock="Right" />
                                </DockPanel>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Name="CP" 
                    DockPanel.Dock="Right"
                    ToolTip="Open Copy Paste Window"
                    Command="{Binding OpenCPCommand}" 
                    Style="{DynamicResource browser_btn}">
                        <TextBlock Text="C/P" Margin="0,2,0,0" Foreground="#FFB2B2B2" FontWeight="Bold" FontFamily="Global User Interface" FontSize="13" />
                    </Button>

                    <Button Name="Inject" 
                    DockPanel.Dock="Right"
                    ToolTip="Fill Form With Profile Data"
                    Command="{Binding InjectCommand}" 
                    Style="{DynamicResource browser_btn}">
                        <Image HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="None" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/user.png" Opacity="0.4" />
                    </Button>

                    <Button Name="SaveSite" 
                    DockPanel.Dock="Right"
                    ToolTip="Save Site From Navigation Box Text"
                    Click="SaveSite_Click"
                    Style="{DynamicResource browser_btn}">
                        <Image 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="None" 
                               Source="pack://application:,,,/Organiser.Common;component/Image/save.png" />
                    </Button>

                    <Button Name="btnShare" 
                     Click="BtnWithContextMenue_Click"
                     DockPanel.Dock="Right"
                     ToolTip="Share Site"
                     Style="{DynamicResource browser_btn}">
                        <TextBlock Text="Share"  FontSize="10" Foreground="#c7c7c7" Margin="0,0,0,0"/>
                        <Button.ContextMenu>
                            <ContextMenu>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="facebook"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/facebook-icon.png" 
                                                                   ToolTip="facebook"
                                                                   Width="18" Height="18" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="google"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/googleplus-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="google+" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="digg"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/digg-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="digg" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="pintrest"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/Pinterest-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="pintrest" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="reddit"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/reddit-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="reddit" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="stumbleupon"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/StumbleUpon-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="stumbleupon" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="tumblr"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/tumblr-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="tumblr" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="twitter"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/twitter-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="twitter" />
                                    </Button>

                                    <Button Cursor="Hand" Style="{StaticResource browser_btn}" Margin="3" Command="{Binding SendToBrowserSocial}" CommandParameter="wordpress"
                                                                Click="Button_Click_1">
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/wordpress-icon.png" 
                                                                   Width="18" Height="18"
                                                                   ToolTip="wordpress" />
                                    </Button>
                                </StackPanel>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <mControls:MyComboBox Height="23"
                          IsEditable="True"
                          x:Name="cmbSites"
                          IsTextSearchEnabled="False"
                          OnAfterTextBoxKeyDown="cmbSites_PreviewKeyDown"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.CanContentScroll="False"
                         Text="{Binding AddressEditable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Width" Value="{Binding Path=ActualWidth,ElementName=cmbSites}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <!--<ComboBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding GoCommand}" />
                    </ComboBox.InputBindings>-->
                    </mControls:MyComboBox>

                    <!--<TextBox Height="23"
                         Text="{Binding AddressEditable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                         GotMouseCapture="OnTextBoxGotMouseCapture">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding GoCommand}" />
                    </TextBox.InputBindings>
                </TextBox>-->
                </DockPanel>
            </Border>

            <StatusBar DockPanel.Dock="Bottom">
                <!--<Controls:MetroProgressBar
                            HorizontalAlignment="Right"
                             IsIndeterminate="{Binding IsLoading}"
                             Width="100"
                             Height="16"
                             Margin="3" />-->
                <ProgressBar HorizontalAlignment="Right"
                             IsIndeterminate="{Binding IsLoading}"
                             Width="100"
                             Height="16"
                             Margin="3" />
                <TextBlock Text="{Binding StatusMessage}" />
                <Separator />
                <TextBlock Text="{Binding HuverLink}" />
                <Separator />
                <TextBlock Text="{Binding OutputMessage}" />
            </StatusBar>
            <Grid Background="#FFF0F0F0" Name="browserGrd">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle>
                    <Rectangle.Fill>
                        <VisualBrush TileMode="Tile"
                                     Viewport="0,0,150,150"
                                     ViewportUnits="Absolute"
                                     Opacity="0.05">
                            <VisualBrush.Visual>
                                <Border BorderBrush="#FFF0F0F0" BorderThickness="4">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontWeight="Bold" Margin="0,0,0,10" FontSize="16" Text="Brow·SEO" />
                                        <Image Source="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico" Stretch="Fill"  Margin="0,0,0,-80"  Width="45" Height="45" />
                                    </StackPanel>
                                </Border>
                            </VisualBrush.Visual>
                            <VisualBrush.Transform>
                                <RotateTransform Angle="-22.5" />
                            </VisualBrush.Transform>
                        </VisualBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <ContentPresenter Content="{Binding WebBrowserHost}" Name="host" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <Expander Name="flyOut" 
                          ExpandDirection="Right"
                          Style="{StaticResource AnimatedExpanderStyle}"
                          Grid.Column="1"
                          Header="Bookmarks"
                          Visibility="Collapsed"
                          IsExpanded="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Name="btnCloseFlyout" Click="btnCloseFlyout_Click" ToolTip="Collapse"
                                Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left" Height="45">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="ClipToBounds" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.LayoutTransform>
                                                            <TransformGroup>
                                                                <TransformGroup.Children>
                                                                    <TransformCollection>
                                                                        <RotateTransform Angle="-90"/>
                                                                    </TransformCollection>
                                                                </TransformGroup.Children>
                                                            </TransformGroup>
                                                        </Grid.LayoutTransform>
                                                        <Ellipse x:Name="circle" HorizontalAlignment="Center" Height="40" Width="40" Stroke="Black" VerticalAlignment="Center" StrokeThickness="1" />
                                                        <Path x:Name="arrow" Data="M 1,1.5 L 4.5,5 L 8,1.5"
                                                              HorizontalAlignment="Center" SnapsToDevicePixels="false" Stroke="#797878"
                                                              StrokeThickness="2" VerticalAlignment="Center" Height="11" 
                                                             Margin="10,10,10,10" Stretch="Fill" Width="20"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Stroke" TargetName="circle" Value="#FF787878" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Stroke" Value="#FF515151" TargetName="circle"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Grid.ColumnSpan="3" Text="Saved Sites" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26.667"  />
                        
                        <Button Content="Export All Bookmarks" Name="btnExportAllBookmarks" Grid.Column="0" Grid.Row="1" 
                                    VerticalAlignment="Bottom"
                                    Margin="10,5,5,5" Click="btnExportAllBookmarks_Click" />
                        <Button Content="Import Bookmarks" Name="btnImpotBookmarks" Grid.Column="1"  Grid.Row="1"  HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="5" Click="btnImpotBookmarks_Click" />
                        <Button Name="Reminders" Grid.Column="2" Style="{DynamicResource browser_btn}"  Grid.Row="1"  Click="Reminders_Click" 
                                    Width="50" Height="50" HorizontalAlignment="Left" Cursor="Hand">
                            <StackPanel>
                                <Border Name="borderNotification" Visibility="Collapsed" CornerRadius="999" Margin="10,0,0,-10" Width="20" Height="20" BorderThickness="0.5" BorderBrush="Black" Opacity="0.5">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#FFBB0000"/>
                                            <GradientStop Color="#FFBB0000" Offset="1"/>
                                            <GradientStop Color="#FFFF0000" Offset="0.522"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="11" Name="tbNotificationCount" HorizontalAlignment="Center"></TextBlock>
                                </Border>
                                <Image  HorizontalAlignment="Center" Height="25" Width="25" VerticalAlignment="Center" Stretch="Uniform" SnapsToDevicePixels="True" 
                                        Source="pack://application:,,,/Organiser.Common;component/Image/reminder.png" Opacity="0.4" />
                            </StackPanel>
                        </Button>
                        <dragNdrop:DraggableListBox Width="310" Grid.Row="2" Grid.ColumnSpan="3" Margin="10" BorderThickness="0"/>
                    </Grid>
                </Expander>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>


