<UserControl x:Class="BrowserAndFeatures.FeatureCallage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:browser="clr-namespace:BrowserHost;assembly=BrowserHost"
             xmlns:prospector="clr-namespace:Prospector.Controls;assembly=Prospector"
             xmlns:rssReaders="clr-namespace:RssReader.Controlls;assembly=RssReader"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    
    <UserControl.Resources>
        <Style TargetType="{x:Type TabItem}" x:Key="gmailTabStyle">
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <Border Name="Border" 
                                    Height="25"
                                    Background="LightBlue"
                                    BorderBrush="#FFD7D7D7" 
                                    BorderThickness="0,1,1,0">
                                <ContentPresenter x:Name="TitleContent" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="12,2,12,2"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFDFDFD" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF4986E7" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,1,0,0" />
                            </Trigger>
               
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#FFF2F2F2" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFD7D7D7" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,1,0,0" />
                            </Trigger>

                            <Trigger Property="IsMouseOver"  Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF4986E7" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,1,0,0" />
                            </Trigger>
                            
                            <!--<MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="False" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter Property="Margin" Value="1,0,0,0" />
                                </MultiTrigger.Setters>
                            </MultiTrigger>-->
                        </ControlTemplate.Triggers>
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid Background="#FFFDFDFD">
        <TabControl Name="tbControl" BorderThickness="0" Padding="0" SelectionChanged="tbControl_SelectionChanged">
            <TabItem Header="Browser" Height="23" VerticalAlignment="Center" Style="{StaticResource gmailTabStyle}">
                <browser:BrowserHostCntrl Name="browser" />
            </TabItem>
            <TabItem Header="Prospector" Height="23" VerticalAlignment="Center" BorderThickness="0" Padding="0" Style="{StaticResource gmailTabStyle}">
                <prospector:ProspectorTabs Name="prospector" />
                <!--<nichCntrol:NichResearchControl />-->
            </TabItem>
            <TabItem Header="RSS" Height="23" VerticalAlignment="Center" BorderThickness="0" Padding="0" Style="{StaticResource gmailTabStyle}"> 
                <rssReaders:RssTabbedControl Name="rssControl" />
            </TabItem>
            <!--<TabItem Name="tmContent" Header="Tasks Management" Height="23" VerticalAlignment="Center" BorderThickness="0" Padding="0">
            </TabItem>-->
        </TabControl>
    </Grid>
</UserControl>
