<UserControl x:Class="BrowserAndFeatures.FeatureCallage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:browser="clr-namespace:BrowserHost;assembly=BrowserHost"
             xmlns:prospector="clr-namespace:Prospector.Controls;assembly=Prospector"
             xmlns:rssReaders="clr-namespace:RssReader.Controlls;assembly=RssReader"
             xmlns:goVival="clr-namespace:GoViral.Controls;assembly=GoViral"
             xmlns:instagram="clr-namespace:GoViral.Instagram.InstControls;assembly=GoViral"
             xmlns:commonControlls="clr-namespace:Organiser.Common.Controlls;assembly=Organiser.Common"
             xmlns:wisi="clr-namespace:WPF_WYSIWYG_HTML_Editor.XAML;assembly=WYSIWYG"
             xmlns:ffbrowser="clr-namespace:zFirefoxBrowser.Controls;assembly=zFirefoxBrowser"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <commonControlls:NonReloadingTabControl Name="tbControl" BorderThickness="0" Padding="0" SelectionChanged="tbControl_SelectionChanged" Background="Transparent">
            <TabControl.Style>
                <Style TargetType="{x:Type TabControl}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabControl}">
                                <Grid ClipToBounds="true" SnapsToDevicePixels="true" KeyboardNavigation.TabNavigation="Local">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ColumnDefinition0"/>
                                        <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition x:Name="RowDefinition0" Height="Auto"/>
                                        <RowDefinition x:Name="RowDefinition1" Height="*"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Column="0" Grid.Row="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" Panel.ZIndex="3">
                                        <TabPanel x:Name="HeaderPanel" Grid.Column="0" IsItemsHost="true" Margin="0,0,0,-2" Grid.Row="0" KeyboardNavigation.TabIndex="1" />
                                    </ScrollViewer>
                                    <Border x:Name="ContentPanel" BorderThickness="0,1,0,0" Grid.Column="0" Panel.ZIndex="0"
                                        KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="1" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                                        <ContentPresenter Margin="0,15,0,0" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        <!--<Grid Margin="0,15,0,0" x:Name="PART_SelectedContentHost"  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>-->
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="TabStripPlacement" Value="Bottom">
                                        <Setter Property="Grid.Row" TargetName="HeaderPanel" Value="1"/>
                                        <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0"/>
                                        <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                        <Setter Property="Height" TargetName="RowDefinition1" Value="Auto"/>
                                        <Setter Property="Margin" TargetName="HeaderPanel" Value="2,0,2,2"/>
                                    </Trigger>
                                    <Trigger Property="TabStripPlacement" Value="Left">
                                        <Setter Property="Grid.Row" TargetName="HeaderPanel" Value="0"/>
                                        <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0"/>
                                        <Setter Property="Grid.Column" TargetName="HeaderPanel" Value="0"/>
                                        <Setter Property="Grid.Column" TargetName="ContentPanel" Value="1"/>
                                        <Setter Property="Width" TargetName="ColumnDefinition0" Value="Auto"/>
                                        <Setter Property="Width" TargetName="ColumnDefinition1" Value="*"/>
                                        <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                        <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                                        <Setter Property="Margin" TargetName="HeaderPanel" Value="2,2,0,2"/>
                                    </Trigger>
                                    <Trigger Property="TabStripPlacement" Value="Right">
                                        <Setter Property="Grid.Row" TargetName="HeaderPanel" Value="0"/>
                                        <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0"/>
                                        <Setter Property="Grid.Column" TargetName="HeaderPanel" Value="1"/>
                                        <Setter Property="Grid.Column" TargetName="ContentPanel" Value="0"/>
                                        <Setter Property="Width" TargetName="ColumnDefinition0" Value="*"/>
                                        <Setter Property="Width" TargetName="ColumnDefinition1" Value="Auto"/>
                                        <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                        <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                                        <Setter Property="Margin" TargetName="HeaderPanel" Value="0,2,2,2"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="false">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Style>
            <TabItem Header="Browser"  Style="{StaticResource gmailTabStyle90}">
                    <browser:ChromeBrowserHostControl Name="browser" />
                </TabItem>
            <TabItem Header="Firefox"  Style="{StaticResource gmailTabStyle90}">
                <ffbrowser:FFBrowserUserControl Name="ffBrowser" />
            </TabItem>
            <TabItem Header="Prospector" Style="{StaticResource gmailTabStyle90}" Name="tabProspector">
                    <prospector:ProspectorTabs Name="prospector" />
                    <!--<nichCntrol:NichResearchControl />-->
                </TabItem>
                <TabItem Header="RSS"  Style="{StaticResource gmailTabStyle90}" Name="tabrssControl">
                    <rssReaders:RssTabbedControl Name="rssControl" />
                </TabItem>
            <TabItem Header="PublisHUB"  Style="{StaticResource gmailTabStyle90}" Name="tabrsswisi">
                    <wisi:WysiwigControl Name="wisi" />
                    <!--<wisi:WysiwigControl />-->
                    <!--<wisi:WysiwigControl Name="wysiwig" />-->
                </TabItem>
                <TabItem Header="Feed Masher" Name="feed" Style="{StaticResource gmailTabStyle90}">
                    <rssReaders:LinksToRssUserControl Name="ucFeedMasher" />
                </TabItem>
                <TabItem Header="FB Conver·SEO" Name="tabGoViral" Style="{StaticResource gmailTabStyle90}">
                    <goVival:ProjectsWithBrowser Name="ucGoViral"  />
                </TabItem>
                <TabItem Header="S·E·O" Name="tabSyncer" Style="{StaticResource gmailTabStyle90}">
                <Grid>
                    <goVival:SharedPostsUserControl Name="ucSharedSync" Loaded="ucSharedSync_Loaded"  />

                    <Button Name="btnSpin" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Height="25"
                            ToolTip="Spin and Copy article in PBN poster" Click="btnSpin_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Spin" Margin="3" VerticalAlignment="Center" Foreground="White" />
                            <Image Source="browseo (1).ico" />
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>
            <!--<TabItem Header="Inst·EO" Style="{StaticResource gmailTabStyle90}">
                <instagram:InstTabsUserControl Name="ucInstagram" />
            </TabItem>-->
                <TabItem Header="Indexer" Name="indexer" Style="{StaticResource gmailTabStyle90}">
                </TabItem>
            <TabItem Header="YouTube URL'r" Name="youtuber" Style="{StaticResource gmailTabStyle90}">
            </TabItem>
            <!--<TabItem Name="tmContent" Header="Tasks Management" Height="23" VerticalAlignment="Center" BorderThickness="0" Padding="0">
            </TabItem>-->
        </commonControlls:NonReloadingTabControl>
    </Grid>
</UserControl>
