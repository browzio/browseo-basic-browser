<UserControl x:Class="Prospector.Controls.KeywordAndOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:Prospector.Converters" 
             xmlns:localControls="clr-namespace:Prospector.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="850">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:booleanToVisible x:Key="boolToVis" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/Blue.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/BaseLight.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.AnimatedSingleRowTabControl.xaml"  />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/FlatButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
   
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15"  Background="#FFE6E7E8" Width="650">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Margin="25,0,0,0" VerticalAlignment="Center" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Keyword:" Foreground="#FF086F9E" VerticalAlignment="Center"
                               Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}" />
                    <TextBox Text="{Binding Keyword,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200"
                             HorizontalAlignment="Left" Margin="8"
                             Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Footprint:" VerticalAlignment="Center" Foreground="#FF086F9E" />
                    <TextBox Text="{Binding FootPrintString}" TextWrapping="Wrap" Width="380" Margin="8" />
                </StackPanel>
            </StackPanel>
            
            <StackPanel Margin="10" Grid.Column="1" VerticalAlignment="Top"
                        Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}">
                <!--<StackPanel Margin="5,0,0,20" Orientation="Horizontal">-->
                    <CheckBox Content="Keyword in URL" IsChecked="{Binding Checked_KeywordInUrl}" Margin="2" Height="20" />
                    <!--<TextBlock Text="Keyword in URL" Margin="2" Height="18"  />-->
                <!--</StackPanel>-->
                
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Max Results Pages" Margin="4,2,2,2" />
                    <ComboBox ItemsSource="{Binding MaxPages}" 
                              SelectedIndex="{Binding CmbMaxPAgesIndex}" 
                              Margin="2"
                              Width="100"
                              Height="22" />
                </StackPanel>
                <!--<CheckBox Content="Exact match of keyword" Margin="15,9,10,0" IsChecked="{Binding Checked_KeywordExactMatch}" />-->
            </StackPanel>
        </Grid>
        <!--<ScrollViewer  Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">-->
        <Grid Name="grdOptions" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" Name="listRow" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="15" Background="#FFE6E7E8"
                                MaxWidth="350"
                                Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}" 
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Margin="8" Text="Select Blogs Of Interest" FontWeight="Bold" />
                    <ItemsControl ItemsSource="{Binding WebsitesForBlogs}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Option}" 
                                             Margin="2"
                                             Height="20"
                                             Width="160"
                                             IsChecked="{Binding Checked}"
                                             GroupName="G1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="{Binding RBOrientation}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                    <StackPanel Grid.Column="1"   Margin="15" Background="#FFE6E7E8" 
                                Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}" 
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <TextBlock Text="Select TLD" FontWeight="Bold" Margin="8" />
                        <ItemsControl ItemsSource="{Binding TLDs}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel>
                                        <RadioButton Content="{Binding Option}" 
                                                      Margin="2"
                                             IsChecked="{Binding Checked}" 
                                             GroupName="G2" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2"  Background="#FFE6E7E8" Margin="15" 
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding Path= Visible_CommentSettings,Converter={StaticResource boolToVis}}">
                        <TextBlock Text="Comment Settings" Margin="8"  FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding Comments}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel>
                                        <CheckBox Content="{Binding Option}"
                                          Margin="2"  
                                          IsChecked="{Binding Checked}" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="3"  Margin="15" Background="#FFE6E7E8" 
                                Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}" 
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="Time Frame" FontWeight="Bold" Margin="4" />
                        <ComboBox ItemsSource="{Binding TimeFrames}" 
                                  SelectedIndex="{Binding CmbTimeframeIndex}" 
                                  Width="150"
                                  Height="22"
                                  Margin="8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Option}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

            </Grid>

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" >
            <Button Command="{Binding StartSearch}"
                    Margin="15"  Height="25" Width="180">
                <TextBlock Text="Search" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            
            <Button Command="{Binding Clear}"
                    Margin="15"  Height="25" Width="180">
                <TextBlock Text="Clear" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <Button Command="{Binding Export}"
                    Margin="15"  Height="25" Width="180">
                <TextBlock Text="Export Results" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </StackPanel>

        <localControls:GoogleSearchResults Grid.RowSpan="3" Grid.Column="2" HorizontalAlignment="Left" Margin="0,15,0,0" />

    </Grid>
</UserControl>
