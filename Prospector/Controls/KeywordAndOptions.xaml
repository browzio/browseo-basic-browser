<UserControl x:Class="Prospector.Controls.KeywordAndOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:Prospector.Converters" 
             xmlns:localControls="clr-namespace:Prospector.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="850">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:booleanToVisible x:Key="boolToVis" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/Blue.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/BaseLight.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.AnimatedSingleRowTabControl.xaml"  />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/FlatButton.xaml" />
            </ResourceDictionary.MergedDictionaries>

        

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.Resources>
            <SolidColorBrush x:Key="groupBg" Color="#f5f5f5"/>
            <Style TargetType="Button" x:Key="ButtonStyle">
                <Setter Property="Height" Value="23" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border 
                                Background="#a1a5ad" Cursor="Hand"
                                Padding="{TemplateBinding Padding}" MinWidth="95"
                                CornerRadius="0" x:Name="Border">
                                <ContentControl Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Center" Margin="7,0"
                                                VerticalAlignment="Center" TextElement.Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="#FF376ED4" Offset="0"/>
                                                <GradientStop Color="#FF588DF0" Offset="0.332"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
   
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5"  Background="{StaticResource groupBg}" Width="650">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Margin="25,0,0,0" VerticalAlignment="Center" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Keyword:"  VerticalAlignment="Center"
                               Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}" />
                    <TextBox Text="{Binding Keyword,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="13,8"
                             Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}" />

                    <TextBlock Text="Keyword:"  VerticalAlignment="Center"
                               Visibility="{Binding Path= Visible_WebHose,Converter={StaticResource boolToVis}}" />
                    <TextBox Text="{Binding Keyword,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="13,8"
                             Visibility="{Binding Path= Visible_WebHose,Converter={StaticResource boolToVis}}" />

                    <CheckBox Content="Use Proxy" IsChecked="{Binding UseProxy}" Margin="5" Visibility="{Binding Path= NotVisible_WebHose,Converter={StaticResource boolToVis}}"  />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Visibility="{Binding Path= NotVisible_WebHose,Converter={StaticResource boolToVis}}">
                    <TextBlock Text="Footprint:" VerticalAlignment="Top"  Margin="0,8,0,0"/>
                    <TextBox Text="{Binding FootPrintString}" TextWrapping="Wrap" Width="400" Height="40" Margin="8" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Visibility="{Binding Path= Visible_WebHose,Converter={StaticResource boolToVis}}" Margin="0,0,0,3">
                    <TextBlock Text="Either of these:" TextWrapping="Wrap" Width="59" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBox Text="{Binding SpecificKws}" TextWrapping="Wrap" Width="400"  Margin="1" />
                        <TextBlock Text="(Coma seperated additional keywords to serch for)"  VerticalAlignment="Top" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Visibility="{Binding Path= Visible_WebHose,Converter={StaticResource boolToVis}}">
                    <TextBlock Text="Specific Sites:" TextWrapping="Wrap" Width="59" VerticalAlignment="Top" />
                    <Image Source="/Prospector;component/Images/info.png" Margin="-48,6,0,0" VerticalAlignment="Center" ToolTipService.ShowDuration="15000" 
                           ToolTip="Enter the top level domain (TLD),&#x0a; for example instead of www.yahoo.com enter yahoo.com" />
                    <StackPanel>
                        <TextBox Text="{Binding SpecificSites}" TextWrapping="Wrap" Width="400"  Margin="1" />
                        <TextBlock Text="(Coma seperated sites to serch in)"  VerticalAlignment="Top" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Visibility="{Binding Path= Visible_WebHose,Converter={StaticResource boolToVis}}">
                    <TextBlock Text="Country:" VerticalAlignment="Center" TextWrapping="Wrap" Width="52"  />
                    <TextBox Text="{Binding CountryCode}" TextWrapping="Wrap" Width="40" Margin="8" />
                    <TextBlock Text="(for USA = US)     " VerticalAlignment="Center"  Margin="1"/>
                    <TextBlock Text="visit countrycode.org for full list" Foreground="Blue" Cursor="Hand" PreviewMouseUp="TextBlock_PreviewMouseUp"  VerticalAlignment="Top"  Margin="0,13,0,0" />
                </StackPanel>

                <Button Command="{Binding SaveFootprint}" Content="Save Footprint"
                        Visibility="{Binding Path= Visible_savebtn,Converter={StaticResource boolToVis}}"
                    Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left" Margin="5"/>
            </StackPanel>

            <StackPanel Margin="7" Grid.Column="1" VerticalAlignment="Top" Visibility="{Binding Path= Visible_WebHose,Converter={StaticResource boolToVis}}">
                <StackPanel>
                    <CheckBox Content="KW In Title" IsChecked="{Binding KWinTitleIsChecked}" Margin="2" />
                    <CheckBox Content="KW In Content" IsChecked="{Binding KWinContentIsChecked}" Margin="2" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Performance Score" Margin="4,2,2,2" />
                    <Image Source="/Prospector;component/Images/info.png" Margin="2" VerticalAlignment="Center" ToolTipService.ShowDuration="15000" 
                           ToolTip="The score ranges between 0-10,&#x0a; where 0 means that the post didn't do well at all,&#x0a; i.e rarely or was never shared,&#x0a; to 10 which means that the post was on fire,&#x0a; shared thousands of times over on either Twitter,&#x0a; Facebook and other social networks." />
                </StackPanel>
                <ComboBox ItemsSource="{Binding PerformanceScores}" 
                              SelectedIndex="{Binding CmbPerformanceScoresIndex}" 
                              Margin="2"
                              Width="100"
                              Height="22" />
            </StackPanel>

            <StackPanel Margin="10" Grid.Column="1" VerticalAlignment="Top" Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}">
                <CheckBox Content="Keyword in URL" IsChecked="{Binding Checked_KeywordInUrl}" Margin="2" Height="20" />
                
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Max Results Pages" Margin="4,2,2,2" />
                    <ComboBox ItemsSource="{Binding MaxPages}" 
                              SelectedIndex="{Binding CmbMaxPAgesIndex}" 
                              Margin="2"
                              Width="100"
                              Height="22" />
                </StackPanel>
                <!--<CheckBox Content="Exact match of keyword" Margin="15,9,10,0" IsChecked="{Binding Checked_KeywordExactMatch}" />-->
            </StackPanel>
        </Grid>
        <!--<ScrollViewer  Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">-->
        <Grid Name="grdOptions" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" Name="listRow" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                <StackPanel Margin="5" Background="{StaticResource groupBg}"
                                    MaxWidth="350"
                                    Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}" 
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Margin="8" Text="Select Blogs Of Interest" FontWeight="Bold" />
                    <ItemsControl ItemsSource="{Binding WebsitesForBlogs}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Option}" 
                                                 Margin="2"
                                                 Height="20"
                                                 Width="160"
                                                 IsChecked="{Binding Checked}"
                                                 GroupName="G1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="{Binding RBOrientation}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="2"  Background="{StaticResource groupBg}" Margin="5" 
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding Path= Visible_CommentSettings,Converter={StaticResource boolToVis}}">
                            <TextBlock Text="Comment Settings" Margin="8"  FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding Comments}" Margin="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <WrapPanel>
                                            <CheckBox Content="{Binding Option}"
                                              Margin="2"  
                                              IsChecked="{Binding Checked}" />
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

               <StackPanel Grid.Column="3"  Margin="5" Background="{StaticResource groupBg}"
                                    Visibility="{Binding Path= Visible_Custom,Converter={StaticResource boolToVis}}" 
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="Time Frame" FontWeight="Bold" Margin="4" />
                        <ComboBox ItemsSource="{Binding TimeFrames}" 
                                      SelectedIndex="{Binding CmbTimeframeIndex}" 
                                      Width="150"
                                      Height="22"
                                      Margin="8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Option}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                <!-- region webhose -->
                <StackPanel Grid.Column="1"   Margin="5" Background="{StaticResource groupBg}" 
                                Visibility="{Binding Path= Visible_WebHose,Converter={StaticResource boolToVis}}" 
                                MaxWidth="350"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <TextBlock Text="Select Language" FontWeight="Bold" Margin="8" />
                    <ItemsControl ItemsSource="{Binding Langs}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Option}" Height="20" Width="160"  Margin="2" IsChecked="{Binding Checked}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="{Binding RBOrientation}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1"   Margin="5" Background="{StaticResource groupBg}" 
                                Visibility="{Binding Path= Visible_WebHose,Converter={StaticResource boolToVis}}" 
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <TextBlock Text="Select TLD" FontWeight="Bold" Margin="8" />
                    <ItemsControl ItemsSource="{Binding TLDs}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Option}" Height="20" Width="160"  Margin="2" IsChecked="{Binding Checked}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <!--<ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="{Binding RBOrientation}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>-->
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="2"   Margin="5" Background="{StaticResource groupBg}" 
                                Visibility="{Binding Path= Visible_WebHose,Converter={StaticResource boolToVis}}" 
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <TextBlock Text="Select Site Type" FontWeight="Bold" Margin="8" />
                    <ItemsControl ItemsSource="{Binding SiteTypesWebHose}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Option}" Height="20" Width="160"  Margin="2" IsChecked="{Binding Checked}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <!--<ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="{Binding RBOrientation}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>-->
                    </ItemsControl>
                </StackPanel>
                <!-- endregion -->

            </StackPanel>

            <Grid Background="#f5f5f5" Visibility="{Binding Path= Visible_SavedFP,Converter={StaticResource boolToVis}}" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="Button" >
                        <Setter Property="Height" Value="25" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border 
                                Background="#a1a5ad" Cursor="Hand"
                                Padding="{TemplateBinding Padding}" MinWidth="25"
                                CornerRadius="0" x:Name="Border">
                                        <ContentControl Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Center" Margin="3"
                                                VerticalAlignment="Center" TextElement.Foreground="White"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Border" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FF376ED4" Offset="0"/>
                                                        <GradientStop Color="#FF588DF0" Offset="0.332"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Button Command="{Binding RefreshSaved}" CommandParameter="Refresh" Height="25" Width="25" HorizontalAlignment="Right">
                    <Image Source="pack://application:,,,/Organiser.Common;component/Image/refresh.png"  
                   ToolTip="Refresh" SnapsToDevicePixels="True" Stretch="Uniform" />
                </Button>
                <ListBox Grid.Row="1" ItemsSource="{Binding SavedFP}" 
                 Background="WhiteSmoke"
                 SelectedIndex="{Binding SISavedFP}"
                 Margin="3"
                 IsSynchronizedWithCurrentItem="True" BorderThickness="0,0,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="4" FontSize="16" MinWidth="300" Cursor="Hand" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete">
                                <MenuItem.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DeleteSavedFootprint}" />
                                </MenuItem.InputBindings>
                            </MenuItem>
                        </ContextMenu>
                     </ListBox.ContextMenu>
                </ListBox>
            </Grid>
        </Grid>

        <StackPanel IsEnabled="{Binding IsNotSerching}" Orientation="Horizontal" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left"  Margin="5,10">
            <Button Command="{Binding StartSearch}"  Style="{StaticResource ButtonStyle}"
                    Content="Search"/>

            <Button Command="{Binding Clear}" Content="Clear"
                    Style="{StaticResource ButtonStyle}" Margin="10,0"/>



            <Button Command="{Binding Export}" Content="Export Results"
                    Style="{StaticResource ButtonStyle}"/>

            <Button Command="{Binding SetMoz}" Content="Set Moz Keys"
                    Style="{StaticResource ButtonStyle}" Margin="10,0"/>

            <Button Command="{Binding SetProxy}" Content="Set Proxy"
                    Style="{StaticResource ButtonStyle}" Margin="0"/>

        </StackPanel>

        <localControls:GoogleSearchResults Grid.RowSpan="3" Grid.Column="2"  Margin="10,5,10,10" />

    </Grid>
</UserControl>
