<UserControl x:Class="Prospector.Controls.ButtonOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Prospector.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="300">
    <StackPanel IsEnabled="{Binding IsNotSerching}"
                Orientation="Horizontal">
        <Button Command="{Binding StartSearch}"
                Content="Search"
                Width="95" />

        <Button Command="{Binding Clear}"
                Content="Clear"
                Margin="10,0"
                Width="95" />

        <Button Command="{Binding Export}"
                Content="Export Results"
                Width="95" />

        <Button Command="{Binding SetMoz}"
                Content="Set Moz Keys"
                Margin="10,0"
                Width="95" />

        <Button Command="{Binding SetProxy}"
                Content="Set Proxy"
                Margin="0"
                Width="95" />
    </StackPanel>
</UserControl>
