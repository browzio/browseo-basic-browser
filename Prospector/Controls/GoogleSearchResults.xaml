<UserControl x:Class="Prospector.Controls.GoogleSearchResults"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:Prospector.Converters" 
             xmlns:commonControls="clr-namespace:Organiser.Common.Controlls;assembly=Organiser.Common"
             mc:Ignorable="d" 
             Name="uc">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:booleanToVisible x:Key="boolToVis" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="WhiteSmoke">
        <ListView   ItemsSource="{Binding ListResults}"
                    BorderThickness="0"
                    Background="WhiteSmoke"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.CanContentScroll="False"
                    ItemContainerStyle="{StaticResource MetroListBoxItemStyle}"
                    SelectedIndex="{Binding SIListResults, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="9">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title, Mode=OneWay}"
                                   Margin="3"
                                   TextWrapping="Wrap"
                                   Foreground="Blue" />

                        <TextBox Text="{Binding Link, Mode=OneWay}"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 Margin="3"
                                 TextWrapping="Wrap"
                                 Foreground="Green" />

                        <TextBlock Text="{Binding Published}"
                                   Grid.Row="2"
                                   Margin="3"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding AuthorityVisible}"/>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding AuthorityVisible}"
                                    Grid.Row="3">
                            <TextBlock Text="{Binding PageAuthority}"
                                                   Margin="3"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Foreground="Black" />
                            <TextBlock Text="{Binding DomainAuthority}"
                                                   Margin="3"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Foreground="Black" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding WebhoseExtraVisible}"
                                    Grid.Row="4">
                            <TextBlock Text="{Binding DomainScore, Mode=OneWay}"
                                       ToolTip="1-100,000"
                                                   TextWrapping="Wrap"
                                                    FontWeight="SemiBold"
                                                   Foreground="Black" Margin="3" />
                            <TextBlock Text="{Binding PerformanceScore, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                    FontWeight="SemiBold"
                                                   Foreground="Black" Margin="3"/>
                            <TextBlock Text="{Binding Spamscore, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                    FontWeight="SemiBold"
                                                   Foreground="Black" Margin="3"/>
                        </StackPanel>

                        <TextBlock FontWeight="Medium"
                                   Grid.Row="5"
                                   Visibility="{Binding DwExtras}">
                            <Run Text="Keword Appearances On Page: " />
                            <Run Text="{Binding TimesKwFound}" />
                        </TextBlock>

                        <TextBlock Text="{Binding Description, Mode=OneWay}"
                                   Grid.Row="6"
                                   Margin="3"
                                   MaxWidth="450"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   Foreground="Black" />

                        <Expander ExpandDirection="Down"
                                  IsExpanded="True"
                                  Header="Social Stats"
                                  Visibility="{Binding DwExtras}"
                                  Grid.Row="7">
                            <commonControls:SocialStatsUserControl />
                        </Expander>

                        <UniformGrid Rows="1" Visibility="{Binding WebhoseExtraVisible}" Width="450" HorizontalAlignment="Left"
                                   Grid.Row="8">
                            <TextBlock Text="{Binding Lang}" Margin="3" />
                            <TextBlock Text="{Binding Pnum}" Margin="3" />
                            <TextBlock Text="{Binding Ptotal}" Margin="3" />
                            <TextBlock Text="{Binding Country}" Margin="3" />
                            <TextBlock Text="{Binding Type}" Margin="3" />
                        </UniformGrid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="View In FF">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="BROWSERFF" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <MenuItem Header="View In Chrome">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="BROWSER" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <!--<MenuItem Header="View In Tor">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding SendToBrowser}"
                                          CommandParameter="BROWSERTOR" />
                        </MenuItem.InputBindings>
                    </MenuItem>-->

                    <Separator Margin="-30,0,0,0"
                               Visibility="{Binding DwExtras}" />
                    <MenuItem Header="Facebook Order By Shares"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_FBSHARES" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Facebook Order By Likes"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_FBLIKES" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Facebook Order By Comments"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_FBCOMMENTS" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Google+ Order By Plus Ones"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_GPLUSONES" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Pinterest Order By Pins"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_PINTERESTPINS" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Stumble Order By Views"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_STUMBLEVIEWS" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="LinkedIn Order By Count"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_LINKEDINCOUNT" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Buffer Order By Shares"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_BUFFERSHARES" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Reddit Order By Ups"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_REDDITUPS" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Reddit Order By Score"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_REDDITSCORE" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <Separator Margin="-30,0,0,0"
                               Visibility="{Binding DwExtras}" />
                    <MenuItem Header="Order By Keywords Found"
                              Visibility="{Binding DwExtras}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="ORDERBY_KEYWORDFOUND" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <Separator Margin="-30,0,0,0" />

                    <MenuItem Header="Curate It">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="PBNPOSTER" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <MenuItem Header="Curaste...">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="Curaste" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <Separator Margin="-30,0,0,0" />

                    <MenuItem Header="Moz Check">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding RanckCheck}" CommandParameter="MOZ" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <MenuItem Header="Moz Check All" Visibility="{Binding Path= NotVisible_WebHose,Converter={StaticResource boolToVis}}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding RanckCheck}" CommandParameter="MOZALL" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListView>
    </Grid>
</UserControl>
