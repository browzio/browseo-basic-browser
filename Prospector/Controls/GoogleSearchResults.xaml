<UserControl x:Class="Prospector.Controls.GoogleSearchResults"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:Prospector.Converters" 
             mc:Ignorable="d" 
             Name="uc">
    <UserControl.Resources>
        <converter:booleanToVisible x:Key="boolToVis" />
    </UserControl.Resources>

    <Grid Background="#f5f5f5">
        <ListView IsSynchronizedWithCurrentItem="True" Margin="10"
                  ItemsSource="{Binding ListResults}"
                  Background="White"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  SelectedIndex="{Binding SIListResults, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Results" Width="{Binding Path=ActualWidth,ElementName=uc}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Background="#FFFDFDFD"  Orientation="Horizontal">
                                    <StackPanel Margin="9">
                                        <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                   Margin="3"
                                                   TextWrapping="Wrap"
                                                   Foreground="Blue" />

                                        <TextBlock Text="{Binding Link, Mode=OneWay}"
                                                   Margin="3"
                                                   TextWrapping="Wrap"
                                                   Foreground="Green" />

                                        <StackPanel Orientation="Horizontal" Visibility="{Binding AuthorityVisible}">
                                            <TextBlock Text="{Binding PageAuthority}"
                                                   Margin="3"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Foreground="Black" />
                                            <TextBlock Text="{Binding DomainAuthority}"
                                                   Margin="3"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Foreground="Black" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                   Margin="3"
                                                   MaxWidth="450"
                                                   HorizontalAlignment="Left"
                                                   TextWrapping="Wrap"
                                                   Foreground="Black" />
                                        <!--<TextBox Background="Transparent"
                                                 BorderThickness="0"
                                                 Text="{Binding Title, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 Foreground="Blue" />
                                        
                                        <TextBox Background="Transparent"
                                                 BorderThickness="0"
                                                 Text="{Binding Link, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 Foreground="Green" />
                                        
                                        <TextBox Background="Transparent"
                                                 BorderThickness="0"
                                                 Text="{Binding Description, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 Foreground="Gray" />-->
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="View In Browser">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="BROWSER" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <MenuItem Header="Curate It">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SendToBrowser}" CommandParameter="PBNPOSTER" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <MenuItem Header="Moz Check">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding RanckCheck}" CommandParameter="MOZ" />
                        </MenuItem.InputBindings>
                    </MenuItem>

                    <MenuItem Header="Moz Check All" Visibility="{Binding Path= NotVisible_WebHose,Converter={StaticResource boolToVis}}">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding RanckCheck}" CommandParameter="MOZALL" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListView>
    </Grid>
</UserControl>
