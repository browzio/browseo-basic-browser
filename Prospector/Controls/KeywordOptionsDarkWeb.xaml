<UserControl x:Class="Prospector.Controls.KeywordOptionsDarkWeb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localControls="clr-namespace:Prospector.Controls"
             xmlns:converter="clr-namespace:Prospector.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="850">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:booleanToVisible x:Key="boolToVis" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
                <!--<ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/Blue.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/BaseLight.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.AnimatedSingleRowTabControl.xaml"  />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/FlatButton.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Margin="5"
              Background="WhiteSmoke"
              Width="750">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="3"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Width="60"
                           Text="Keyword:"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Margin="2"
                         Text="{Binding Keyword,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="3"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Query:"
                           VerticalAlignment="Top"
                           Width="60" />
                <TextBox Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="2"
                         Text="{Binding QueryStringDW}"
                         TextWrapping="Wrap"
                         Height="40" />

                <TextBlock Text="Tor Path:"
                           VerticalAlignment="Top"
                           Grid.Row="1"
                           Width="60" />
                <TextBox Grid.Column="1"
                         Grid.Row="1"
                         Margin="2"
                         Text="{Binding TorPath}"
                         TextWrapping="Wrap" />
                
                <Button Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        Width="20"
                        Height="20"
                        Command="{Binding OnCommandFromKODw}"
                        CommandParameter="TorPath"
                        Style="{DynamicResource FlatbtnStyle}">
                    <Image HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="None"
                           Source="pack://application:,,,/Organiser.Common;component/Image/ic_create_new_folder_black_24dp_1x.png" />
                </Button>

                <Button Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,3,0,3"
                        HorizontalAlignment="Left"
                        Command="{Binding SaveFootprint}"
                        CommandParameter="DARKWEB"
                        Content="Save Footprint"
                        Visibility="{Binding Path= Visible_savebtn,Converter={StaticResource boolToVis}}" />

                <CheckBox Content="Is Live"
                          ToolTip="A Boolean field (true/false) stating if the site is online or offline"
                          Grid.Row="4"
                          IsChecked="{Binding IsDWLive}" />
            </Grid>
        </Grid>

        <Grid Name="grdOptions"
              Grid.Row="1"
              Background="WhiteSmoke"
              VerticalAlignment="Top">
            <ListView ItemsSource="{Binding DWGrdOptions}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      MinHeight="200"
                      BorderThickness="0"
                      ItemContainerStyle="{StaticResource ResourceKey=MetroListBoxItemStyle}"
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="8">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel VerticalAlignment="Top"
                                   Width="750"
                                    Orientation="Horizontal"></WrapPanel>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="8"
                                       MinWidth="300"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Text="{Binding Type}"
                                       ToolTip="{Binding Tooltip}"
                                       FontSize="16"
                                       FontWeight="Bold" />
                            <Button Content="+"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    Command="{Binding OnCommandFromView}"
                                    CommandParameter="DWADD" />
                            <ListView ItemsSource="{Binding DWSelectedSiteOptions}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      BorderThickness="0"
                                      Margin="8">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Value}"
                                                     MinWidth="250"
                                                     Margin="2"
                                                     PreviewKeyUp="TextBox_PreviewKeyDown" />
                                            <Button Width="15"
                                                    Height="15"
                                                    Grid.Column="1"
                                                    Command="{Binding OnCommandFromView}"
                                                    Style="{DynamicResource FlatbtnStyle}">
                                                <Image HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Stretch="None"
                                                       Source="pack://application:,,,/Organiser.Common;component/Image/close.png" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <localControls:ButtonOptions Grid.ColumnSpan="2"
                                     Grid.Row="2"
                                     VerticalAlignment="Bottom"
                                     HorizontalAlignment="Left"
                                     Margin="5,10" />

        <localControls:GoogleSearchResults Grid.RowSpan="3"
                                           Grid.Column="2"
                                           Margin="10,5,10,10" />
    </Grid>
</UserControl>
