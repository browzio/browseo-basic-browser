<UserControl x:Class="Prospector.Controls.ProspectorTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:controls="clr-namespace:Prospector.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="650">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/Blue.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/BaseLight.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.AnimatedSingleRowTabControl.xaml"  />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/FlatButton.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Flat Button Style -->
            <Color x:Key="HighlightColor" A="255" R="229" G ="229" B="229"/>
            <Color x:Key="PressedColor" A="255" R="215" G ="215" B="215"/>

            <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
            <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />

            <Style TargetType="Button" x:Key="tabButtonStyle">
                <Setter Property="Background" Value="#FFFDFDFD" />
                <Setter Property="BorderThickness" Value="0.6" />
                <Setter Property="BorderBrush" Value="DarkGray" />
                <Setter Property="Height" Value="23" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border 
                                Background="#a1a5ad" Cursor="Hand"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="0" x:Name="Border">
                                <ContentControl Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Center" Margin="7,0"
                                                VerticalAlignment="Center" TextElement.Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="#FF376ED4" Offset="0"/>
                                                <GradientStop Color="#FF588DF0" Offset="0.332"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            
            <!-- End Flat Button Style -->

        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0,1,0,0" BorderBrush="#d0d0d0">
        <TabControl Name="tbContrl" SelectedIndex="{Binding TCSelectedTabIndex}" Margin="0,10,0,0">
            <TabItem>
                <TabItem.Header>
                    <Button Name="btnComment"
                            Click="btnComment_Click"
                            Content="Comment Backlinks"
                            MouseEnter="Btn_MouseEnter"
                            MouseLeave="Btn_MouseLeave"
                            Margin="0,0,0,0"
                            Style="{StaticResource tabButtonStyle}">
                    </Button>
                </TabItem.Header>
                <controls:KeywordAndOptions />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Button Name="btnForum"
                            Click="btnForum_Click"
                            MouseEnter="Btn_MouseEnter"
                            MouseLeave="Btn_MouseLeave"
                            Content="Forum"
                           Margin="5,0,0,0"
                            Style="{StaticResource tabButtonStyle}">
                    </Button>
                </TabItem.Header>
                <controls:KeywordAndOptions />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Button Name="btnGuest_Posts"
                            Click="btnGuest_Posts_Click"
                            MouseEnter="Btn_MouseEnter"
                            MouseLeave="Btn_MouseLeave"
                            Content="Guest Posts"
                            Margin="5,0,0,0"
                            Style="{StaticResource tabButtonStyle}">
                    </Button>
                </TabItem.Header>
                <controls:KeywordAndOptions />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Button Name="btnBlog"
                            Click="btnBlog_Click"
                            MouseEnter="Btn_MouseEnter"
                            MouseLeave="Btn_MouseLeave"
                            Content="Blog"
                            Margin="5,0,0,0"
                            Style="{StaticResource tabButtonStyle}">
                    </Button>
                </TabItem.Header>
                <controls:KeywordAndOptions />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Button Name="btnLink_Roundups"
                            Click="btnLink_Roundups_Click"
                            MouseEnter="Btn_MouseEnter"
                            MouseLeave="Btn_MouseLeave"
                            Content="Link Roundups"
                            Margin="5,0,0,0"
                            Style="{StaticResource tabButtonStyle}">
                    </Button>
                </TabItem.Header>
                <controls:KeywordAndOptions />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Button Name="btnCustom"
                            Click="btnCustom_Click"
                            MouseEnter="Btn_MouseEnter"
                            MouseLeave="Btn_MouseLeave"
                            Content="Custom"
                             Margin="5,0,0,0"
                            Style="{StaticResource tabButtonStyle}">
                    </Button>
                </TabItem.Header>
                <controls:KeywordAndOptions />
            </TabItem>

            <TabItem Name="tabKingKontent" x:FieldModifier="public">
                <TabItem.Header>
                    <Button Name="btnWebHose"
                            Click="btnWebHose_Click"
                            MouseEnter="Btn_MouseEnter"
                            MouseLeave="Btn_MouseLeave"
                            Content="King Kontent"
                             Margin="5,0,0,0"
                            Style="{StaticResource tabButtonStyle}">
                    </Button>
                </TabItem.Header>
                <controls:KeywordAndOptions />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Button Name="btnSaved"
                            Click="btnSaved_Click"
                            MouseEnter="Btn_MouseEnter"
                            MouseLeave="Btn_MouseLeave"
                            Content="Saved"
                             Margin="5,0,0,0"
                            Style="{StaticResource tabButtonStyle}">
                    </Button>
                </TabItem.Header>
                <controls:KeywordAndOptions />
            </TabItem>
            <!--<TabItem Header="Resource pages">
                <controls:KeywordAndOptions />
            </TabItem>

            <TabItem Header="Sponsor/Donation links">
                <controls:KeywordAndOptions />
            </TabItem>-->
        </TabControl>
    </Border>
</UserControl>
