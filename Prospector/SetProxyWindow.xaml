<Window x:Class="Prospector.SetProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:conv="clr-namespace:Prospector.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SetProxyWindow" Height="120" Width="375" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="Images/browseo (1).ico">
    <Window.Resources>
        <Style x:Key="EntryFieldStyle" TargetType="Grid" >
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0" />
        </Style>
        <SolidColorBrush x:Key="brushWatermarkBackground" Color="White" />
        <SolidColorBrush x:Key="brushWatermarkForeground" Color="LightSteelBlue" />
        <SolidColorBrush x:Key="brushWatermarkBorder" Color="Indigo" />

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:IsEmptyToBackgroundColorConverter x:Key="emptyToBackColor" />

        <!-- Flat Button Style -->
        <Color x:Key="DefaultColor" A="255" R="240" G ="240" B="240"/>
        <Color x:Key="HighlightColor" A="255" R="229" G ="229" B="229"/>
        <Color x:Key="PressedColor" A="255" R="215" G ="215" B="215"/>

        <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource DefaultColor}" />
        <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
        <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.6" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="0">
                            <ContentControl Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- End Flat Button Style -->
    </Window.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Proxy: " Name="tbProxys" x:FieldModifier="public" Width="50" Margin="5" VerticalAlignment="Top" />
        <DockPanel Grid.Column="1" Background="WhiteSmoke" x:Name="dpProxys" x:FieldModifier="public" VerticalAlignment="Top" Margin="5">
            <Grid  Style="{StaticResource EntryFieldStyle}"  >
                <TextBlock Text="IP"
                           Background="{StaticResource brushWatermarkBackground}"
                            Width="74"
                           FontWeight="Normal"
                            Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtIP, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Background="{Binding ElementName=txtIP, Path=Text, Converter={StaticResource emptyToBackColor}}" 
                            Name="txtIP"
                            Margin="2,3"
                            Width="80" />
            </Grid>
            <Grid Style="{StaticResource EntryFieldStyle}" >
                <TextBlock Text="Port" 
                           Background="{StaticResource brushWatermarkBackground}"
                            Width="27"
                           FontWeight="Normal"
                            Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtPORT, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Background="{Binding ElementName=txtPORT, Path=Text, Converter={StaticResource emptyToBackColor}}" 
                            Name="txtPORT"
                            Margin="2,3"
                            Width="33"/>
            </Grid>
            <Grid Style="{StaticResource EntryFieldStyle}" >
                <TextBlock Text="Username" 
                           FontWeight="Normal"
                           Background="{StaticResource brushWatermarkBackground}"
                            Width="74"
                            Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtUser, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Background="{Binding ElementName=txtUser, Path=Text, Converter={StaticResource emptyToBackColor}}" 
                            Name="txtUser"
                            Margin="2,3"
                            Width="80"/>
            </Grid>
            <Grid Style="{StaticResource EntryFieldStyle}" >
                <TextBlock Text="Password" 
                            Background="{StaticResource brushWatermarkBackground}"
                            Width="74"
                            FontWeight="Normal"
                            Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtPass, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Background="{Binding ElementName=txtPass, Path=Text, Converter={StaticResource emptyToBackColor}}" 
                            Name="txtPass"
                            Margin="2,3"
                            Width="80">
                </TextBox>
            </Grid>
        </DockPanel>

        <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Name="spButtons" Grid.Row="1" Grid.Column="1">
            <Button Name="btnCancel"  Width="70" Margin="5" Click="btnCancel_Click"  >
                <TextBlock HorizontalAlignment="Center" Text="Cancel" />
            </Button>

            <Button Name="btnSave" Width="70" Margin="5" Click="btnSave_Click">
                <TextBlock HorizontalAlignment="Center" Text="Save" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
