<Window x:Class="Prospector.SetProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:conv="clr-namespace:Prospector.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="One Per Line With A Colon : Seperator ex. IP:PORT:USER:PASS " Height="300" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox Name="tbInputedText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Verdana" FontSize="15" />
        <!--<TextBlock Text="Proxy: " Name="tbProxys" x:FieldModifier="public" Width="50" Margin="5" VerticalAlignment="Top" />
        <DockPanel Grid.Column="1" Background="WhiteSmoke" x:Name="dpProxys" x:FieldModifier="public" VerticalAlignment="Top" Margin="5">
            <Grid  Style="{StaticResource EntryFieldStyle}"  >
                <TextBlock Text="IP"
                           Background="{StaticResource brushWatermarkBackground}"
                            Width="74"
                           FontWeight="Normal"
                            Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtIP, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Background="{Binding ElementName=txtIP, Path=Text, Converter={StaticResource emptyToBackColor}}" 
                            Name="txtIP"
                            Margin="2,3"
                            Width="80" />
            </Grid>
            <Grid Style="{StaticResource EntryFieldStyle}" >
                <TextBlock Text="Port" 
                           Background="{StaticResource brushWatermarkBackground}"
                            Width="27"
                           FontWeight="Normal"
                            Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtPORT, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Background="{Binding ElementName=txtPORT, Path=Text, Converter={StaticResource emptyToBackColor}}" 
                            Name="txtPORT"
                            Margin="2,3"
                            Width="33"/>
            </Grid>
            <Grid Style="{StaticResource EntryFieldStyle}" >
                <TextBlock Text="Username" 
                           FontWeight="Normal"
                           Background="{StaticResource brushWatermarkBackground}"
                            Width="74"
                            Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtUser, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Background="{Binding ElementName=txtUser, Path=Text, Converter={StaticResource emptyToBackColor}}" 
                            Name="txtUser"
                            Margin="2,3"
                            Width="80"/>
            </Grid>
            <Grid Style="{StaticResource EntryFieldStyle}" >
                <TextBlock Text="Password" 
                            Background="{StaticResource brushWatermarkBackground}"
                            Width="74"
                            FontWeight="Normal"
                            Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtPass, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Background="{Binding ElementName=txtPass, Path=Text, Converter={StaticResource emptyToBackColor}}" 
                            Name="txtPass"
                            Margin="2,3"
                            Width="80">
                </TextBox>
            </Grid>
        </DockPanel>-->

        <Button Name="btnSave" Content="Save" Margin="5" Click="btnSave_Click" Grid.Row="1" Style="{StaticResource FlatbtnStyle}" />

        <!--<StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Name="spButtons" Grid.Row="1" Grid.Column="1">
            <Button Name="btnCancel"  Width="70" Margin="5" Click="btnCancel_Click"  >
                <TextBlock HorizontalAlignment="Center" Text="Cancel" />
            </Button>

            <Button Name="btnSave" Width="70" Margin="5" Click="btnSave_Click">
                <TextBlock HorizontalAlignment="Center" Text="Save" />
            </Button>
        </StackPanel>-->
    </Grid>
</Window>
