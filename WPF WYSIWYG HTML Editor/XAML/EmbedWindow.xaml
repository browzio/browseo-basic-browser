<Window x:Class="WPF_WYSIWYG_HTML_Editor.XAML.EmbedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_WYSIWYG_HTML_Editor.XAML"
        mc:Ignorable="d"
        Title="Enter Link" Height="150" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="../Images/RomanE-01.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Enter Link:" Margin="5" />
            <TextBox x:Name="link" HorizontalAlignment="Left" Height="24"  TextWrapping="Wrap" VerticalAlignment="Top" Width="400" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right">
        <Button x:Name="ButtonOK" HorizontalAlignment="Left" Height="30" Margin="10" VerticalAlignment="Top" Width="92" Click="ButtonOK_Click" >
            <StackPanel Orientation="Horizontal">
                <TextBlock>OK</TextBlock>
                <Image Source="../Resources/ok.png" Height="16" Width="16" Margin="10,0,0,0"/>
            </StackPanel>
        </Button>
        <Button x:Name="ButtonCancel" HorizontalAlignment="Left" Height="30" Margin="10"  VerticalAlignment="Top" Width="92" Click="ButtonCancel_Click" >
            <StackPanel Orientation="Horizontal">
                <TextBlock>Cancel</TextBlock>
                <Image Source="../Resources/cancel.png" Height="16" Width="16" Margin="10,0,0,0"/>
            </StackPanel>
        </Button>
        </StackPanel>
    </Grid>
</Window>
