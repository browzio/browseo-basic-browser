<UserControl x:Class="WPF_WYSIWYG_HTML_Editor.XAML.MoneyVaultUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_WYSIWYG_HTML_Editor.XAML"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="2" Command="{Binding RefreshPBNVault}" CommandParameter="RefreshMoney" IsEnabled="{Binding EnableBtns}"  Height="25" Width="25" HorizontalAlignment="Right">
            <Image Source="pack://application:,,,/Organiser.Common;component/Image/refresh.png"  
                   ToolTip="Refresh" SnapsToDevicePixels="True" Stretch="Uniform" />
        </Button>
        <TextBlock Grid.Column="1" Text="Money Vault" Margin="4" FontSize="15"  VerticalAlignment="Center" HorizontalAlignment="Center"  />
        
        <Button Grid.Column="0" Command="{Binding RefreshPBNVault}" CommandParameter="SetMozKey" IsEnabled="{Binding EnableBtns}" ToolTip="Set moz keys"  Height="25" Width="25" HorizontalAlignment="Left">
            <Image Source="pack://application:,,,/Organiser.Common;component/Image/settings2.png" SnapsToDevicePixels="True" Stretch="Uniform" />
        </Button>

        <ListBox Grid.Row="1" ItemsSource="{Binding SavedMoneyProjects}" 
                 Background="#fafafa"
                 Grid.ColumnSpan="3"
                 SelectionMode="Single"
                 SelectedIndex="{Binding SIMoney}"
                 Margin="3" BorderThickness="0,0,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                        <StackPanel Visibility="{Binding AuthorityVisible}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DomainAuthority}" Margin="2" />
                            <TextBlock Text="{Binding PageAuthority}" Margin="2" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Margin="4" FontSize="16" MinWidth="140" VerticalAlignment="Center"  />
                            <TextBlock Text="{Binding ProjectName}" Margin="6,1,1,1" FontSize="11" MinWidth="140" VerticalAlignment="Center" FontStyle="Italic"  />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Get Moz Rank">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding VautContextMenu}" CommandParameter="MozRank" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    <MenuItem Header="Copy Link">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding VautContextMenu}" CommandParameter="CopyLinkMoney" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                    
                    <Separator Margin="-30,0,0,0" />
                    <MenuItem Header="Get Backlink History">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding VautContextMenu}" CommandParameter="BACKLINK_HISTORY" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </Grid>
</UserControl>
