<UserControl x:Class="WPF_WYSIWYG_HTML_Editor.XAML.WysiwigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_WYSIWYG_HTML_Editor"
             xmlns:localXaml="clr-namespace:WPF_WYSIWYG_HTML_Editor.XAML"
             xmlns:localHelper="clr-namespace:WPF_WYSIWYG_HTML_Editor.Helpers"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="EditableTabHeaderControl" TargetType="{x:Type localHelper:EditableTabHeaderControl}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type localHelper:EditableTabHeaderControl}">
                            <Grid Background="#eeeeee">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_TabHeader"  VerticalAlignment="Center"
                                     Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Mode=TwoWay}" Visibility="Collapsed"/>
                                <TextBlock x:Name="PART_TextBlock" VerticalAlignment="Center" 
                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Mode=TwoWay}"/>
                                <CheckBox IsChecked="{Binding IsChecked}" Grid.Column="1" Margin="5,2,3,2" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>

                                <Trigger Property="IsInEditMode" Value="True">
                                    <Trigger.Setters>
                                        <Setter TargetName="PART_TabHeader" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="PART_TextBlock" Property="Visibility" Value="Collapsed"/>
                                    </Trigger.Setters>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ItemContainerStyle" TargetType="TabItem">
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate DataType="{x:Type local:SpinningVM}">
                            <localHelper:EditableTabHeaderControl Style="{StaticResource EditableTabHeaderControl}">
                                <localHelper:EditableTabHeaderControl.Content>
                                    <!--<StackPanel>-->
                                    <Binding Path="Title" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
                                    <!--<CheckBox IsChecked="{Binding IsChecked}" />-->
                                    <!--</StackPanel>-->
                                </localHelper:EditableTabHeaderControl.Content>
                            </localHelper:EditableTabHeaderControl>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="ContentTemplate" DataType="{x:Type local:SpinningVM}">
                <Grid>
                    <TextBox AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Grid>
            </DataTemplate>
            <Style TargetType="{x:Type RibbonButton}">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <Grid Name="grdFtpProjects" Grid.Column="1" Grid.RowSpan="2" Background="#f5f5f5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                    <Expander Name="spander"
                              Width="24"
                              Expanded="spander_Expanded"
                              Collapsed="spander_Collapsed"
                              ExpandDirection="Right">
                        <Expander.Header>
                            <TextBlock Text="PBN Vault" Foreground="#de5347">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Expander.Header>
                        <localXaml:PBNVaultUserControl x:Name="ftpProjectList" />
                    </Expander>

                    <Expander Name="spander2"
                              Width="24"
                              Expanded="spander2_Expanded"
                              Collapsed="spander2_Collapsed"
                              Grid.Column="1"
                              ExpandDirection="Right">
                        <Expander.Header>
                            <TextBlock Text="Money Vault" Foreground="#1ca261">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Expander.Header>
                        <localXaml:MoneyVaultUserControl x:Name="moneyVaultSpander" />
                    </Expander>
            </Grid>

        <Ribbon Name="ribon" Foreground="#333333" Background="WhiteSmoke" Margin="0,-22,0,0" SelectionChanged="Ribbon_SelectionChanged">
            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu Visibility="Collapsed" />
            </Ribbon.ApplicationMenu>
            
            <RibbonTab Header="Editor" IsEnabled="{Binding EnableBtns}">
                <RibbonGroup Header="Clear" Width="60" >
                    <RibbonButton x:Name="RibbonButtonNew" Label="" ToolTip="Clear"
                                      LargeImageSource="..\Images\new.png" 
                                      Click="RibbonButtonNew_Click"  />
                </RibbonGroup>
                <RibbonGroup Header="Editor" Width="395">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="RibbonComboboxFormat" Width="160" Height="22" Margin="2" HorizontalAlignment="Left" SelectionChanged="RibbonComboboxFormat_SelectionChanged" >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox  x:Name="RibbonComboboxFonts" Width="160" Height="22" Margin="2" SelectionChanged="RibbonComboboxFonts_SelectionChanged"/>
                            <ComboBox x:Name="RibbonComboboxFontHeight" Margin="2" Width="50" Height="22" SelectionChanged="RibbonComboboxFontHeight_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <RibbonButton x:Name="SettingsBold" SmallImageSource="..\Images\bold.png" Click="SettingsBold_Click"/>
                            <RibbonButton x:Name="SettingsItalic" SmallImageSource="..\Images\italic.png" Click="SettingsItalic_Click"/>
                            <RibbonButton x:Name="SettingsUnderLine" SmallImageSource="..\Images\UnderLine.png" Click="SettingsUnderLine_Click"/>
                            <RibbonButton x:Name="SettingsFontColor" SmallImageSource="..\Images\Color.png" Click="SettingsFontColor_Click"/>
                            <RibbonButton x:Name="SettingsBackColor" SmallImageSource="..\Images\backcolor.png" Click="SettingsBackColor_Click"/>
                            <RibbonButton x:Name="SettingsAddLink" SmallImageSource="..\Images\link.png" Click="SettingsAddLink_Click"/>
                            <RibbonButton x:Name="SettingsAddVidLink" SmallImageSource="..\Images\RomanE-01.png" Click="SettingsAddVidLink_Click"/>
                            <RibbonButton x:Name="SettingsAddImage" SmallImageSource="..\Images\image.png" Click="SettingsAddImage_Click"/>
                            <RibbonButton x:Name="SettingsLeftAlign" SmallImageSource="..\Images\LeftAlign.png" Click="SettingsLeftAlign_Click"/>
                            <RibbonButton x:Name="SettingsCenter2" SmallImageSource="..\Images\center2.png" Click="SettingsCenter2_Click"/>
                            <RibbonButton x:Name="SettingsRightAlign" SmallImageSource="..\Images\RightAlign.png" Click="SettingsJustifyRight_Click"/>
                            <RibbonButton x:Name="SettingsCenter" SmallImageSource="..\Images\center.png" Click="SettingsJustifyFull_Click"/>
                            <RibbonButton x:Name="SettingsNumbered" SmallImageSource="..\Images\Numbered.png" Click="SettingsInsertOrderedList_Click"/>
                            <RibbonButton x:Name="SettingsBullets" SmallImageSource="..\Images\bullets.png" Click="SettingsBullets_Click"/>
                            <RibbonButton x:Name="SettingsOutIdent" SmallImageSource="..\Images\OutIdent.png" Click="SettingsOutIdent_Click"/>
                            <RibbonButton x:Name="SettingsIdent" SmallImageSource="..\Images\ident.png" Click="SettingsIdent_Click"/>
                        </StackPanel>
                    </StackPanel>
                </RibbonGroup>
                <RibbonGroup Header="Custom" Width="100">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RibbonButton x:Name="EditWeb1"  LargeImageSource="..\Images\Editor.png" HorizontalAlignment="Left" Click="EditWeb_Click"/>
                            <RibbonButton x:Name="ViewHTML"  LargeImageSource="..\Images\html.png" HorizontalAlignment="Left" Click="ViewHTML_Click"/>
                        </StackPanel>
                    </StackPanel>
                </RibbonGroup>
                <RibbonGroup Header="FR">
                    <RibbonButton  LargeImageSource="..\Images\refresh-icon.png"  Click="btnFindReplace_Click" x:Name="btnFindReplace" ToolTip="Find Replace" />
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab Header="Publish PBN" IsEnabled="{Binding EnableBtns}">
                <RibbonGroup Header="Title">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Post Title:" Margin="3" VerticalAlignment="Center" />
                            <TextBox Text="{Binding PostTitle}" Margin="3" Width="200" Name="tbPostTitle" />
                        </StackPanel>
                        <CheckBox Content="Spin Title" IsChecked="{Binding IsSpinChecked}" Margin="5" />
                    </StackPanel>
                </RibbonGroup>

                <RibbonGroup Header="Settings">
                    <RibbonButton IsEnabled="{Binding EnableBtns}" ToolTip="Platform Settings" Command="{Binding SettingsClicked}"
                                  LargeImageSource="..\Images\settings-icon.png" />
                </RibbonGroup>

                <RibbonGroup Header="Publish">
                    <StackPanel Margin="0,0,5,0">
                        <CheckBox Content="Publish Spun Articles" IsChecked="{Binding UseSpunArticlesChecked}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{ StaticResource {x:Type CheckBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>

                        </CheckBox>
                        <CheckBox Content="Auto Spin" IsChecked="{Binding AutoSpinChecked}" />
                        <DockPanel Visibility="{Binding DPtimesToSPinVisible}">
                            <TextBlock Text="Times To Spin: " VerticalAlignment="Center" />
                            <TextBox Text="{Binding TimesToSpin}" Width="30"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,3,0">
                        <RibbonButton ToolTip="Publish to pbns selected in settings" Height="50" Name="btnPublishFTP" Click="btnPublish_Click"
                                      LargeImageSource="..\Images\publish-bw.png" />
                        <TextBlock Text="From Settings" />
                    </StackPanel>

                    <StackPanel Margin="3,0,0,0">
                        <RibbonButton ToolTip="Publish to pbns selected in vaults vaulted" Height="50" Name="pbnPubfromVault" Click="pbnPubfromVault_Click"
                                          LargeImageSource="..\Images\publish-o.png" />
                        <TextBlock Text="From Vault" />
                    </StackPanel>
                </RibbonGroup>

                <RibbonGroup Header="Spin">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <RibbonButton x:Name="btnSpin" ToolTipService.ShowDuration="15000" ToolTipService.InitialShowDelay="0"
                                          ToolTip="Place your spun article still in spin syntax into the text editor. Everytime you click a new spun article tab will be added.(this will also spin the title so add a title)" 
                                          HorizontalAlignment="Center" Height="50" LargeImageSource="..\Images\spin.png" Click="btnSpin_Click" />
                            <TextBlock Text="Spin It" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel>
                            <RibbonButton ToolTip="Clear All Spun Tabs" Height="50"  Name="btnClearAllTabs" Click="btnClearAllTabs_Click"
                                      LargeImageSource="..\Images\clear.png" />
                            <TextBlock Text="Clear" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel>
                            <RibbonButton ToolTip="Place your spun article still in spin syntax into this window. A new article will be spun into the editor from the window."
                                          ToolTipService.ShowDuration="15000" ToolTipService.InitialShowDelay="0"
                                          Height="50" Name="btnSpinWindow" Click="btnSpinWindow_Click"
                                      LargeImageSource="..\Images\new_window-icon.png" />
                            <TextBlock Text="Spinner Window" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </RibbonGroup>

                <RibbonGroup Header="Status">
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="10" Name="tbStatus" />
                    <ProgressBar IsIndeterminate="{Binding ProgressBarStart}" Width="{Binding ElementName=tbStatus, Path=ActualWidth}" Height="18" Margin="5" HorizontalAlignment="Center" />
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>
            
        <local:WPFWebBrowser Grid.Column="0" x:Name="webBrowserEditor"  Grid.Row="1" VerticalAlignment="Top" />
        <local:HtmlEditor Grid.Column="0" x:Name="HtmlEditor1"  Grid.Row="1" Visibility="Hidden" VerticalAlignment="Top"/>
        
        <TabControl Name="tbContrl" ItemsSource="{Binding Tabs}" Visibility="{Binding TabsVisible}"
                    Grid.Column="0" Grid.Row="2" MinHeight="400" 
                    ItemContainerStyle="{StaticResource ItemContainerStyle}" 
                    ContentTemplate="{StaticResource ContentTemplate}" />
      </Grid>
</UserControl>
