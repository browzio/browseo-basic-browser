<Window x:Class="WPF_WYSIWYG_HTML_Editor.XAML.CreateNewFTPprojectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Title="Create New FTP Project" Height="245" Width="300" Icon="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="WhiteSmoke" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="Title:" Width="60" Margin="5" VerticalAlignment="Center" />
            <TextBox Text="{Binding Title}" Margin="5" />
        </DockPanel>
        <DockPanel Grid.Row="1">
            <TextBlock Text="Home Url:" Width="60" Margin="5" VerticalAlignment="Center" />
            <TextBox Text="{Binding Homelink}" Margin="5" />
        </DockPanel>
        <DockPanel Grid.Row="2">
            <TextBlock Text="FTP Url:" Width="60" Margin="5" VerticalAlignment="Center" />
            <TextBox Text="{Binding Link}" Margin="5" />
        </DockPanel>
        <DockPanel Grid.Row="3">
            <TextBlock Text="Username:" Width="60" Margin="5" VerticalAlignment="Center" />
            <TextBox Text="{Binding Username}" Margin="5" />
        </DockPanel>
        <DockPanel Grid.Row="4">
            <TextBlock Text="Password:" Width="60" Margin="5" VerticalAlignment="Center" />
            <TextBox Text="{Binding Password}" Margin="5" />
        </DockPanel>
        
        <Button Content="Save" Grid.Row="5" Margin="10" Click="Button_Click" />
    </Grid>
</Window>
