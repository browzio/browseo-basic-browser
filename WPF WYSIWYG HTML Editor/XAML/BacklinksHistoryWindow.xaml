<Window x:Class="WPF_WYSIWYG_HTML_Editor.XAML.BacklinksHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_WYSIWYG_HTML_Editor.XAML"
        mc:Ignorable="d"
        Title="Backlinks History" Height="500" Width="900" Icon="pack://application:,,,/Organiser.Common;component/Image/browseo (1).ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Organiser.Common;component/GloableStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Text="Backlink Text:" Width="80" VerticalAlignment="Center" />
            <TextBox Text="{Binding BacklinkText}" Width="150" VerticalAlignment="Center" />
            <TextBlock Text="Money Site Link:" Width="90" VerticalAlignment="Center" Margin="5,0,0,0" />
            <TextBox Text="{Binding MoneySite}" Width="150" VerticalAlignment="Center"  />
            <TextBlock Text="Site Link:" Width="60" VerticalAlignment="Center" Margin="5,0,0,0" />
            <TextBox Text="{Binding Site}" Width="150" VerticalAlignment="Center" />
            <Button Content="Add To History" Width="100" Margin="20,5,5,5" Command="{Binding AddNewClick}" CommandParameter="Add" />
            <Button Content="Import" Width="50" Margin="5,5,5,5" Command="{Binding AddNewClick}" CommandParameter="Import" />
        </StackPanel>
        <ListView IsSynchronizedWithCurrentItem="True"
                  Grid.Row="1"
                    Background="WhiteSmoke"
                    Name="lv"
                    SelectedIndex="{Binding SIBacklinkHistory}"
                    ItemsSource="{Binding FullBaklinkHistoroy}"
                    BorderThickness="0"
                    Margin="5"
                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                    ItemContainerStyle="{DynamicResource MetroListBoxItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0" BorderBrush="#dfdfdf"  Margin="0,0,0,15" Background="White">
                        <Grid  Background="WhiteSmoke">
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <TextBlock Text="{Binding BacklinkText}" Margin="2" VerticalAlignment="Center" />
                                <TextBlock Text="|" Margin="5" FontWeight="Bold" />
                                <TextBlock Text="{Binding MoneySite}" Margin="2" VerticalAlignment="Center" />
                                <TextBlock Text="|" Margin="5" FontWeight="Bold" />
                                <TextBlock Text="{Binding Site}" Margin="2" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Remove">
                        <MenuItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ContextMenuClick}" CommandParameter="Delete" />
                        </MenuItem.InputBindings>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
        <Button Content="View Chart" HorizontalAlignment="Right" Width="150" Grid.Row="2" Command="{Binding ViewChartClick}" />
    </Grid>
</Window>
