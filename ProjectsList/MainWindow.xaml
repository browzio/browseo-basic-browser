<Window x:Class="ProjectsList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R.A.W Organiser" 
        Closed="Window_Closed" WindowStartupLocation="CenterScreen" Width="760" Height="500">
    <Window.Resources>
        <!-- Flat Button Style -->
        <Color x:Key="DefaultColor" A="255" R="240" G ="240" B="240"/>
        <Color x:Key="HighlightColor" A="255" R="229" G ="229" B="229"/>
        <Color x:Key="PressedColor" A="255" R="215" G ="215" B="215"/>

        <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource DefaultColor}" />
        <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
        <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />

        <Style TargetType="Button" x:Key="FlatButtonStyle">
            <Setter Property="Background" Value="{StaticResource DefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.6" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="0">
                            <ContentControl Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- End Flat Button Style -->
        
        <!--close button style-->
        <LinearGradientBrush x:Key="HoverButton_PressedBackground" EndPoint="0,1" StartPoint="0,0">
            <GradientStop Color="#F3F3F3" Offset="0"/>
            <GradientStop Color="#EBEBEB" Offset="0.5"/>
            <GradientStop Color="#DDDDDD" Offset="0.5"/>
            <GradientStop Color="#CDCDCD" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HoverButton_OverBackground" EndPoint="0,1" StartPoint="0,0">
            <GradientStop Color="#FFFAFAFA" Offset="0"/>
            <GradientStop Color="#FFE0E0E3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CloseButton_PressedBackground" EndPoint="0,1" StartPoint="0,0">
            <GradientStop Color="#FFE0E0E2" Offset="0"/>
            <GradientStop Color="#FFF8F8F8" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="HoverButton_NormalBorder" Color="#FF969696"/>

        <Style x:Key="HoverButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource HoverButton_PressedBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HoverButton_NormalBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border SnapsToDevicePixels="true" x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Opacity="0" />
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="Chrome" Value="1"/>
                                <Setter Property="Background" TargetName="Chrome" Value="{DynamicResource HoverButton_OverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="Chrome" Value="1"/>
                                <Setter Property="Background" TargetName="Chrome" Value="{DynamicResource CloseButton_PressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#ADADAD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Path x:Key="CloseButton_X" 
          x:Shared="False"
          Stretch="Fill" 
          StrokeThickness="0.5" 
          Stroke="#FF333333" 
          Data="F1 M 2.28484e-007,1.33331L 1.33333,0L 4.00001,2.66669L 6.66667,6.10352e-005L 8,1.33331L 5.33334,4L 8,6.66669L 6.66667,8L 4,5.33331L 1.33333,8L 1.086e-007,6.66669L 2.66667,4L 2.28484e-007,1.33331 Z " 
          HorizontalAlignment="Stretch" 
          VerticalAlignment="Stretch" />

        <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource HoverButtonStyle}">
            <Style.Resources>
                <Style TargetType="{x:Type Path}">
                    <Setter Property="Fill" Value="#FF969696" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Fill" Value="#FFB83C3D" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
            <Setter Property="Content" Value="{StaticResource CloseButton_X}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="1">
                <DockPanel Width="175">
                    <Button Style="{StaticResource FlatButtonStyle}" Command="{Binding Save}" CommandParameter="Save" HorizontalAlignment="Right" Width="50">
                        <TextBlock HorizontalAlignment="Center" Text="Save" />
                    </Button>
                    <Button Style="{StaticResource FlatButtonStyle}" Command="{Binding Save}" CommandParameter="SaveAll" HorizontalAlignment="Stretch">
                        <TextBlock HorizontalAlignment="Center" Text="Save All" />
                    </Button>
                </DockPanel>
                <ListBox ItemsSource="{Binding Path=Projects}" 
                         SelectedIndex="{Binding SIProjects}"
                         Background="WhiteSmoke">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProjectName}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Launch In Browser">
                                <MenuItem.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ContextMenuClick}" CommandParameter="LaunchInBrowser"  />
                                </MenuItem.InputBindings>
                            </MenuItem>

                            <MenuItem Header="View Profile Data">
                                <MenuItem.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ContextMenuClick}" CommandParameter="ShowProfileData"  />
                                </MenuItem.InputBindings>
                            </MenuItem>

                            <MenuItem Header="Add Profile">
                                <MenuItem.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ContextMenuClick}" CommandParameter="AddProfile"  />
                                </MenuItem.InputBindings>
                            </MenuItem>

                            <MenuItem Header="Delete">
                                <MenuItem.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ContextMenuClick}" CommandParameter="Delete"  />
                                </MenuItem.InputBindings>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                
                <Button Command="{Binding CreateNewProject}" Style="{StaticResource FlatButtonStyle}">
                    <TextBlock HorizontalAlignment="Center" Text="New Project" />
                </Button>
            </StackPanel>
            
            <TabControl Name="PluginTabs" 
                        Grid.Column="1"
                        Padding="0"
                        ItemsSource="{Binding Browsers}" 
                        SelectedItem="{Binding SelectedBrowser}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter Content="{Binding Title}" />
                            <Button Style="{StaticResource CloseButtonStyle}" 
                                Margin="3, 0,-7,0" 
                                Command="{Binding DataContext.CloseTabCommand, ElementName=PluginTabs}"
                                CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding View}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            <!--<ContentControl Grid.Column="1" Content="{Binding Path=CurrentProject, Converter={StaticResource ProjectToBrowserConverter}}" HorizontalAlignment="Center" />-->
            <!--<browser:MainWindow Grid.Column="1" /> 
             xmlns:browser="clr-namespace:TabbedWPFSample;assembly=TabbedWPFSample" -->
        </Grid>
    </Grid>
</Window>
