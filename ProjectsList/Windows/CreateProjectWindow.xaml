<Window x:Class="ProjectsList.Windows.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProjectsList.Converters"
        SizeToContent="WidthAndHeight"
        
        Title="Create Project">
    <Window.Resources>

        <!-- Flat Button Style -->
        <Color x:Key="DefaultColor" A="255" R="240" G ="240" B="240"/>
        <Color x:Key="HighlightColor" A="255" R="229" G ="229" B="229"/>
        <Color x:Key="PressedColor" A="255" R="215" G ="215" B="215"/>

        <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource DefaultColor}" />
        <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
        <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />

        <Style TargetType="Button" x:Key="FlatButtonStyle">
            <Setter Property="Background" Value="{StaticResource DefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.6" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="0">
                            <ContentControl Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox" x:Key="FlatComboBoxStyle">
            <Setter Property="Background" Value="{StaticResource DefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.6" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="3" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
                </Trigger>
                <!--<Trigger Property="MouseDown" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                </Trigger>-->
            </Style.Triggers>
        </Style>
        <!-- End Flat Button Style -->
        
        <SolidColorBrush x:Key="brushWatermarkBackground" Color="White" />
        <SolidColorBrush x:Key="brushWatermarkForeground" Color="LightSteelBlue" />
        <SolidColorBrush x:Key="brushWatermarkBorder" Color="Indigo" />

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!--<local:TextInputToVisibilityConverter x:Key="TextInputToVisibilityConverter" />-->

        <Style x:Key="EntryFieldStyle" TargetType="Grid" >
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="2,3" />
            <Setter Property="Width" Value="285" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="5,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="23" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="Black" BorderThickness="0.7" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <TextBlock Text="Project Name: "  />
        <TextBox Name="projName" Text="{Binding ProjectName}" Grid.Column="1" />

        <TextBlock Text="Profile Name: " Grid.Row="1" />
        <TextBox Name="profName" Text="{Binding ProfileName}" Grid.Column="1" Grid.Row="1" />

        <TextBlock Text="Proxy: "  Grid.Row="2" />
        <DockPanel Grid.Column="1" Grid.Row="2">
        <Grid Background="{StaticResource brushWatermarkBackground}" Style="{StaticResource EntryFieldStyle}" >
            <TextBlock Text="IP"
                       Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtIP, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBox Background="Transparent" 
                            Text="{Binding ProxyIP}" 
                            Name="txtIP"
                     Margin="2,3"
                            Width="80"/>
        </Grid>
        <Grid Background="{StaticResource brushWatermarkBackground}" Style="{StaticResource EntryFieldStyle}" >
            <TextBlock Text="Port" 
                       Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtPORT, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBox Background="Transparent" 
                            Text="{Binding ProxyPort}" 
                            Name="txtPORT"
                     Margin="2,3"
                            Width="33"/>
        </Grid>
        <Grid Background="{StaticResource brushWatermarkBackground}" Style="{StaticResource EntryFieldStyle}" >
            <TextBlock Text="Username" 
                       Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtUser, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBox Background="Transparent" 
                            Text="{Binding ProxyUsername}" 
                            Name="txtUser"
                     Margin="2,3"
                            Width="80"/>
        </Grid>
        <Grid Background="{StaticResource brushWatermarkBackground}" Style="{StaticResource EntryFieldStyle}" >
            <TextBlock Text="Password" 
                       Margin="5"
                            Foreground="{StaticResource brushWatermarkForeground}"
                            Visibility="{Binding ElementName=txtPass, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBox Background="Transparent" 
                            Text="{Binding ProxyPassword}" 
                            Name="txtPass"
                     Margin="2,3"
                            Width="80"/>
        </Grid>
    </DockPanel>

        <TextBlock Text="First Name: "  Grid.Row="3" />
        <TextBox Text="{Binding FirstName}" Grid.Column="1"  Grid.Row="3" />

        <TextBlock Text="Last Name: "  Grid.Row="4"  />
        <TextBox Text="{Binding LastName}" Grid.Column="1"  Grid.Row="4" />

        <TextBlock Text="Phone Number: "  Grid.Row="5" />
        <TextBox Text="{Binding PhoneNumber}" Grid.Column="1"  Grid.Row="5" />

        <TextBlock Text="Username: "  Grid.Row="6" />
        <TextBox Text="{Binding Username}" Grid.Column="1"  Grid.Row="6" />

        <TextBlock Text="Email: " Grid.Row="7" />
        <TextBox Text="{Binding Email}" Grid.Column="1"  Grid.Row="7" />

        <TextBlock Text="Password: "  Grid.Row="8" />
        <TextBox Text="{Binding Password}" Grid.Column="1"  Grid.Row="8" />

        <TextBlock Text="Sex: "  Grid.Row="9" />
        <ComboBox ItemsSource="{Binding SexList}"
                  Margin="1,0,0,0" 
                  SelectedIndex="{Binding CmbSelectedIndexSex}" 
                  Grid.Column="1" 
                  Grid.Row="9"
                  Width="285"
                  Style="{StaticResource FlatComboBoxStyle}"
                  HorizontalAlignment="Left"/>

        <TextBlock Text="Birth Date: " Grid.Row="10" />
        <StackPanel Orientation="Horizontal" Grid.Column="1"  Grid.Row="10">
            <TextBlock Text="day:" />
            <ComboBox ItemsSource="{Binding DayList}" 
                      Margin="5,0,0,0" 
                      SelectedIndex="{Binding CmbSelectedIndexDay}"
                      Style="{StaticResource FlatComboBoxStyle}"/>
            <TextBlock Text="month:" Margin="5,0,0,0" />
            <ComboBox ItemsSource="{Binding MonthList}" 
                      Margin="5,0,0,0" 
                      SelectedIndex="{Binding CmbSelectedIndexMonth}"
                      Style="{StaticResource FlatComboBoxStyle}" />
            <TextBlock Text="Year:" Margin="5,0,0,0"  />
            <TextBox Text="{Binding BirthdayYear}" Width="70" Margin="5,3,0,3" />
        </StackPanel>

        <TextBlock Text="Address: " Grid.Row="11" />
        <TextBox Text="{Binding Address}" Grid.Column="1"  Grid.Row="11" />

        <TextBlock Text="Notes: "  Grid.Row="12" />
        <TextBox Text="{Binding Notes}" Grid.Column="1"  Grid.Row="12" />

        <Button Margin="2,30,2,10" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Click="Button_Click"  Grid.Row="13" Style="{StaticResource FlatButtonStyle}" >
            <TextBlock HorizontalAlignment="Center" Text="Save New" Name="tbbutton" />
        </Button>
    </Grid>
    </Border>
</Window>
