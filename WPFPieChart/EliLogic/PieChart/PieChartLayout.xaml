<UserControl x:Class="Eli.Controls.PieChart.PieChartLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Eli.Controls.PieChart"
    >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
            <c:PiePlotter Margin="10" Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Center" HoleSize="0.3"/>
        <c:Legend  Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
        
        
        
    </Grid>
</UserControl>
